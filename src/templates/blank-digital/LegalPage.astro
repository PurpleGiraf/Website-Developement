---
// Shared shell for the privacy and terms pages. The copy is sample text from the design:
// have a lawyer review it against the client's actual practices and jurisdiction before launch.
import Layout from './Layout.astro';
import { config, routes, breadcrumbSchema } from './config';
import { legal, pad2 } from './data';

interface Props {
  page: 'privacy' | 'terms';
}
const { page } = Astro.props;
const doc = legal[page];
const b = config.business;
const tabs = [
  { key: 'privacy', label: 'Privacy', href: routes.privacy },
  { key: 'terms', label: 'Terms', href: routes.terms },
] as const;
---

<Layout
  page={page}
  title={`${doc.title} | ${b.name}`}
  description={doc.intro}
  gridHeight={700}
  glow={false}
  jsonld={[breadcrumbSchema([{ name: 'Home', path: routes.home }, { name: doc.title, path: routes[page] }], Astro.site)]}
>
  <header class="bd-legal-head">
    <span class="bd-eyebrow" data-hero data-scramble style="margin-bottom:24px">Legal</span>
    <h1 class="bd-h1" data-hero style="font-size:clamp(27px,4vw,54px);line-height:1.15">{doc.title}</h1>
    <div class="bd-legal-bar" data-hero>
      <nav class="bd-legal-tabs" aria-label="Legal documents">
        {tabs.map((t) => <a href={t.href} aria-current={t.key === page ? 'page' : undefined}>{t.label}</a>)}
      </nav>
      <span class="bd-mono-label" style="font-size:12px;letter-spacing:0;text-transform:none">Last updated · {legal.updated}</span>
    </div>
  </header>

  <section class="bd-legal">
    <nav class="bd-legal-toc" aria-label="Contents">
      <span class="bd-mono-label">Contents</span>
      {
        doc.sections.map(([h], k) => (
          <a href={`#${page}-${k + 1}`}>
            <span aria-hidden="true">{pad2(k + 1)}</span>
            {h}
          </a>
        ))
      }
    </nav>
    <div class="bd-legal-body">
      <p class="bd-legal-note">Template text. Review with a qualified legal professional for your jurisdiction before publishing.</p>
      <p class="bd-legal-intro">{doc.intro}</p>
      {
        doc.sections.map(([h, t], k) => (
          <div id={`${page}-${k + 1}`} class="bd-legal-sec" data-reveal>
            <h2>
              <span aria-hidden="true">{pad2(k + 1)}</span>
              {h}
            </h2>
            <p>{t}</p>
          </div>
        ))
      }
      <p style="font-size:15px;line-height:1.6">Questions? Email <a href={`mailto:${b.email}`} style="color:var(--accent-text)">{b.email}</a>.</p>
    </div>
  </section>
</Layout>

<style is:global>
  .bd-legal-head{position:relative;max-width:1100px;margin:0 auto;padding:clamp(160px,20vh,210px) clamp(20px,5vw,48px) 48px}
  .bd-legal-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;margin-top:36px}
  .bd-legal-tabs{display:flex;gap:6px;padding:5px;border-radius:999px;border:1px solid rgba(255,255,255,0.1);background:var(--panel)}
  .bd-legal-tabs a{padding:10px 20px;border-radius:999px;color:var(--soft);font-size:14px;transition:all .25s}
  .bd-legal-tabs a:hover{color:var(--ink)}
  .bd-legal-tabs a[aria-current]{background:var(--ink);color:var(--bg)}
  .bd-legal{max-width:1100px;margin:0 auto;padding:0 clamp(20px,5vw,48px) clamp(100px,12vw,150px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:56px;align-items:start}
  .bd-legal-toc{position:sticky;top:120px;display:flex;flex-direction:column;gap:12px;padding-top:28px;border-top:1px solid rgba(255,255,255,0.08)}
  .bd-legal-toc a{font-size:14px;color:var(--text);display:flex;gap:10px}
  .bd-legal-toc a:hover{color:var(--ink)}
  .bd-legal-toc a span{font-family:var(--mono);font-size:11px;color:var(--dim);padding-top:2px}
  .bd-legal-body{grid-column:span 2;display:flex;flex-direction:column;gap:40px;min-width:0}
  .bd-legal-note{padding:16px 20px;border-radius:14px;border:1px solid rgba(232,199,126,0.3);background:rgba(232,199,126,0.06);font-size:14px;line-height:1.55;color:var(--gold)}
  .bd-legal-intro{font-size:17px;line-height:1.7;color:var(--soft)}
  .bd-legal-sec{scroll-margin-top:120px;display:flex;flex-direction:column;gap:14px;padding-top:32px;border-top:1px solid var(--line)}
  .bd-legal-sec h2{display:flex;gap:14px;align-items:baseline;font-family:var(--display);font-weight:400;font-size:clamp(18px,1.8vw,22px);line-height:1.3;color:var(--ink);text-transform:uppercase}
  .bd-legal-sec h2 span{font-family:var(--mono);font-size:12px;color:var(--accent-text)}
  .bd-legal-sec p{font-size:16px;line-height:1.75;color:#A9A9B1}
  @media (max-width: 820px){
    .bd-legal-body{grid-column:auto}
    .bd-legal-toc{position:static}
  }
</style>
