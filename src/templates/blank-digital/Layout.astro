---
import JsonLd from '../../components/JsonLd.astro';
import Logo from './Logo.astro';
import { config, routes, serviceHref, postHref, orgSchema, type PageKey } from './config';
import { services, posts } from './data';

interface Props {
  page: PageKey;
  title: string;
  description: string;
  jsonld?: Record<string, unknown>[];
  /** Hide the "Brief us today" band above the footer (the home page has its own quote section). */
  hideCta?: boolean;
  /** Height of the moving grid behind the page header. */
  gridHeight?: number;
  /** Show the blue glow at the top of the page. */
  glow?: boolean;
}

const { page, title, description, jsonld = [], hideCta = false, gridHeight = 900, glow = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const b = config.business;
const isHome = page === 'home';

const nav: { key: PageKey | 'work'; label: string; href: string; also?: PageKey[] }[] = [
  { key: 'home', label: 'Home', href: routes.home },
  { key: 'services', label: 'Services', href: routes.services, also: ['service'] },
  { key: 'process', label: 'Process', href: routes.process },
  { key: 'work', label: 'Work', href: routes.work },
  { key: 'insights', label: 'Insights', href: routes.insights, also: ['post'] },
];
const isActive = (n: (typeof nav)[number]) => n.key === page || (n.also ?? []).includes(page);
// The home page has its own nav in the design: in-page sections, highlighted as you scroll (no Home link, no dot).
const homeNav: { key: string; label: string; href: string }[] = [
  { key: 'services', label: 'Services', href: routes.services },
  { key: 'process', label: 'Process', href: routes.process },
  { key: 'work', label: 'Work', href: '#work' },
  { key: 'about', label: 'About', href: '#about' },
  { key: 'insights', label: 'Insights', href: routes.insights },
];

const demo: { label: string; href: string; key: PageKey }[] = [
  { label: 'Home', href: routes.home, key: 'home' },
  { label: 'Services', href: routes.services, key: 'services' },
  { label: 'Service detail', href: serviceHref(services[0].slug), key: 'service' },
  { label: 'Process', href: routes.process, key: 'process' },
  { label: 'Insights', href: routes.insights, key: 'insights' },
  { label: 'Article', href: postHref(posts[0].slug), key: 'post' },
  { label: 'Privacy', href: routes.privacy, key: 'privacy' },
  { label: 'Terms', href: routes.terms, key: 'terms' },
];

const introOn = isHome && config.showIntro;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta name="theme-color" content="#0A0A0B" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href="/blank-digital/fonts/Michroma-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/blank-digital/fonts/VarelaRound-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:inline set:html={`:root{--accent:${config.accent};--accent-text:${config.accentText}}`} />
    <script is:inline define:vars={{ introOn }}>
      var d = document.documentElement;
      d.classList.add('bd-js');
      var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still) d.classList.add('bd-still');
      try {
        if (introOn && !still && !sessionStorage.getItem('bd-booted')) d.classList.add('bd-intro');
      } catch (e) {}
    </script>
    {[orgSchema(Astro.site), ...jsonld].map((d) => <JsonLd data={d} />)}
  </head>
  <body data-page={page}>
    {
      config.showDemoBar && (
        <div class="bd-demobar">
          <a href="/templates/">← All templates</a>
          <span aria-hidden="true">/</span>
          <span class="bd-demobar-name">Template 06 · Digital agency</span>
          <span aria-hidden="true">/</span>
          {demo.map((d) => (
            <a href={d.href} aria-current={page === d.key ? 'page' : undefined}>
              {d.label}
            </a>
          ))}
        </div>
      )
    }

    <a href="#main" class="bd-skip">Skip to content</a>

    <!-- Ambient layer: particle field, cursor glow, film grain, scroll progress, custom cursor -->
    <div class="bd-fx" aria-hidden="true">
      <div class="bd-grain"></div>
      <div class="bd-progress" data-fx-progress></div>
      <div class="bd-cring" data-fx-ring></div>
      <div class="bd-cdot" data-fx-dot></div>
      <div class="bd-hud">
        <span><span class="bd-live-dot"></span>ALL SYSTEMS LIVE</span>
        <span data-fx-hud>SCROLL 000%</span>
      </div>
    </div>

    {
      introOn && (
        <div class="bd-boot" data-boot aria-hidden="true">
          <Logo size={56} class="bd-boot-logo" />
          <div class="bd-boot-meter">
            <div class="bd-boot-track">
              <div class="bd-boot-bar" data-boot-bar />
            </div>
            <div class="bd-boot-row">
              <span>INITIALISING</span>
              <span data-boot-pct>000</span>
            </div>
          </div>
        </div>
      )
    }

    <div class="bd-page">
      <!-- Particle field and cursor aurora sit inside the isolated wrapper (as in the design) so the page background doesn't cover them -->
      <canvas class="bd-fx-canvas" data-fx-canvas aria-hidden="true"></canvas>
      <div class="bd-aurora" data-fx-aurora aria-hidden="true"></div>
      <div class="bd-grid-bg" style={`height:${gridHeight}px`} aria-hidden="true"></div>
      {glow && <div class="bd-glow" aria-hidden="true" />}

      <header class="bd-nav-wrap">
        <div class="bd-nav">
          <a href={isHome ? '#top' : routes.home} class="bd-nav-logo" aria-label={`${b.name} home`}><Logo size={16} /></a>
          <nav aria-label="Main" class:list={['bd-nav-links', { 'is-home': isHome }]}>
            {
              isHome
                ? homeNav.map((n) => (
                    <a href={n.href} data-spy={n.key}>
                      {n.label}
                    </a>
                  ))
                : nav.map((n) => (
                    <a href={n.href} aria-current={isActive(n) ? 'page' : undefined} data-nav-key={n.key}>
                      {n.label}
                    </a>
                  ))
            }
          </nav>
          <a href={routes.quote} class="bd-btn bd-btn-sm" data-magnetic>Get a quote</a>
          <button type="button" class="bd-menu-btn" data-menu-btn aria-expanded="false" aria-controls="bd-menu">Menu</button>
        </div>
      </header>
      <nav id="bd-menu" class="bd-menu" data-menu aria-label="Mobile" hidden>
        {
          (isHome ? homeNav : nav).map((n) => (
            <a href={n.href} aria-current={!isHome && isActive(n as (typeof nav)[number]) ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
        <a href={routes.quote} class="bd-btn">Get a quote <span class="bd-arrow">→</span></a>
      </nav>

      <main id="main" tabindex="-1" style="outline:none">
        <slot />
      </main>

      {
        !hideCta && (
          <section class="bd-cta-wrap" aria-labelledby="bd-cta-title">
            <div class="bd-panel bd-cta">
              <div class="bd-panel-grid" aria-hidden="true" />
              <div class="bd-cta-inner">
                <span class="bd-eyebrow" data-reveal data-scramble>Ready when you are</span>
                <h2 id="bd-cta-title" class="bd-h2 bd-cta-title" data-reveal>
                  Brief us today. <span class="bd-blue">Go live this week.</span>
                </h2>
                <p data-reveal>Fixed quote within the hour. No lock-in contracts. Calls answered 24/7.</p>
                <div class="bd-btn-row" data-reveal>
                  <a href={routes.quote} class="bd-btn bd-btn-lg bd-btn-glow" data-magnetic>
                    Get your free quote <span class="bd-arrow">→</span>
                  </a>
                  <a href={b.phoneHref} class="bd-btn-ghost bd-btn-lg" data-magnetic>{b.phone}</a>
                </div>
              </div>
            </div>
          </section>
        )
      }

      {isHome ? (
      <footer class="bd-footer bd-footer-home">
        <div class="bd-footer-row">
          <div class="bd-footer-item"><span>Email</span><a href={`mailto:${b.email}`}>{b.email}</a></div>
          <div class="bd-footer-item"><span>Phone · 24/7</span><a href={b.phoneHref}>{b.phone}</a></div>
          <nav class="bd-footer-inline" aria-label="Footer">
            <a href={b.social.instagram}>Instagram</a>
            <a href={b.social.linkedin}>LinkedIn</a>
            <a href={routes.insights}>Insights</a>
            <a href={routes.privacy}>Privacy</a>
            <a href={routes.terms}>Terms</a>
          </nav>
        </div>
        <div class="bd-footer-mark" aria-hidden="true">
          <span class="bd-footer-word">{config.brandName}</span><span class="bd-cursor"></span>
        </div>
        <div class="bd-footer-legal">
          <span>© 2026 {b.name}</span>
          <div>
            <a href="#top" data-to-top>Back to top ↑</a>
          </div>
        </div>
      </footer>
      ) : (
      <footer class="bd-footer">
        <div class="bd-footer-cols">
          <nav class="bd-footer-col" aria-label="Services">
            <span class="bd-mono-label">Services</span>
            {services.map((s) => <a href={serviceHref(s.slug)}>{s.name}</a>)}
          </nav>
          <nav class="bd-footer-col" aria-label="Company">
            <span class="bd-mono-label">Company</span>
            <a href={routes.services}>All services</a>
            <a href={routes.process}>Process</a>
            <a href={routes.work}>Work</a>
            <a href={routes.about}>About</a>
            <a href={routes.insights}>Insights</a>
          </nav>
          <div class="bd-footer-col">
            <span class="bd-mono-label">Contact</span>
            <a href={`mailto:${b.email}`} class="bd-ink">{b.email}</a>
            <a href={b.phoneHref} class="bd-ink">{b.phone}</a>
            <span class="bd-footer-live"><span class="bd-live-dot"></span>Answered 24/7</span>
          </div>
          <nav class="bd-footer-col" aria-label="Follow">
            <span class="bd-mono-label">Follow</span>
            <a href={b.social.instagram}>Instagram</a>
            <a href={b.social.linkedin}>LinkedIn</a>
            <a href={b.social.tiktok}>TikTok</a>
          </nav>
        </div>
        <div class="bd-footer-mark" aria-hidden="true">
          <span class="bd-footer-word">{config.brandName}</span><span class="bd-cursor"></span>
        </div>
        <div class="bd-footer-legal">
          <span>© 2026 {b.name}</span>
          <div>
            <a href={routes.privacy}>Privacy</a>
            <a href={routes.terms}>Terms</a>
            <a href="#main" data-to-top>Back to top ↑</a>
          </div>
        </div>
      </footer>
      )}
    </div>

    <a href={routes.quote} class="bd-float" data-float tabindex="-1" aria-hidden="true">
      <span class="bd-live-dot"></span>Free quote in 60s
    </a>

    <script>
      import '../../scripts/interactions.ts';
      import '../../scripts/blank-digital.ts';
    </script>
  </body>
</html>

<style is:global>
  @font-face{font-family:'Michroma';src:url('/blank-digital/fonts/Michroma-Regular.ttf') format('truetype');font-display:swap}
  @font-face{font-family:'Varela Round';src:url('/blank-digital/fonts/VarelaRound-Regular.ttf') format('truetype');font-display:swap}
  :root{
    --bg:#0A0A0B;--panel:#0F0F11;--panel-2:#0E0E10;--band:#0D0D0F;
    --ink:#EDEDEF;--soft:#C9C9CF;--text:#8B8B93;--dim:#7A7A82;--faint:#55555C;
    --line:rgba(255,255,255,0.07);--line-2:rgba(255,255,255,0.12);--line-3:rgba(255,255,255,0.18);
    --green:#7EE2A8;--live:#3BB273;--gold:#E8C77E;
    --ease:cubic-bezier(0.22,1,0.36,1);
    --pad:clamp(20px,5vw,64px);
    --display:'Michroma',sans-serif;--body:'Varela Round',system-ui,sans-serif;--mono:'Geist Mono',ui-monospace,monospace;
  }
  html{scroll-behavior:smooth;background:var(--bg)}
  body{margin:0;background:var(--bg);color:var(--text);font-family:var(--body);-webkit-font-smoothing:antialiased;overflow-x:clip}
  *{box-sizing:border-box}
  [hidden]{display:none !important}
  a{color:var(--ink);text-decoration:none}
  a:hover{color:#fff}
  h1,h2,h3,p{margin:0}
  input,textarea,button{font:inherit}
  ::selection{background:var(--accent);color:#fff}
  :focus-visible{outline:2px solid var(--accent-text);outline-offset:3px}
  .bd-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .bd-skip{position:absolute;left:12px;top:-60px;z-index:120;background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:999px}
  .bd-skip:focus{top:12px}

  @keyframes bd-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @keyframes bd-pulse{0%,100%{opacity:1}50%{opacity:.35}}
  @keyframes bd-shimmer{from{background-position:200% 0}to{background-position:-200% 0}}
  @keyframes bd-blink{0%,49%{opacity:1}50%,100%{opacity:0}}
  @keyframes bd-gridmove{to{background-position:0 72px,0 0}}
  @property --bd-a{syntax:'<angle>';inherits:false;initial-value:0deg}
  @keyframes bd-spin{to{--bd-a:360deg}}
  @keyframes bd-rise{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}

  /* Type */
  .bd-display{font-family:var(--display);font-weight:400;letter-spacing:-0.01em;color:var(--ink);text-transform:uppercase;text-wrap:balance}
  .bd-h1{font-family:var(--display);font-weight:400;font-size:clamp(29px,4.8vw,70px);line-height:1.1;letter-spacing:-0.01em;color:var(--ink);text-transform:uppercase;text-wrap:balance}
  .bd-h2{font-family:var(--display);font-weight:400;font-size:clamp(26px,3.5vw,49px);line-height:1.14;letter-spacing:-0.01em;color:var(--ink);text-transform:uppercase}
  .bd-h3{font-family:var(--display);font-weight:400;font-size:17px;line-height:1.3;letter-spacing:-0.01em;color:var(--ink);text-transform:uppercase}
  .bd-grey{color:var(--text)}
  .bd-blue{color:var(--accent-text)}
  .bd-ink{color:var(--ink)}
  .bd-eyebrow{display:inline-block;font-family:var(--mono);font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent-text)}
  .bd-mono-label{font-family:var(--mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--dim)}
  .bd-lede{font-size:clamp(17px,1.4vw,20px);line-height:1.6;max-width:560px;text-wrap:pretty}
  .bd-body{font-size:16px;line-height:1.6}

  /* Logo */
  .bd-logo{display:inline-flex;flex-direction:column;gap:calc(var(--s) * 0.19);line-height:1;color:var(--ink);white-space:nowrap}
  .bd-logo-word{display:flex;align-items:flex-end;gap:calc(var(--s) * 0.18);font-family:var(--display);font-size:var(--s)}
  .bd-logo-sub{font-family:var(--body);font-size:calc(var(--s) * 0.56);letter-spacing:0.46em;color:var(--text)}
  .bd-cursor{display:inline-block;width:0.62em;height:0.16em;margin-bottom:0.06em;background:var(--accent);box-shadow:0 0 0.5em var(--accent);animation:bd-blink 1.05s steps(1) infinite}

  /* Buttons */
  .bd-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;white-space:nowrap;background:var(--ink);color:var(--bg);font-size:15px;padding:14px 22px;border-radius:999px;border:0;cursor:pointer;transition:background .25s,transform .35s var(--ease),box-shadow .3s}
  .bd-btn:hover{background:#fff;color:var(--bg)}
  .bd-btn-sm{font-size:14px;padding:10px 18px}
  .bd-btn-lg{font-size:15px;padding:16px 26px}
  .bd-btn-glow{box-shadow:0 0 0 1px rgba(255,255,255,0.1),0 8px 30px rgba(47,91,255,0.3)}
  .bd-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:10px;white-space:nowrap;color:var(--ink);border-radius:999px;border:1px solid var(--line-2);background:rgba(255,255,255,0.02);transition:border-color .25s,background .25s,transform .35s var(--ease)}
  .bd-btn-ghost:hover{border-color:rgba(255,255,255,0.28);background:rgba(255,255,255,0.05);color:#fff}
  .bd-btn[disabled]{background:#3A3A40;color:var(--bg);cursor:not-allowed}
  .bd-arrow{opacity:.6}
  .bd-btn-row{display:flex;flex-wrap:wrap;gap:12px}
  .bd-text-link{display:inline-flex;align-items:center;gap:8px;font-size:15px;color:var(--ink);border-bottom:1px solid rgba(255,255,255,0.2);padding-bottom:4px}
  .bd-text-link:hover{border-bottom-color:#fff}
  .bd-chip{all:unset;box-sizing:border-box;cursor:pointer;padding:10px 16px;border-radius:999px;border:1px solid var(--line-2);color:var(--soft);font-size:14px;transition:all .25s}
  .bd-chip:hover{border-color:rgba(255,255,255,0.3);color:var(--ink)}
  .bd-chip[aria-pressed='true'],.bd-chip[aria-current]{background:var(--ink);border-color:var(--ink);color:var(--bg)}
  .bd-chip:focus-visible{outline:2px solid var(--accent-text);outline-offset:3px}
  .bd-live-dot{display:inline-block;flex:none;width:7px;height:7px;border-radius:9px;background:var(--live);animation:bd-pulse 1.6s infinite}

  /* Demo bar */
  .bd-demobar{position:relative;z-index:50;background:#050506;color:var(--dim);border-bottom:1px solid var(--line);font-family:var(--mono);font-size:11px;padding:9px var(--pad);display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;letter-spacing:0.08em;text-transform:uppercase}
  .bd-demobar a{color:var(--text);border-bottom:1px solid transparent;padding:2px 0}
  .bd-demobar a:first-child,.bd-demobar a[aria-current],.bd-demobar-name{color:var(--ink)}
  .bd-demobar a[aria-current]{border-bottom-color:var(--accent)}

  /* Ambient layer */
  .bd-fx-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}
  .bd-aurora{position:fixed;left:0;top:0;width:900px;height:900px;border-radius:50%;background:radial-gradient(circle,rgba(47,91,255,0.14),transparent 60%);pointer-events:none;z-index:-1;transform:translate(-50%,-30%);will-change:transform}
  .bd-grain{position:fixed;inset:0;z-index:89;pointer-events:none;opacity:0.07;background-image:url("data:image/svg+xml;utf8,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='220'%20height='220'%3E%3Cfilter%20id='n'%3E%3CfeTurbulence%20type='fractalNoise'%20baseFrequency='0.85'%20numOctaves='2'%20stitchTiles='stitch'/%3E%3C/filter%3E%3Crect%20width='100%25'%20height='100%25'%20filter='url(%23n)'/%3E%3C/svg%3E")}
  .bd-progress{position:fixed;top:0;left:0;height:2px;width:100%;transform:scaleX(0);transform-origin:0 50%;background:var(--accent);box-shadow:0 0 10px var(--accent);z-index:95;pointer-events:none}
  .bd-cring,.bd-cdot{position:fixed;left:0;top:0;border-radius:999px;pointer-events:none;opacity:0;mix-blend-mode:difference;will-change:transform;transition:opacity .3s}
  .bd-cring{width:36px;height:36px;margin:-18px 0 0 -18px;border:1px solid rgba(255,255,255,0.5);z-index:91}
  .bd-cdot{width:6px;height:6px;margin:-3px 0 0 -3px;background:#fff;z-index:92}
  .bd-hud{position:fixed;left:20px;bottom:24px;z-index:35;display:flex;flex-direction:column;gap:6px;font-family:var(--mono);font-size:10px;letter-spacing:0.14em;color:var(--faint);pointer-events:none}
  .bd-hud > span:first-child{display:flex;align-items:center;gap:8px}
  .bd-hud .bd-live-dot{width:6px;height:6px}
  @media (max-width: 700px){ .bd-hud{display:none} }

  /* Boot screen (home, once per session) */
  .bd-boot{display:none}
  .bd-intro .bd-boot{position:fixed;inset:0;z-index:100;background:#050506;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:36px;transition:transform 1s cubic-bezier(0.76,0,0.24,1)}
  .bd-boot.is-done{transform:translateY(-100%)}
  .bd-boot-logo{--s:clamp(36px,6vw,64px) !important}
  .bd-boot-logo .bd-logo-sub{font-size:clamp(13px,1.5vw,18px);letter-spacing:0.5em}
  .bd-boot-meter{width:min(280px,60vw);display:flex;flex-direction:column;gap:10px}
  .bd-boot-track{height:1px;background:rgba(255,255,255,0.1)}
  .bd-boot-bar{height:1px;width:0;background:var(--accent);box-shadow:0 0 10px var(--accent)}
  .bd-boot-row{display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;letter-spacing:0.14em;color:var(--faint)}

  /* Page shell */
  .bd-page{position:relative;isolation:isolate;min-height:100vh;overflow-x:clip}
  .bd-grid-bg{position:absolute;top:0;left:0;right:0;z-index:-1;background-image:linear-gradient(rgba(255,255,255,0.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.035) 1px,transparent 1px);background-size:72px 72px;animation:bd-gridmove 5s linear infinite;-webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 0%,#000 30%,transparent 75%);mask-image:radial-gradient(ellipse 70% 60% at 50% 0%,#000 30%,transparent 75%);pointer-events:none}
  body[data-page='home']{--glow-a:0.22;--glow-b:0.06}
  body[data-page='post']{--glow-a:0.18}
