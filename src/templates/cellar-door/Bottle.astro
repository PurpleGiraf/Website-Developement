---
// Bottle shot on a tinted panel. Uses src/assets/images/cellar-door/bottle-<id>.png (a transparent cut-out)
// when it exists, otherwise a drawn bottle in the wine's glass colour as a stand-in.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { config, type Wine } from './config';

interface Props {
  wine: Wine;
}
const { wine: w } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/cellar-door/bottle-*.{png,webp}', { eager: true });
const shot = Object.entries(files).find(([p]) => p.split('/').pop()?.replace(/\.[^.]+$/, '') === `bottle-${w.id}`)?.[1].default;

// Glass colour by style: flint for rosé, green for whites and sparkling, near-black for reds.
const glass = { White: '#4C5A36', Red: '#22171A', 'Rosé': '#E2B2A4', Sparkling: '#2E3A26' }[w.type] ?? '#22171A';
const sparkling = w.type === 'Sparkling';
// Short variety for the label, e.g. "Pinot Noir" from "Single Vineyard Pinot Noir".
const variety = w.name.replace(/^(Lenswood|Ridge|Single Vineyard|Cool Climate)\s+/, '');
---

<div class="hs-bottle" style={`--tint:${w.tint}`}>
  {
    shot ? (
      <Image src={shot} alt={`${w.vintage} ${config.brandName} ${w.name} bottle`} widths={[240, 400]} sizes="(min-width: 1100px) 22vw, 60vw" format="webp" class="hs-bottle-img" />
    ) : (
      <svg class="hs-bottle-img" viewBox="0 0 100 320" role="img" aria-label={`${w.vintage} ${config.brandName} ${w.name} bottle`}>
        <path
          d={sparkling ? 'M42 8h16v70c0 16 26 30 26 62v166a6 6 0 0 1-6 6H22a6 6 0 0 1-6-6V140c0-32 26-46 26-62z' : 'M43 8h14v80c0 12 25 20 25 46v172a6 6 0 0 1-6 6H24a6 6 0 0 1-6-6V134c0-26 25-34 25-46z'}
          fill={glass}
        />
        <rect x={sparkling ? 40 : 42} y="6" width={sparkling ? 20 : 16} height={sparkling ? 52 : 22} rx="2" fill={sparkling ? '#C9B27C' : '#3A2226'} />
        <path d="M24 150h52v14H24z" fill="#fff" opacity="0.06" />
        <rect x="22" y="178" width="56" height="84" fill="#F1EADB" />
        <rect x="25" y="181" width="50" height="78" fill="none" stroke="#B89A5E" stroke-width="0.6" />
        <text x="50" y="215" text-anchor="middle" font-family="'Bodoni Moda',serif" font-size="11" fill="#1A1C17">{config.brandName}</text>
        <text x="50" y="232" text-anchor="middle" font-family="'Instrument Sans',sans-serif" font-size="4.6" letter-spacing="0.8" fill="#4B4840">{variety.toUpperCase()}</text>
        <text x="50" y="244" text-anchor="middle" font-family="'Instrument Sans',sans-serif" font-size="4.2" letter-spacing="0.6" fill="#8A8676">{w.vintage}</text>
        <path d="M30 140c2-10 6-18 8-22" stroke="#fff" stroke-opacity="0.18" stroke-width="3" fill="none" stroke-linecap="round" />
        <rect x="27" y="150" width="4" height="150" rx="2" fill="#fff" opacity="0.1" />
      </svg>
    )
  }
</div>
