---
import JsonLd from '../../components/JsonLd.astro';
import { config, routes, labels, experiences, wines, clubTiers, shipping, money, type PageKey } from './config';

interface Props {
  page: PageKey;
  title: string;
  description: string;
  jsonld?: Record<string, unknown>[];
  /** Page opens on a full-bleed dark hero: header starts transparent with light text. */
  darkHero?: boolean;
}

const { page, title, description, jsonld = [], darkHero = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const keys = Object.keys(routes) as PageKey[];
const b = config.business;
// Data the client script needs (booking calendar, cart prices, shipping rule).
const clientData = {
  shipping,
  wines: wines.map(({ id, name, vintage, price }) => ({ id, name, vintage, price })),
  experiences: experiences.map(({ name, price, days, times }) => ({ name, price, days, times })),
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta name="theme-color" content="#1A1C17" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={`:root{--wine:${config.accent}}`} />
    <script is:inline>
      // Before first paint: if we arrived via the page wipe, start with the panel covering the page.
      try {
        if (sessionStorage.getItem('hs-wipe') && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('hs-wiping');
      } catch (e) {}
    </script>
    {jsonld.map((d) => <JsonLd data={d} />)}
    <script type="application/json" id="hs-data" set:html={JSON.stringify(clientData)} />
  </head>
  <body>
    {
      config.showDemoBar && (
        <div data-demobar class="hs-demobar">
          <a href="/templates/">← All templates</a>
          <span style="opacity:0.4">/</span>
          <span style="color:#EFEAE0">Template 04 — Wine &amp; hospitality</span>
          <span style="opacity:0.4">/</span>
          {keys.map((k) => (
            <a href={routes[k]} aria-current={page === k ? 'page' : undefined}>
              {labels[k]}
            </a>
          ))}
        </div>
      )
    }

    <a href="#main" class="hs-skip">Skip to content</a>

    <header data-header class:list={['hs-header', { 'is-dark': darkHero }]} data-dark-hero={darkHero ? '1' : undefined}>
      <nav aria-label="Main" class="hs-nav">
        <a href={routes.wines} aria-current={page === 'wines' ? 'page' : undefined}>Wines</a>
        <a href={routes.visit} aria-current={page === 'visit' ? 'page' : undefined}>Visit &amp; Dine</a>
        <button type="button" data-open="club">Club</button>
      </nav>
      <button type="button" class="hs-menu-btn" data-open="menu" aria-label="Open menu">Menu</button>
      <a href={routes.home} class="hs-logo" aria-label={`${config.brandName} home`}>{config.brandName}</a>
      <div class="hs-header-end">
        <button type="button" data-open="cart" class="hs-cart-link">Cart (<span data-cart-count>0</span>)</button>
        <button type="button" data-book class="hs-header-btn">Book a visit</button>
      </div>
    </header>

    <main id="main">
      <slot />

      <section class="hs-cta">
        <h2 data-reveal="0" class="hs-serif" style="font-size:clamp(52px,8vw,140px);line-height:0.9;letter-spacing:-0.035em">Come up <em class="hs-wine">the hill.</em></h2>
        <button type="button" data-reveal="150" data-book class="hs-btn hs-btn-wine" style="padding:20px 34px">Book a tasting or lunch</button>
      </section>
    </main>

    <div class="hs-footer-wrap">
      <footer class="hs-footer">
        <div class="hs-footer-grid">
          <div style="display:flex;flex-direction:column;gap:20px;grid-column:span 2;max-width:520px">
            <div class="hs-eyebrow" style="color:#A6A190">Newsletter</div>
            <div class="hs-serif" style="font-size:clamp(28px,2.6vw,40px);line-height:1.15">Release notes and events, four times a year.</div>
            <div data-form-wrap>
              <form data-form data-newsletter class="hs-newsletter">
                <label for="hs-news-email" class="hs-sr">Email address</label>
                <input id="hs-news-email" name="email" type="email" required autocomplete="email" placeholder="Email address" />
                <button type="submit">Subscribe</button>
              </form>
              <div data-form-success hidden class="hs-serif" style="font-style:italic;font-size:22px;color:#D9B3AE">You're on the list. Thank you.</div>
            </div>
          </div>
          <address style="font-style:normal;display:flex;flex-direction:column;gap:12px;font-size:15px;line-height:1.5;color:#CFC8B8">
            <span>{b.address.line1}</span><span>{b.address.locality} {b.address.region} {b.address.postcode}</span><span>Thu – Mon · 11 – 5</span>
            <a href={b.phoneHref}>{b.phone}</a>
          </address>
          <nav aria-label="Footer" class="hs-footer-nav">
            <a href={routes.wines}>Shop wines</a>
            <a href={routes.visit}>Visit &amp; dine</a>
            <button type="button" data-open="club">Hillside Club</button>
            <a href="#">Instagram</a>
          </nav>
        </div>
        <div>
          <div class="hs-serif hs-footer-word" aria-hidden="true">{config.brandName}</div>
          <div class="hs-footer-legal">
            <span>{b.acknowledgement}</span>
            <span>{b.licence} · Please enjoy responsibly</span>
          </div>
        </div>
      </footer>
    </div>

    <!-- Cursor-following photo for the Tastings list (pointer devices only) -->
    <div data-float class="hs-float" aria-hidden="true"><slot name="float" /></div>

    <div data-wipe class="hs-wipe" aria-hidden="true"><span class="hs-serif">{config.brandName}</span></div>

    <!-- Mobile menu -->
    <dialog data-dialog="menu" class="hs-dialog hs-menu" aria-label="Menu">
      <div class="hs-dialog-head">
        <span class="hs-serif" style="font-size:28px">{config.brandName}</span>
        <button type="button" data-close class="hs-x" aria-label="Close menu">×</button>
      </div>
      <nav aria-label="Mobile" class="hs-menu-links">
        {keys.map((k) => <a href={routes[k]} aria-current={page === k ? 'page' : undefined}>{labels[k]}</a>)}
        <button type="button" data-open="club">Club</button>
      </nav>
      <button type="button" data-book class="hs-btn hs-btn-wine">Book a visit</button>
    </dialog>

    <!-- Booking: two steps then confirmation -->
    <dialog data-dialog="booking" class="hs-dialog hs-modal" aria-labelledby="hs-book-title">
      <div class="hs-dialog-head">
        <div style="display:flex;flex-direction:column;gap:12px">
          <span class="hs-eyebrow" data-book-step-label>Step 1 of 2</span>
          <h3 id="hs-book-title" class="hs-serif" style="font-size:44px;line-height:1;letter-spacing:-0.02em" data-book-title>Book a visit</h3>
        </div>
        <button type="button" data-close class="hs-x" aria-label="Close booking">×</button>
      </div>
      <div data-book-step="1" class="hs-stack">
        <fieldset class="hs-fieldset">
          <legend class="hs-label">Experience</legend>
          <div class="hs-rows" role="group">
            {
              experiences.map((e, i) => (
                <button type="button" class="hs-row" data-exp={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                  <span>{e.name}</span>
                  <span style="color:#5D5A50">{money(e.price)} pp</span>
                </button>
              ))
            }
          </div>
        </fieldset>
        <fieldset class="hs-fieldset">
          <legend class="hs-label">Date</legend>
          <div data-book-days class="hs-chips" style="grid-template-columns:repeat(5,1fr)"></div>
        </fieldset>
        <fieldset class="hs-fieldset">
          <legend class="hs-label">Time</legend>
          <div data-book-times class="hs-chips" style="grid-template-columns:repeat(4,1fr)"></div>
        </fieldset>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:16px">
          <span class="hs-label" id="hs-guests-label">Guests</span>
          <div class="hs-stepper" role="group" aria-labelledby="hs-guests-label">
            <button type="button" data-guests="-1" aria-label="Fewer guests">−</button>
            <output data-guests-out aria-live="polite">2</output>
            <button type="button" data-guests="1" aria-label="More guests">+</button>
          </div>
        </div>
        <button type="button" data-book-next class="hs-btn hs-btn-wine" style="padding:19px">Continue · <span data-book-total>$40</span></button>
      </div>
      <form data-book-step="2" class="hs-stack" hidden novalidate>
        <div class="hs-summary" data-book-summary></div>
        <label class="hs-field">Full name<input name="name" required autocomplete="name" /></label>
        <label class="hs-field">Email<input name="email" type="email" required autocomplete="email" /></label>
        <label class="hs-field">Dietary requirements or notes<input name="notes" /></label>
        <div data-book-error role="alert" style="font-size:13px;color:#8A3B32"></div>
        <div style="display:flex;gap:12px">
          <button type="button" data-book-back class="hs-btn hs-btn-outline" style="padding:19px 24px">Back</button>
          <button type="submit" class="hs-btn hs-btn-wine" style="flex:1;padding:19px">Confirm booking</button>
        </div>
      </form>
      <div data-book-step="3" class="hs-stack" hidden>
        <p data-book-confirm style="font-size:17px;line-height:1.6;color:#4B4840;margin:0"></p>
        <div class="hs-summary" data-book-summary></div>
        <button type="button" data-close class="hs-btn hs-btn-ink" style="padding:19px">Done</button>
      </div>
    </dialog>

    <!-- Cart drawer -->
    <dialog data-dialog="cart" class="hs-dialog hs-drawer" aria-labelledby="hs-cart-title">
      <div class="hs-dialog-head" style="align-items:center">
        <h3 id="hs-cart-title" class="hs-serif" style="font-size:44px;letter-spacing:-0.02em">Your cart</h3>
        <button type="button" data-close class="hs-x" aria-label="Close cart">×</button>
      </div>
      <p data-cart-ordered hidden style="font-size:17px;line-height:1.6;color:#4B4840;margin:0">Thank you. Your order is confirmed and will ship from the cellar within three business days.</p>
      <div data-cart-empty class="hs-stack" style="gap:16px">
        <p style="font-size:16px;color:#5D5A50;margin:0">Your cart is empty.</p>
        <a href={routes.wines} class="hs-link" style="align-self:flex-start">Browse the wines</a>
      </div>
      <div data-cart-full class="hs-stack" hidden>
        <ul data-cart-items class="hs-cart-items"></ul>
        <div style="display:flex;justify-content:space-between;font-size:15px;color:#5D5A50"><span>Shipping</span><span data-cart-ship></span></div>
        <div style="display:flex;justify-content:space-between;font-size:20px"><span>Total</span><span data-cart-total></span></div>
        <button type="button" data-checkout class="hs-btn hs-btn-wine" style="padding:19px">Checkout</button>
        <p style="font-size:13px;color:#5D5A50;margin:0">Free delivery across Australia on {shipping.freeFrom} bottles or more. You must be 18 or over to purchase.</p>
      </div>
    </dialog>

    <!-- Club sign-up -->
    <dialog data-dialog="club" class="hs-dialog hs-modal" aria-labelledby="hs-club-title">
      <div class="hs-dialog-head">
        <h3 id="hs-club-title" class="hs-serif" style="font-size:44px;line-height:1;letter-spacing:-0.02em">The Hillside Club</h3>
        <button type="button" data-close class="hs-x" aria-label="Close">×</button>
      </div>
      <div data-form-wrap class="hs-stack">
        <form data-form class="hs-stack">
          <fieldset class="hs-fieldset">
            <legend class="hs-sr">Membership</legend>
            <div class="hs-rows" data-chips>
              <input type="hidden" name="tier" value={clubTiers[0].id} data-chip-input />
              {
                clubTiers.map((t, i) => (
                  <button type="button" class="hs-row" data-chip value={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                    <span style="display:flex;flex-direction:column;gap:4px;text-align:left">
                      <span class="hs-serif" style="font-size:26px">{t.name}</span>
                      <span style="font-size:14px;color:#5D5A50;font-weight:400">{t.desc}</span>
                    </span>
                    <span>{t.price}</span>
                  </button>
                ))
              }
            </div>
          </fieldset>
          <label class="hs-field">Email<input name="email" type="email" required autocomplete="email" /></label>
          <button type="submit" class="hs-btn hs-btn-wine" style="padding:19px">Join</button>
        </form>
        <p data-form-success hidden style="font-size:17px;line-height:1.6;color:#4B4840;margin:0">Welcome to the club. Your first allocation ships with the next release, and your member tasting is ready whenever you visit.</p>
      </div>
    </dialog>

    <script>
      import '../../scripts/interactions.ts';
      import '../../scripts/cellar-door.ts';
    </script>
  </body>
</html>

<style is:global>
  html,body{margin:0;background:#EFEAE0;color:#1A1C17;font-family:'Instrument Sans',sans-serif;-webkit-font-smoothing:antialiased}
  body{overflow-x:clip}
  *{box-sizing:border-box}
  a{color:inherit;text-decoration:none}
  a:hover{color:var(--wine)}
  input,select,textarea,button{font-family:inherit}
  ::selection{background:var(--wine);color:#EFEAE0}
  :focus-visible{outline:2px solid var(--wine);outline-offset:3px}
  h1,h2,h3,p{margin:0}
  .hs-serif{font-family:'Bodoni Moda',serif;font-weight:400}
  .hs-wine{color:var(--wine)}
  .hs-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .hs-skip{position:absolute;left:12px;top:-60px;z-index:90;background:#1A1C17;color:#EFEAE0;padding:10px 16px}
  .hs-skip:focus{top:12px;color:#EFEAE0}
  .hs-eyebrow{font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:#5D5A50}
  .hs-label{font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#5D5A50;padding:0}
  .hs-link{font-size:12px;letter-spacing:0.16em;text-transform:uppercase;border-bottom:1px solid currentColor;padding-bottom:5px;white-space:nowrap}
  .hs-btn{white-space:nowrap;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;border:none;padding:16px 26px;cursor:pointer;transition:background .3s,color .3s}
  .hs-btn-cream{background:#EFEAE0;color:#1A1C17}
  .hs-btn-cream:hover{background:var(--wine);color:#EFEAE0}
  .hs-btn-wine{background:var(--wine);color:#EFEAE0}
  .hs-btn-wine:hover{background:#1A1C17}
  .hs-btn-ink{background:#1A1C17;color:#EFEAE0}
  .hs-btn-ink:hover{background:var(--wine)}
  .hs-btn-outline{background:transparent;color:#1A1C17;border:1px solid #1A1C17}
  .hs-btn-outline:hover{background:#1A1C17;color:#EFEAE0}
  .hs-btn-text{font-size:11px;letter-spacing:0.16em;text-transform:uppercase;background:none;border:none;border-bottom:1px solid currentColor;padding:0 0 4px;cursor:pointer;white-space:nowrap;color:inherit}

  .hs-demobar{position:relative;z-index:50;background:#0F100D;color:#8A8676;font-family:'JetBrains Mono',monospace;font-size:11px;padding:9px 5vw;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;letter-spacing:0.06em;text-transform:uppercase}
  .hs-demobar a{color:#A6A190;border-bottom:1px solid transparent;padding:2px 0}
  .hs-demobar a:first-child,.hs-demobar a[aria-current]{color:#EFEAE0}
  .hs-demobar a[aria-current]{border-bottom-color:#EFEAE0}

  .hs-header{position:fixed;top:var(--hs-top,0px);left:0;right:0;z-index:40;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px;padding:22px 5vw;transition:transform .5s cubic-bezier(.2,.7,.1,1),background .4s,color .4s,border-color .4s;background:rgba(239,234,224,0.92);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:#1A1C17;border-bottom:1px solid #CBC3B4}
  .hs-header.is-dark{background:transparent;-webkit-backdrop-filter:none;backdrop-filter:none;color:#EFEAE0;border-bottom-color:transparent}
  .hs-header.is-hidden{transform:translateY(calc(-100% - var(--hs-top,0px)))}
  .hs-header a:hover,.hs-header button:hover{color:inherit;opacity:.7}
  .hs-nav,.hs-header-end{display:flex;gap:32px;align-items:center;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;white-space:nowrap}
  .hs-header-end{gap:28px;justify-content:flex-end}
  .hs-nav a[aria-current]{border-bottom:1px solid currentColor;padding-bottom:3px}
  .hs-nav button,.hs-cart-link,.hs-menu-btn,.hs-footer-nav button,.hs-menu-links button{font:inherit;letter-spacing:inherit;text-transform:inherit;background:none;border:none;padding:0;color:inherit;cursor:pointer}
  .hs-logo{font-family:'Bodoni Moda',serif;font-size:28px;letter-spacing:-0.01em;line-height:1;white-space:nowrap}
  .hs-header-btn{white-space:nowrap;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;cursor:pointer;padding:11px 18px;background:transparent;border:1px solid currentColor;color:inherit}
  .hs-menu-btn{display:none;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;justify-self:start}
  @media (max-width: 820px){
    .hs-header{grid-template-columns:auto 1fr auto;gap:16px;padding:18px 20px}
    .hs-nav,.hs-header-btn{display:none}
    .hs-menu-btn{display:block}
    .hs-logo{justify-self:center}
  }

  .hs-cta{padding:18vh 5vw;border-top:1px solid #CBC3B4;display:flex;flex-direction:column;align-items:center;gap:40px;text-align:center}

  .hs-footer-wrap{position:relative;height:100vh;min-height:680px;clip-path:polygon(0 0,100% 0,100% 100%,0 100%)}
  .hs-footer{position:fixed;left:0;right:0;bottom:0;height:100vh;min-height:680px;background:#1A1C17;color:#EFEAE0;display:flex;flex-direction:column;justify-content:space-between;padding:120px 5vw 32px;overflow:hidden}
  .hs-footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:48px}
  .hs-footer-nav{display:flex;flex-direction:column;align-items:flex-start;gap:12px;font-size:12px;letter-spacing:0.16em;text-transform:uppercase}
  .hs-footer a:hover,.hs-footer button:hover{color:#D9B3AE}
  .hs-footer-word{font-size:25vw;line-height:0.78;letter-spacing:-0.045em;text-align:center;white-space:nowrap;margin-bottom:4vh}
  .hs-footer-legal{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12px;color:#A6A190;border-top:1px solid #3A3C33;padding-top:20px}
  .hs-newsletter{display:flex;border-bottom:1px solid #EFEAE0}
  .hs-newsletter input{flex:1;min-width:0;background:transparent;border:none;outline:none;color:#EFEAE0;font-size:16px;padding:14px 0}
  .hs-newsletter input::placeholder{color:#8A8676}
  .hs-newsletter button{white-space:nowrap;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;background:transparent;color:#EFEAE0;border:none;padding:14px 0 14px 16px;cursor:pointer}
  @media (max-width: 600px){ .hs-footer-grid > div:first-child{grid-column:auto !important} .hs-footer{padding-top:96px} }

  .hs-float{position:fixed;left:0;top:0;width:260px;height:340px;z-index:30;pointer-events:none;opacity:0;transition:opacity .35s;overflow:hidden;background:var(--wine)}
  .hs-float.is-on{opacity:1}
  .hs-float > *{position:absolute !important;inset:0;opacity:0;transition:opacity .3s}
  .hs-float > .is-on{opacity:1}
  @media (hover: none), (pointer: coarse){ .hs-float{display:none} }

  .hs-wipe{position:fixed;inset:0;z-index:80;background:var(--wine);display:flex;align-items:center;justify-content:center;pointer-events:none;transform:translateY(100%);color:#EFEAE0}
  .hs-wipe span{font-size:clamp(64px,10vw,180px);letter-spacing:-0.04em}
  .hs-wiping .hs-wipe{transform:none;pointer-events:auto}
  .hs-wipe.is-in{transform:none;pointer-events:auto;transition:transform .8s cubic-bezier(.76,0,.24,1)}
  .hs-wipe.is-out{transform:translateY(-100%);transition:transform .8s cubic-bezier(.76,0,.24,1)}

  .hs-dialog{border:none;padding:0;background:#EFEAE0;color:#1A1C17;max-height:calc(100vh - 48px)}
  .hs-dialog::backdrop{background:rgba(26,28,23,0.6)}
  .hs-dialog[open]{display:flex;flex-direction:column;gap:26px}
  .hs-modal{width:calc(100% - 48px);max-width:580px;padding:clamp(28px,4vw,48px);overflow:auto}
  .hs-drawer{margin:0 0 0 auto;height:100vh;max-height:none;width:100%;max-width:460px;padding:40px;overflow:auto;gap:24px}
  .hs-menu{margin:0;width:100%;max-width:none;height:100vh;max-height:none;padding:22px 20px 40px}
  .hs-menu-links{display:flex;flex-direction:column;gap:8px;flex:1;justify-content:center}
  .hs-menu-links a,.hs-menu-links button{font-family:'Bodoni Moda',serif;font-size:48px;letter-spacing:-0.02em;text-align:left;text-transform:none}
  .hs-menu-links [aria-current]{color:var(--wine)}
  .hs-dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
  .hs-x{background:none;border:none;font-size:30px;cursor:pointer;color:#1A1C17;line-height:1;padding:4px 8px}
  .hs-stack{display:flex;flex-direction:column;gap:26px}
  .hs-stack[hidden]{display:none}
  .hs-fieldset{border:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;min-width:0}
  .hs-rows{display:flex;flex-direction:column;border-top:1px solid #CBC3B4}
