---
import JsonLd from '../../components/JsonLd.astro';
import Motion from '../../components/Motion.astro';
import { config, routes, labels, legalRoutes, type PageKey } from './config';

interface Props {
  title: string;
  description: string;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const keys = Object.keys(routes) as PageKey[];
// Exact match first; any other service page counts as 'detail' and any article as 'blog'.
const page: PageKey | null =
  keys.find((k) => routes[k] === path) ??
  (path.startsWith(routes.services) ? 'detail' : path.startsWith(routes.blog) ? 'blog' : null);
const is = (k: PageKey) => page === k;

const demoPages = keys.map((k) => ({
  label: labels[k],
  href: routes[k],
  color: is(k) ? '#f5f5f2' : '#8a8a86',
  line: is(k) ? 'var(--accent)' : 'transparent',
}));
const nav = (['about', 'services', 'blog', 'faq', 'contact'] as PageKey[]).map((k) => ({
  label: labels[k],
  href: routes[k],
  active: is(k) || (k === 'services' && is('detail')),
}));
const footerNav = (['about', 'services', 'detail', 'blog', 'faq', 'contact'] as PageKey[]).map((k) => ({
  label: k === 'detail' ? 'Small business tax' : labels[k],
  href: routes[k],
}));
const showCta = page !== 'book';
const b = config.business;
const rootVars = `:root{--accent:${config.accent};--hf:${config.headingFontStack}}`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_AU" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={rootVars}></style>
    {jsonld && <JsonLd data={jsonld} />}
    <Motion feel="crisp" />
  </head>
  <body>
    {
      config.showDemoBar && (
        <div style="background:#111;color:#8a8a86;font-family:'Geist Mono',monospace;font-size:11px;padding:9px clamp(20px,3vw,40px);display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;letter-spacing:0.04em;text-transform:uppercase">
          <span style="color:#f5f5f2">Template 03 — Professional services</span>
          <span style="opacity:0.4">/</span>
          {demoPages.map((d) => (
            <a
              href={d.href}
              style={`text-decoration:none;border-bottom:1px solid ${d.line};padding:2px 0;color:${d.color};font-family:inherit;font-size:11px;letter-spacing:0.04em;text-transform:uppercase`}
            >
              {d.label}
            </a>
          ))}
        </div>
      )
    }

    <header style="background:#f5f5f2;border-bottom:1px solid #111;position:sticky;top:0;z-index:10">
      <div style="padding:0 clamp(20px,3vw,40px);display:flex;align-items:stretch;justify-content:space-between;gap:16px;flex-wrap:wrap;min-height:64px">
        <a href={routes.home} style="text-decoration:none;display:flex;align-items:center;gap:10px;color:#111">
          <span style="width:12px;height:12px;background:var(--accent)"></span>
          <span style="font-family:var(--hf);font-size:19px;font-weight:600;letter-spacing:-0.02em">{config.brandName}</span>
        </a>
        <nav style="display:flex;align-items:stretch;flex-wrap:wrap" aria-label="Main">
          {
            nav.map((n) => (
              <a
                href={n.href}
                aria-current={n.active ? 'page' : undefined}
                style={`text-decoration:none;border-left:1px solid #d9d9d4;padding:0 20px;color:${n.active ? 'var(--accent)' : '#111'};font-size:14px;min-height:64px;display:flex;align-items:center`}
              >
                {n.label}
              </a>
            ))
          }
          <a
            href={routes.book}
            style="text-decoration:none;background:#111;color:#f5f5f2;padding:0 24px;font-size:14px;font-weight:500;min-height:64px;display:flex;align-items:center;gap:10px"
            ><span style="width:8px;height:8px;background:var(--accent)"></span>Book a consultation</a
          >
        </nav>
      </div>
    </header>

    <main>
      <slot />

      {
        showCta && (
          <section style="padding:clamp(80px,10vw,144px) clamp(20px,3vw,40px) 0">
            <a
              href={routes.book}
              class="pro-hover-accent"
              style="text-decoration:none;width:100%;border-top:1px solid #111;border-bottom:1px solid #111;padding:clamp(28px,4vw,48px) 0;color:#111;display:flex;justify-content:space-between;align-items:center;gap:24px;text-align:left"
            >
              <span style="font-family:var(--hf);font-weight:500;font-size:clamp(36px,6vw,96px);line-height:0.95;letter-spacing:-0.045em">Book a consultation</span>
              <span style="font-size:clamp(36px,6vw,96px);line-height:1;color:var(--accent)" aria-hidden="true">→</span>
            </a>
          </section>
        )
      }
    </main>

    <footer style="padding:clamp(56px,7vw,96px) clamp(20px,3vw,40px) 32px;display:flex;flex-direction:column;gap:48px">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:32px">
        <div style="display:flex;flex-direction:column;gap:10px">
          <div style="display:flex;align-items:center;gap:10px">
            <span style="width:12px;height:12px;background:var(--accent)"></span><span style="font-family:var(--hf);font-size:19px;font-weight:600;letter-spacing:-0.02em">{config.brandName}</span>
          </div><span style="font-size:14px;line-height:1.55;color:#6b6b6b">{b.tagline}</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:14px;line-height:1.55;color:#4a4a48">
          <span style="font-family:'Geist Mono',monospace;font-size:11px;text-transform:uppercase;color:#111">Office</span><span
            >{b.address.street}<br />{b.address.locality} {b.address.region} {b.address.postcode}</span
          ><a href={`tel:${b.phoneE164}`} style="color:#4a4a48;text-decoration:none">{b.phone}</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:14px">
          <span style="font-family:'Geist Mono',monospace;font-size:11px;text-transform:uppercase">Index</span>
          {
            footerNav.map((fn) => (
              <a href={fn.href} class="pro-hover-ink" style="text-decoration:none;color:#4a4a48;text-align:left;font-size:14px">
                {fn.label}
              </a>
            ))
          }
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:13px;line-height:1.55;color:#6b6b6b">
          <span style="font-family:'Geist Mono',monospace;font-size:11px;text-transform:uppercase;color:#111">Legal</span><span
            >Liability limited by a scheme approved under Professional Standards Legislation.</span
          >
          <a href={legalRoutes.privacy} class="pro-hover-ink" style="text-decoration:none;color:#6b6b6b;font-size:13px">Privacy policy</a>
          <a href={legalRoutes.terms} class="pro-hover-ink" style="text-decoration:none;color:#6b6b6b;font-size:13px">Terms of use</a>
        </div>
      </div>
      <div style="border-top:1px solid #111;padding-top:16px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:'Geist Mono',monospace;font-size:11px;color:#6b6b6b;text-transform:uppercase">
        <span>© 2026 {b.legalName} · ABN {b.abn}</span><span>CA ANZ Registered Practice</span>
      </div>
    </footer>

    <script>
      import '../../scripts/interactions.ts';
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #f5f5f2;
    color: #111;
    font-family: 'Geist', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: #111;
    text-underline-offset: 3px;
  }
  a:hover {
    color: #e2492f;
  }
  input,
  select,
  textarea,
  button {
    font: inherit;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  [hidden] {
    display: none !important;
  }

  /* style-hover equivalents (inline colours need !important to be overridden) */
  .pro-hover-accent:hover {
    color: #e2492f !important;
  }
  .pro-hover-ink:hover {
    color: #111 !important;
  }
  .pro-hover-bg:hover {
    background: #ececE8 !important;
  }

  /* FAQ accordions */
  .pro-faq > summary {
    list-style: none;
  }
  .pro-faq > summary::-webkit-details-marker {
    display: none;
  }
  .pro-faq-sign::after {
    content: '+';
  }
  .pro-faq[open] .pro-faq-sign::after {
    content: '−';
  }

  /* FAQ category filter (selected state) */
  .pro-cat[aria-pressed='true'] {
    color: #111 !important;
  }
  .pro-cat[aria-pressed='true'] .pro-dot {
    background: var(--accent) !important;
  }

  /* Booking chips (selected state) */
  .pro-topic[aria-pressed='true'] .pro-box {
    background: var(--accent) !important;
  }
  .pro-format[aria-pressed='true'] {
    background: #111 !important;
    color: #f5f5f2 !important;
  }
  .pro-slot[aria-pressed='true'] {
    background: var(--accent) !important;
    color: #fff !important;
  }
</style>
