---
// Shared layout for the Privacy policy and Terms of use pages.
import Layout from './Layout.astro';
import { config, routes, legalRoutes } from './config';
import { breadcrumbSchema } from './schema';

export type LegalSection = { h: string; p?: string[]; ul?: string[]; after?: string[] };

interface Props {
  page: keyof typeof legalRoutes;
  title: string;
  description: string;
  heading: string;
  updated: string;
  intro: string;
  sections: LegalSection[];
}
const { page, title, description, heading, updated, intro, sections } = Astro.props;
---

<Layout
  page={page}
  title={`${title} | ${config.brandName}`}
  description={description}
  jsonld={[breadcrumbSchema([{ name: 'Home', path: routes.home }, { name: heading, path: legalRoutes[page] }], Astro.site)]}
>
  <section style="max-width:860px;margin:0 auto;padding:clamp(48px,8vw,104px) clamp(20px,4vw,40px) 40px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px">
    <span style="background:#dfe4d8;border-radius:999px;padding:8px 16px;font-size:14px;color:#3d4a43">Last updated {updated}</span>
    <h1 style="font-family:var(--hf);font-weight:400;font-size:clamp(40px,5.6vw,68px);line-height:1.05;margin:0">{heading}</h1>
    <p style="font-size:19px;line-height:1.6;color:#5d6862;margin:0;max-width:640px;text-wrap:pretty">{intro}</p>
  </section>
  <section style="max-width:860px;margin:0 auto;padding:0 clamp(20px,4vw,40px)">
    <div class="h-legal" style="background:#fbfaf7;border-radius:32px;padding:clamp(28px,5vw,56px)">
      {
        sections.map((s) => (
          <div>
            <h2>{s.h}</h2>
            {s.p?.map((t) => <p>{t}</p>)}
            {s.ul && <ul>{s.ul.map((li) => <li>{li}</li>)}</ul>}
            {s.after?.map((t) => <p>{t}</p>)}
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style is:global>
  .h-legal h2{font-family:var(--hf);font-weight:400;font-size:clamp(24px,2.8vw,30px);line-height:1.2;margin:36px 0 12px}
  .h-legal > div:first-child h2{margin-top:0}
  .h-legal p,.h-legal ul{font-size:17px;line-height:1.7;color:#3d4a43;margin:0 0 14px}
  .h-legal ul{padding-left:22px}
  .h-legal li{margin-bottom:6px}
  .h-legal li::marker{color:var(--accent)}
</style>
