---
import JsonLd from '../../components/JsonLd.astro';
import Motion from '../../components/Motion.astro';
import { config, routes, labels, legalRoutes, type PageKey } from './config';

interface Props {
  page: PageKey | keyof typeof legalRoutes;
  title: string;
  description: string;
  jsonld?: Record<string, unknown>[];
}

const { page, title, description, jsonld = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const keys = Object.keys(routes) as PageKey[];
const isActive = (k: PageKey) => page === k || (k === 'services' && page === 'detail');
const nav: PageKey[] = ['about', 'services', 'blog', 'faq', 'contact'];
const footerNav: PageKey[] = ['about', 'services', 'detail', 'blog', 'faq', 'contact'];
const showCta = page !== 'book';
const b = config.business;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600&family=Lora:ital,wght@0,400;0,500;1,400&family=DM+Serif+Display:ital@0;1&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={`:root{--accent:${config.accent};--hf:${config.headingFontStack}}`} />
    {jsonld.map((d) => <JsonLd data={d} />)}
    <Motion feel="soft" />
  </head>
  <body>
    {
      config.showDemoBar && (
        <div style="background:#26302b;color:#a9b3ad;font-family:'IBM Plex Mono',monospace;font-size:11px;padding:9px clamp(20px,4vw,56px);display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;letter-spacing:0.06em;text-transform:uppercase">
          <a href="/templates/" style="color:#f4f2ec;text-decoration:none;font-family:inherit">← All templates</a>
          <span style="opacity:0.4">/</span>
          <span style="color:#f4f2ec">Template 02 — Health &amp; allied health</span>
          <span style="opacity:0.4">/</span>
          {keys.map((k) => (
            <a
              href={routes[k]}
              aria-current={page === k ? 'page' : undefined}
              style={`text-decoration:none;border-bottom:1px solid ${page === k ? '#f4f2ec' : 'transparent'};padding:2px 0;color:${page === k ? '#f4f2ec' : '#a9b3ad'};font-family:inherit;font-size:11px;letter-spacing:0.06em;text-transform:uppercase`}
            >
              {labels[k]}
            </a>
          ))}
        </div>
      )
    }

    <header style="position:sticky;top:0;z-index:10;padding:14px clamp(12px,3vw,32px);background:linear-gradient(#f4f2ec 70%,rgba(244,242,236,0))">
      <div style="max-width:1240px;margin:0 auto;background:#fbfaf7;border-radius:32px;padding:10px 10px 10px 26px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;box-shadow:0 1px 0 rgba(38,48,43,0.06)">
        <a href={routes.home} style="text-decoration:none;display:flex;align-items:center;gap:10px;color:#26302b">
          <span style="width:22px;height:22px;border-radius:50%;background:var(--accent)"></span>
          <span style="font-family:var(--hf);font-size:22px;font-weight:500">{config.brandName}</span>
        </a>
        <nav aria-label="Main" style="display:flex;gap:2px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
          {
            nav.map((k) => (
              <a
                href={routes[k]}
                aria-current={page === k ? 'page' : undefined}
                style={`text-decoration:none;background:${isActive(k) ? '#dfe4d8' : 'transparent'};border-radius:999px;padding:10px 13px;color:#26302b;font-size:15px`}
              >
                {labels[k]}
              </a>
            ))
          }
          <a href={routes.book} style="text-decoration:none;background:var(--accent);color:#fbfaf7;border-radius:999px;padding:12px 22px;font-size:15px;font-weight:500">Book online</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />

      {
        showCta && (
          <section style="max-width:1240px;margin:0 auto;padding:clamp(72px,10vw,128px) clamp(20px,4vw,40px) 0">
            <div style="background:var(--accent);color:#fbfaf7;border-radius:36px;padding:clamp(40px,7vw,88px) clamp(24px,5vw,64px);display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px">
              <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(34px,4.6vw,58px);line-height:1.08;margin:0;max-width:760px">Same-week appointments, usually</h2>
              <p style="margin:0;font-size:18px;opacity:0.9">No referral needed. Rebates claimed on the spot.</p>
              <a href={routes.book} style="text-decoration:none;background:#fbfaf7;color:#26302b;border-radius:999px;padding:17px 30px;font-size:16px;font-weight:500">Book online</a>
            </div>
          </section>
        )
      }
    </main>

    <footer style="max-width:1240px;margin:0 auto;padding:clamp(72px,9vw,112px) clamp(20px,4vw,40px) 40px">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:40px;padding-bottom:40px;border-bottom:1px solid #dde2d6">
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;align-items:center;gap:10px"><span style="width:22px;height:22px;border-radius:50%;background:var(--accent)"></span><span style="font-family:var(--hf);font-size:22px;font-weight:500">{config.brandName}</span></div>
          <span style="font-size:15px;line-height:1.6;color:#5d6862">Physiotherapy &amp; Clinical Pilates in Norwood, Adelaide.</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:15px;line-height:1.6;color:#5d6862">
          <span style="color:#26302b;font-weight:500">Visit</span><span>{b.address.line1}<br />{b.address.locality} {b.address.region} {b.address.postcode}</span><span>{b.phone}</span>
        </div>
        <nav aria-label="Footer" style="display:flex;flex-direction:column;gap:6px;font-size:15px">
          <span style="font-weight:500">Explore</span>
          {
            footerNav.map((k) => (
              <a href={routes[k]} class="h-hover-ink" style="text-decoration:none;color:#5d6862;text-align:left;font-size:15px">
                {k === 'detail' ? 'Clinical Pilates' : labels[k]}
              </a>
            ))
          }
        </nav>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:15px;line-height:1.6;color:#5d6862">
          <span style="color:#26302b;font-weight:500">Nearby</span><span>{b.areas.join(' · ')}</span>
        </div>
      </div>
      <div style="padding-top:24px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:13px;color:#5d6862">
        <span>© 2026 {b.legalName} · ABN {b.abn}</span>
        <span style="display:flex;gap:18px;flex-wrap:wrap">
          <a href={legalRoutes.privacy} class="h-hover-ink" style="text-decoration:none;color:#5d6862">Privacy policy</a>
          <a href={legalRoutes.terms} class="h-hover-ink" style="text-decoration:none;color:#5d6862">Terms of use</a>
          <span>All physiotherapists AHPRA registered</span>
        </span>
      </div>
    </footer>

    <script>
      import '../../scripts/interactions.ts';
    </script>
  </body>
</html>

<style is:global>
  *{box-sizing:border-box}
  body{margin:0;background:#f4f2ec;color:#26302b;font-family:'Figtree',sans-serif;-webkit-font-smoothing:antialiased}
  a{color:#4f6f5a;text-underline-offset:3px}
  a:hover{color:#26302b}
  input,select,textarea,button{font:inherit}
  [hidden]{display:none !important}

  /* hover states (style-hover in the design) */
  .h-hover-sage:hover{background:#dfe4d8 !important}
  .h-hover-mist:hover{background:#ecefe6 !important}
  .h-hover-ink:hover{color:#26302b !important}

  /* whole-card links: the title link stretches over its card */
  .h-card-link::after{content:'';position:absolute;inset:0;border-radius:inherit}
  .h-card-link:focus-visible{outline:none}
  article:has(.h-card-link:focus-visible){outline:2px solid var(--accent);outline-offset:3px}
  article:has(.h-card-link):hover{background:#ecefe6 !important}

  /* accordions */
  .h-faq summary{list-style:none}
  .h-faq summary::-webkit-details-marker{display:none}
  .h-sign::before{content:'+'}
  .h-faq[open] .h-sign::before{content:'−'}

  /* selectable pills: default + pressed */
  .h-pill{background:#f4f2ec;color:#26302b}
  .h-pill-light{background:#fbfaf7;color:#26302b}
  .h-pill[aria-pressed='true'],.h-pill-light[aria-pressed='true']{background:var(--accent);color:#fbfaf7}
  .h-appt{background:#fbfaf7;border:1px solid #dde2d6}
  .h-appt[aria-pressed='true']{background:#dfe4d8;border-color:var(--accent)}

  .h-field{padding:15px 18px;border:1px solid #dde2d6;border-radius:14px;background:#f4f2ec;font-size:16px;width:100%}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
