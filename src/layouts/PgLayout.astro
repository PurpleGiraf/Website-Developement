---
// Purple Giraffe Digital: shared head, navigation (with services drop-down), footer and motion kit.
import { Image } from 'astro:assets';
import logoHoriz from '../assets/pg/logo-horiz.png';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import { services, navLinks, type NavKey } from '../data/pg';
import '../styles/pg-motion.css';

interface Props {
  title: string;
  description: string;
  /** Which nav item to underline (a service key underlines Services). */
  active?: NavKey;
  /** Extra JSON-LD blocks for this page. */
  jsonld?: Record<string, unknown>[];
  /** Play the first-visit intro curtain (homepage only). */
  intro?: boolean;
  /** Hide the big footer (e.g. a page with its own closing section). */
  footer?: boolean;
}

const { title, description, active = '', jsonld = [], intro = false, footer = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const svcActive = services.some((s) => s.key === active);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content="Purple Giraffe Digital" />
    <meta name="theme-color" content="#2b1745" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      // JS-only entrance states; without JS (or if the motion script stalls) everything shows.
      var r = document.documentElement;
      r.classList.add('pg-js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('pg-reduced');
      setTimeout(function () { if (!r.dataset.pgMotion) r.classList.add('pg-failsafe'); }, 2500);
    </script>
    {jsonld.map((d) => <JsonLd data={d} />)}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="pg-skip">Skip to content</a>
    {
      intro && (
        <div class="pg-intro" aria-hidden="true">
          <span>
            <i>Purple Giraffe Digital</i>
          </span>
        </div>
      )
    }
    <div class="pg-progress" aria-hidden="true"></div>

    <header class="pg-header" style="position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(246,242,236,0.86);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);color:#2b1745">
      <div style="max-width:1560px;margin:0 auto;padding:14px clamp(20px,4vw,56px);display:flex;align-items:center;justify-content:space-between;gap:24px">
        <a href="/" style="display:flex;align-items:center;gap:14px;flex:none" aria-label="Purple Giraffe Digital home">
          <Image src={logoHoriz} alt="Purple Giraffe" height={46} densities={[1, 2]} style="height:46px;width:auto;display:block" loading="eager" />
          <span style="width:1px;height:28px;background:#2b1745;opacity:0.3"></span>
          <span style="font-size:13px;letter-spacing:0.18em;text-transform:uppercase">Digital</span>
        </a>
        <nav id="pg-nav" aria-label="Main" class="pg-nav">
          <div class="pg-dd">
            <button type="button" class="pg-dd-btn" aria-expanded="false" aria-controls="pg-dd-menu" style={`border-bottom:1px solid ${svcActive ? '#2b1745' : 'transparent'}`}>
              Services <span aria-hidden="true" style="font-size:9px;opacity:0.6">▼</span>
            </button>
            <div id="pg-dd-menu" class="pg-dd-menu">
              <div class="pg-dd-panel">
                {
                  services.map((s) => (
                    <a href={s.href} aria-current={s.key === active ? 'page' : undefined}>
                      <span>{s.label}</span>
                      <span style="font-size:12px;color:#7d6a96">{s.n}</span>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
          {
            navLinks.map((l) => (
              <a href={l.href} class="pg-nav-link" aria-current={l.key === active ? 'page' : undefined} style={`border-bottom:1px solid ${l.key === active ? '#2b1745' : 'transparent'}`}>
                {l.label}
              </a>
            ))
          }
          <a href="/contact/" class="pg-nav-cta">Start a project</a>
        </nav>
        <a href="/contact/" data-magnetic class="pg-pill pg-cta" style="flex:none;white-space:nowrap;padding:12px 22px;border:1px solid #2b1745;border-radius:999px;font-size:15px">Start a project</a>
        <button type="button" class="pg-menu-btn" aria-expanded="false" aria-controls="pg-nav">Menu</button>
      </div>
    </header>

    <main id="main" style="background:#f6f2ec">
      <slot />
    </main>
    {footer && <SiteFooter />}

    <style is:global>
      html,body{margin:0;background:#f6f2ec;color:#2b1745;font-family:'Outfit',sans-serif;-webkit-font-smoothing:antialiased}
      *{box-sizing:border-box}
      a{color:inherit;text-decoration:none}
      a:hover{color:#7d5aa6}
      input::placeholder,textarea::placeholder{color:#9d8db3}
      ::selection{background:#2b1745;color:#f6f2ec}
      [hidden]{display:none !important}
      :focus-visible{outline:2px solid #7d5aa6;outline-offset:3px}
      html{scroll-padding-top:90px}
      html.lenis,html.lenis body{height:auto}
      .lenis.lenis-smooth{scroll-behavior:auto !important}
      .pg-skip{position:absolute;left:12px;top:-60px;z-index:400;background:#2b1745;color:#f6f2ec;padding:10px 16px;border-radius:999px}
      .pg-skip:focus{top:12px;color:#f6f2ec}

      /* Shared hover states */
      .pg-pill{transition:background .3s,color .3s,transform .6s cubic-bezier(.19,1,.22,1)}
      .pg-pill:hover{background:#2b1745;color:#f6f2ec}
      .pg-solid{transition:background .3s,transform .6s cubic-bezier(.19,1,.22,1)}
      .pg-solid:hover{background:#4a2c70;color:#f6f2ec}
      .pg-big-link{transition:color .4s}
      .pg-big-link:hover{color:#b7a6cc}

      /* Navigation */
      .pg-nav{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:4px clamp(16px,2.2vw,36px);font-size:15px}
      .pg-nav-link{white-space:nowrap;padding:8px 0}
      .pg-dd{position:relative;padding:8px 0}
      .pg-dd-btn{all:unset;cursor:pointer;display:flex;align-items:center;gap:6px;color:#2b1745}
      .pg-dd-btn:focus-visible{outline:2px solid #7d5aa6;outline-offset:3px}
      .pg-dd-menu{position:absolute;top:100%;left:-24px;padding-top:12px;visibility:hidden;opacity:0;transform:translateY(-8px);transition:opacity .35s cubic-bezier(.19,1,.22,1),transform .35s cubic-bezier(.19,1,.22,1),visibility 0s .35s}
      .pg-dd[data-open] .pg-dd-menu{visibility:visible;opacity:1;transform:none;transition-delay:0s}
      .pg-dd-panel{background:#f6f2ec;border:1px solid #cfc4dc;border-radius:16px;padding:8px;min-width:280px;display:flex;flex-direction:column;box-shadow:0 24px 48px -24px rgba(43,23,69,0.35)}
      .pg-dd-panel a{display:flex;justify-content:space-between;gap:16px;padding:13px 14px;border-radius:10px;transition:background .2s,padding .4s cubic-bezier(.19,1,.22,1)}
      .pg-dd-panel a:hover,.pg-dd-panel a[aria-current]{background:#ebe4f1;color:#2b1745;padding-left:20px}
      .pg-nav-cta,.pg-menu-btn{display:none}
      @media (max-width: 1080px){
        .pg-cta{display:none}
        .pg-menu-btn{display:block;flex:none;font:inherit;font-size:15px;padding:12px 22px;border:1px solid #2b1745;border-radius:999px;background:transparent;color:#2b1745;cursor:pointer}
        header[data-open] .pg-menu-btn{background:#2b1745;color:#f6f2ec}
        .pg-nav{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;padding:8px clamp(20px,4vw,56px) 24px;background:#f6f2ec;border-bottom:1px solid #cfc4dc;font-size:22px;font-weight:300;max-height:calc(100vh - 74px);overflow:auto}
        header[data-open] .pg-nav{display:flex}
        .pg-nav > a,.pg-dd{padding:14px 0;border-bottom:1px solid #e4dcec !important}
        .pg-dd-btn{display:none}
        .pg-dd-menu{position:static;visibility:visible;opacity:1;transform:none;padding:0}
        .pg-dd-panel{background:none;border:0;box-shadow:none;padding:0;min-width:0}
        .pg-dd-panel a{padding:10px 0}
        .pg-nav-cta{display:block;margin-top:16px;text-align:center;background:#2b1745;color:#f6f2ec !important;border-radius:999px;padding:14px !important;font-size:17px}
      }
    </style>

    <script>
      import '../scripts/pg-motion.ts';
      import '../scripts/interactions.ts';

      const header = document.querySelector<HTMLElement>('.pg-header');
      const menuBtn = document.querySelector<HTMLButtonElement>('.pg-menu-btn');
      const setOpen = (open: boolean) => {
        header?.toggleAttribute('data-open', open);
        menuBtn?.setAttribute('aria-expanded', String(open));
        if (menuBtn) menuBtn.textContent = open ? 'Close' : 'Menu';
      };
      menuBtn?.addEventListener('click', () => setOpen(!header?.hasAttribute('data-open')));
      document.querySelectorAll('#pg-nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

      // Services drop-down: hover on desktop, click/keyboard everywhere.
      const dd = document.querySelector<HTMLElement>('.pg-dd');
      const ddBtn = dd?.querySelector<HTMLButtonElement>('.pg-dd-btn');
      const setDd = (open: boolean) => {
        dd?.toggleAttribute('data-open', open);
        ddBtn?.setAttribute('aria-expanded', String(open));
      };
      if (dd && ddBtn) {
        dd.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && setDd(true));
        dd.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && setDd(false));
        ddBtn.addEventListener('click', () => setDd(!dd.hasAttribute('data-open')));
        dd.addEventListener('focusout', (e) => {
          if (!dd.contains(e.relatedTarget as Node)) setDd(false);
        });
      }
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          setOpen(false);
          setDd(false);
        }
      });
    </script>
  </body>
</html>
