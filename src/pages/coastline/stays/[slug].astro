---
import ListingDetail from '../../../templates/coastline/ListingDetail.astro';
import { stays } from '../../../templates/coastline/data';

export function getStaticPaths() {
  return stays.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
---

<ListingDetail item={item} />
