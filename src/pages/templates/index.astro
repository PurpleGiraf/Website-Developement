---
// Website templates showcase (from "Website Templates" in the redesign proposal).
// Live templates link to the built demo sites; the rest are marked as coming soon.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PgLayout from '../../layouts/PgLayout.astro';

const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/pg/templates/*.{png,jpg,webp}', { eager: true });
const shotFor = (id: string) => Object.entries(shots).find(([p]) => p.split('/').pop()?.replace(/\.[^.]+$/, '') === id)?.[1].default;

const T = [
  { name: 'Counsel', cat: 'Professional services', desc: 'A calm, credible site for law, accounting and advisory firms, built around expertise and enquiries.', features: ['Team profiles', 'Service pages', 'Enquiry forms'], frame: '#ebe4f1', href: '/professional/', demo: 'Haddon Lowe, chartered accountants' },
  { name: 'Clinic', cat: 'Health', desc: 'Clear patient journeys for practices and clinics, with online booking front and centre.', features: ['Online booking', 'Practitioner bios', 'FAQ for AEO'], frame: '#d8cee6', href: '/health/', demo: 'Saltbush Physio' },
  { name: 'Cellar Door', cat: 'Wine & hospitality', desc: 'Rich, photo-led storytelling for wineries, restaurants and venues.', features: ['Online store', 'Events', 'Tasting notes'], frame: '#e9e1d6' },
  { name: 'Coastline', cat: 'Tourism', desc: 'Immersive destination pages for holiday parks, tours and attractions.', features: ['Bookings', 'Maps & locations', 'Galleries'], frame: '#dfe4ec' },
  { name: 'Franchise', cat: 'Trades & franchise', desc: 'One brand, many locations, with local pages that rank in every suburb you serve.', features: ['Location pages', 'Quote requests', 'Reviews'], frame: '#ebe4f1', href: '/trades/', demo: 'Ashgrove Joinery & Build' },
  { name: 'Boutique', cat: 'Retail', desc: 'A clean, conversion-focused storefront for product brands.', features: ['E-commerce', 'Product filters', 'Email capture'], frame: '#e9e1d6' },
  { name: 'Community', cat: 'Not-for-profit', desc: 'Accessible, mission-first sites for associations and charities.', features: ['Donations', 'Membership', 'Accessibility'], frame: '#d8cee6' },
  { name: 'Launch', cat: 'Professional services', desc: 'A single, focused landing page for a campaign, product or new business.', features: ['One page', 'Lead capture', 'Analytics'], frame: '#dfe4ec' },
].map((t, i) => {
  const id = t.name.toLowerCase().replace(/\s+/g, '-');
  return { ...t, n: String(i + 1).padStart(2, '0'), id, shot: shotFor(id) };
});

const cats = ['All', ...Array.from(new Set(T.map((t) => t.cat)))];
const live = T.filter((t) => t.href).length;

const steps = [
  { n: '01', title: 'Choose a template', body: 'Pick the design that suits your industry and goals. We will talk it through with you before anything is built.' },
  { n: '02', title: 'We tailor it', body: 'Our team applies your brand, writes or refines your content, and sets up SEO, GEO and AEO foundations.' },
  { n: '03', title: 'Launch and grow', body: 'We launch, test and maintain your site, and connect it to your wider digital marketing.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Website templates | Purple Giraffe Digital',
  hasPart: T.filter((t) => t.href).map((t) => ({ '@type': 'WebSite', name: `${t.name} template (${t.demo})`, url: new URL(t.href!, Astro.site).href })),
};
---

<PgLayout title="Website templates | Purple Giraffe Digital" description={`Launch sooner with a website template designed by Purple Giraffe, tailored to your brand, content and customers. Preview ${live} live templates for professional services, health and trades.`} active="templates" jsonld={[schema]}>
  <!-- Hero -->
  <section style="max-width:1560px;margin:0 auto;padding:clamp(150px,22vh,220px) clamp(20px,4vw,56px) clamp(64px,10vh,112px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:32px 64px;align-items:end">
    <h1 data-split data-split-done="1" style="margin:0;font-weight:200;font-size:clamp(58px,9.4vw,168px);line-height:0.92;letter-spacing:-0.055em;grid-column:1/-1">
      <span class="pg-l" style="padding-bottom:0.2em;margin-bottom:-0.14em"><span style="--l:0">Website</span></span>
      <span class="pg-l" style="padding-bottom:0.2em;margin-bottom:-0.14em"><span style="--l:1">templates<span style="color:#9a86b5">.</span></span></span>
    </h1>
    <p data-reveal style="margin:0;font-size:clamp(17px,1.35vw,21px);line-height:1.5;font-weight:300;max-width:480px">Launch sooner with a website designed by our team, then tailored to your brand, your content and your customers.</p>
    <div data-reveal style="display:flex;justify-content:flex-end;align-items:center;gap:14px;font-size:14px;letter-spacing:0.12em;text-transform:uppercase">
      <span>Designed in house</span><span style="width:48px;height:1px;background:#2b1745"></span><span>Built to be found</span>
    </div>
  </section>

  <div data-tpl-root>
    <!-- Filters -->
    <section style="position:sticky;top:74px;z-index:20;background:rgba(246,242,236,0.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)">
      <div style="max-width:1560px;margin:0 auto;padding:16px clamp(20px,4vw,56px);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px 32px;border-top:1px solid #2b1745;border-bottom:1px solid #cfc4dc">
        <div role="group" aria-label="Filter by industry" data-cursor="Filter" style="display:flex;flex-wrap:nowrap;gap:8px;overflow-x:auto;min-width:0;flex:1;scrollbar-width:none">
          {
            cats.map((c) => (
              <button type="button" class="pg-filter" data-tpl-filter={c} aria-pressed={c === 'All' ? 'true' : 'false'}>
                {c}
              </button>
            ))
          }
        </div>
        <span data-tpl-count aria-live="polite" style="font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:#7d6a96">{T.length} templates</span>
      </div>
    </section>

    <!-- Grid -->
    <section style="max-width:1560px;margin:0 auto;padding:clamp(48px,7vh,80px) clamp(20px,4vw,56px) clamp(120px,18vh,200px)">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,520px),1fr));gap:clamp(48px,6vh,72px) 24px">
        {
          T.map((t) => {
            const Frame = t.href ? 'a' : 'div';
            return (
              <article data-reveal data-tpl-cat={t.cat} style="display:flex;flex-direction:column;gap:22px">
                <Frame href={t.href} class={t.href ? 'pg-frame' : 'pg-frame pg-frame-soon'} data-cursor={t.href ? 'Preview' : 'Soon'} aria-label={t.href ? `Preview the ${t.name} template` : undefined} style={`display:block;background:${t.frame};border-radius:20px;padding:clamp(20px,3vw,44px) clamp(20px,3vw,44px) 0;overflow:hidden`}>
                  <div class="pg-browser" style="border-radius:10px 10px 0 0;overflow:hidden;background:#fff;box-shadow:0 30px 60px -30px rgba(43,23,69,0.45)">
                    <div style="display:flex;align-items:center;gap:6px;padding:10px 14px;background:#fbf9f6;border-bottom:1px solid #ece6f2">
                      <span style="width:9px;height:9px;border-radius:50%;background:#d8cee6" />
                      <span style="width:9px;height:9px;border-radius:50%;background:#d8cee6" />
                      <span style="width:9px;height:9px;border-radius:50%;background:#d8cee6" />
                      <span style="flex:1;margin-left:10px;height:18px;border-radius:999px;background:#f1ecf6;font-size:11px;line-height:18px;padding:0 10px;color:#7d6a96;overflow:hidden;white-space:nowrap">{t.href ?? ''}</span>
                    </div>
                    <div style="aspect-ratio:16/10;position:relative;background:#f1ecf6;overflow:hidden">
                      {t.shot ? (
                        <Image src={t.shot} alt={`${t.name} template home page, shown as ${t.demo}`} widths={[640, 960, 1440]} sizes="(min-width: 1180px) 680px, 100vw" class="pg-shot" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0;display:block" />
                      ) : (
                        <div class="pg-soon" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;color:#7d6a96">
                          <span style="font-weight:200;font-size:clamp(36px,4vw,56px);letter-spacing:-0.05em;color:#2b1745">{t.name}</span>
                          <span style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase">In design</span>
                        </div>
                      )}
                    </div>
                  </div>
                </Frame>
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap">
                  <div style="display:flex;flex-direction:column;gap:8px">
                    <span style="font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:#7d6a96">
                      {t.n} · {t.cat}
                    </span>
                    <h3 style="margin:0;font-weight:300;font-size:clamp(30px,2.8vw,44px);line-height:1;letter-spacing:-0.045em">{t.name}</h3>
                    <p style="margin:0;font-size:16px;line-height:1.5;font-weight:300;max-width:420px;color:#4a3762">{t.desc}</p>
                    {t.demo && <p style="margin:0;font-size:14px;font-weight:300;color:#7d6a96">Demo: {t.demo}</p>}
                  </div>
                  <div style="display:flex;gap:10px;flex-wrap:wrap">
                    {t.href ? (
                      <a href={t.href} data-magnetic class="pg-pill" style="white-space:nowrap;padding:12px 20px;border:1px solid #2b1745;border-radius:999px;font-size:15px">
                        Preview
                      </a>
                    ) : (
                      <span style="white-space:nowrap;padding:12px 20px;border:1px dashed #9a86b5;border-radius:999px;font-size:15px;color:#7d6a96">Coming soon</span>
                    )}
                    <a href="/contact/" data-magnetic class="pg-solid" style="white-space:nowrap;padding:12px 20px;background:#2b1745;color:#f6f2ec;border-radius:999px;font-size:15px">
                      {t.href ? 'Use this template' : 'Register interest'}
                    </a>
                  </div>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:8px">
                  {t.features.map((ft) => (
                    <span style="padding:6px 12px;border-radius:999px;background:#ebe4f1;font-size:13px">{ft}</span>
                  ))}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </div>

  <!-- How it works -->
  <section data-dark style="background:#2b1745;color:#f6f2ec;padding:clamp(110px,18vh,200px) clamp(20px,4vw,56px) 0">
    <div style="max-width:1560px;margin:0 auto;display:flex;flex-direction:column;gap:clamp(48px,8vh,88px)">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:16px">
        <h2 data-split style="margin:0;font-weight:200;font-size:clamp(44px,5.6vw,96px);line-height:1;letter-spacing:-0.05em">How it works</h2>
        <span data-reveal style="font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#b7a6cc">From template to launch</span>
      </div>
      <div data-stagger style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));border-top:1px solid rgba(183,166,204,0.4)">
        {
          steps.map((s) => (
            <div class="pg-step" style="display:flex;flex-direction:column;gap:20px;padding:36px 32px 0 0">
              <span style="font-weight:200;font-size:clamp(56px,5vw,88px);line-height:1;letter-spacing:-0.05em;color:#b7a6cc">{s.n}</span>
              <span style="font-size:clamp(24px,2vw,30px);font-weight:300;letter-spacing:-0.03em">{s.title}</span>
              <span style="font-size:17px;line-height:1.55;font-weight:300;color:#d8cee6;max-width:400px">{s.body}</span>
            </div>
          ))
        }
      </div>
      <p data-reveal style="margin:0;font-size:18px;line-height:1.6;font-weight:300;color:#d8cee6;max-width:640px">
        <span style="display:block;font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#b7a6cc;margin-bottom:14px">Need something bespoke?</span>
        Every template can be extended, or we can design and build a custom website from scratch. Call SA <a href="tel:0884252970" style="color:#f6f2ec">08 8425 2970</a>, WA <a href="tel:0862639236" style="color:#f6f2ec">08 6263 9236</a> or QLD <a href="tel:0735449535" style="color:#f6f2ec">07 3544 9535</a>.
      </p>
    </div>
  </section>
</PgLayout>

<style is:global>
  .pg-filter{flex:none;white-space:nowrap;font:inherit;font-size:15px;font-weight:300;padding:9px 18px;border-radius:999px;cursor:pointer;transition:background .3s,color .3s;border:1px solid #2b1745;background:transparent;color:#2b1745}
  .pg-filter[aria-pressed='true']{background:#2b1745;color:#f6f2ec}
  .pg-filter:hover{background:#ebe4f1}
  .pg-filter[aria-pressed='true']:hover{background:#2b1745}

  /* Template frames: lift on hover, and the screenshot scrolls down the page like a live preview */
  .pg-frame{transition:transform .6s cubic-bezier(.19,1,.22,1)}
  .pg-frame:hover{transform:translateY(-8px)}
  .pg-browser{transition:transform .8s cubic-bezier(.19,1,.22,1),box-shadow .8s}
  .pg-frame:hover .pg-browser{transform:translateY(-6px) scale(1.01);box-shadow:0 50px 80px -40px rgba(43,23,69,0.55)}
  .pg-shot{transition:object-position 5s cubic-bezier(.45,0,.55,1)}
  .pg-frame:hover .pg-shot,.pg-frame:focus-visible .pg-shot{object-position:50% 100% !important}
  .pg-soon{background:repeating-linear-gradient(135deg,#ebe4f1 0 1px,#f6f2ec 1px 14px);background-size:200% 200%;animation:pg-soon-drift 14s linear infinite}
  @keyframes pg-soon-drift{to{background-position:100% 100%}}
  .pg-step{border-top:1px solid transparent;transition:border-color .4s}
  .pg-step:hover{border-top-color:#b7a6cc}
  .pg-reduced .pg-shot{transition:none}
  .pg-reduced .pg-soon{animation:none}
  .pg-reduced .pg-frame:hover,.pg-reduced .pg-frame:hover .pg-browser{transform:none}
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.querySelector<HTMLElement>('[data-tpl-root]');
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-tpl-filter]');
    const cards = root.querySelectorAll<HTMLElement>('[data-tpl-cat]');
    const count = root.querySelector<HTMLElement>('[data-tpl-count]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const cat = btn.dataset.tplFilter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let shown = 0;
        cards.forEach((c) => {
          const hide = cat !== 'All' && c.dataset.tplCat !== cat;
          c.hidden = hide;
          if (hide) return;
          // Cards that stay visible re-enter with a short staggered rise.
          c.classList.add('is-in');
          if (!reduced) {
            c.animate(
              [
                { opacity: 0, transform: 'translateY(32px) scale(0.98)' },
                { opacity: 1, transform: 'none' },
              ],
              { duration: 700, delay: shown * 70, easing: 'cubic-bezier(.19,1,.22,1)', fill: 'backwards' },
            );
          }
          shown++;
        });
        if (count) count.textContent = `${shown} ${shown === 1 ? 'template' : 'templates'}`;
      }),
    );
  }
</script>
