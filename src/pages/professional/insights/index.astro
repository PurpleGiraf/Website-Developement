---
import Layout from '../../../templates/professional/Layout.astro';
import SeoBadge from '../../../templates/professional/SeoBadge.astro';
import { featuredPost, posts } from '../../../templates/professional/data';
import { config, routes } from '../../../templates/professional/config';
import { abs } from '../../../templates/professional/schema';

const publisher = { '@id': abs(Astro.site, routes.home) + '#business', '@type': 'Organization', name: config.brandName };
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${config.brandName} Insights`,
  url: abs(Astro.site, routes.blog),
  publisher,
  blogPost: [
    {
      '@type': 'BlogPosting',
      headline: featuredPost.title,
      description: featuredPost.dek,
      datePublished: featuredPost.isoDate,
      dateModified: featuredPost.isoDate,
      articleSection: featuredPost.cat,
      author: { '@type': 'Person', name: featuredPost.author, jobTitle: 'Partner, CA' },
      publisher,
    },
    ...posts.map((po) => ({
      '@type': 'BlogPosting',
      headline: po.title,
      datePublished: po.isoDate,
      articleSection: po.cat,
      publisher,
    })),
  ],
};
---

<Layout
  title="Insights: tax and business advice | Haddon Lowe"
  description="Plain-English articles from Haddon Lowe partners on tax, payroll, SMSF, structuring and exit planning for Australian private businesses."
  jsonld={jsonld}
>
  <section style="padding:clamp(40px,6vw,88px) clamp(20px,3vw,40px) 0;display:flex;flex-direction:column;gap:28px">
    <span style="font-family:'Geist Mono',monospace;font-size:12px;text-transform:uppercase;color:#6b6b6b">Insights</span>
    <h1 style="font-family:var(--hf);font-weight:500;font-size:clamp(44px,7vw,112px);line-height:0.94;letter-spacing:-0.045em;margin:0">Insights</h1>
    <SeoBadge>Article schema · partner bylines + review dates</SeoBadge>
  </section>
  <section style="padding:clamp(40px,5vw,64px) clamp(20px,3vw,40px) 0">
    <article style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:32px;border-top:1px solid #111;padding-top:24px">
      <div style="aspect-ratio:16/10;background:repeating-linear-gradient(135deg,#e3e3df 0 1px,#ececE8 1px 12px);display:flex;align-items:flex-end;padding:14px;font-family:'Geist Mono',monospace;font-size:11px;color:#6b6b6b">featured image</div>
      <div style="display:flex;flex-direction:column;gap:18px">
        <div style="font-family:'Geist Mono',monospace;font-size:12px;color:#6b6b6b;display:flex;gap:16px;text-transform:uppercase">
          <span style="color:var(--accent)">{featuredPost.cat}</span><time datetime={featuredPost.isoDate}>{featuredPost.date}</time><span>{featuredPost.readTime}</span>
        </div>
        <h2 style="font-family:var(--hf);font-weight:500;font-size:clamp(30px,3.6vw,52px);line-height:1;letter-spacing:-0.035em;margin:0">{featuredPost.title}</h2>
        <p style="margin:0;font-size:17px;line-height:1.55;color:#4a4a48">{featuredPost.dek}</p>
        <span style="font-size:14px;color:#6b6b6b">{featuredPost.byline}</span>
      </div>
    </article>
  </section>
  <section style="padding:clamp(56px,7vw,96px) clamp(20px,3vw,40px) 0">
    {
      posts.map((po) => (
        <article style="border-top:1px solid #111;padding:20px 0;display:grid;grid-template-columns:minmax(90px,0.6fr) minmax(0,3fr) minmax(0,1.2fr);gap:20px;align-items:baseline">
          <time datetime={po.isoDate} style="font-family:'Geist Mono',monospace;font-size:12px;color:#6b6b6b">{po.date}</time>
          <h3 style="margin:0;font-family:var(--hf);font-size:clamp(20px,2vw,26px);font-weight:500;letter-spacing:-0.02em;line-height:1.15">{po.title}</h3>
          <span style="font-family:'Geist Mono',monospace;font-size:12px;color:var(--accent);text-transform:uppercase;text-align:right">{po.cat}</span>
        </article>
      ))
    }
  </section>
</Layout>
