---
import Layout from '../../../templates/health/Layout.astro';
import SeoNote from '../../../templates/health/SeoNote.astro';
import { config, routes } from '../../../templates/health/config';
import { blogCats, posts } from '../../../templates/health/data';
import { breadcrumbSchema } from '../../../templates/health/schema';
import { articles, articleUrl } from '../../../templates/health/posts';
import Photo from '../../../components/Photo.astro';

const blog = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${config.brandName} resources`,
  url: new URL(routes.blog, Astro.site).href,
  publisher: { '@id': new URL(routes.home, Astro.site).href + '#clinic' },
  blogPost: posts.map((po) => {
    const [name, ...rest] = po.author.split(', ');
    return {
      '@type': 'BlogPosting',
      headline: po.title,
      url: new URL(articleUrl(po.title), Astro.site).href,
      datePublished: articles[po.title].date,
      articleSection: po.cat,
      author: { '@type': 'Person', name, jobTitle: rest.join(', ') },
    };
  }),
};
---

<Layout
  page="blog"
  title={`Physio resources and exercise guides | ${config.brandName}`}
  description="Short, practical reads from our Norwood physios on back and neck pain, sport, Pilates and women's health, each written by a named, qualified clinician."
  jsonld={[breadcrumbSchema([{ name: 'Home', path: routes.home }, { name: 'Resources', path: routes.blog }], Astro.site), blog]}
>
  <div data-faq-root>
    <section style="max-width:1240px;margin:0 auto;padding:clamp(48px,8vw,104px) clamp(20px,4vw,40px) 48px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px">
      <span style="background:#dfe4d8;border-radius:999px;padding:8px 16px;font-size:14px;color:#3d4a43">Resources</span>
      <h1 style="font-family:var(--hf);font-weight:400;font-size:clamp(42px,6vw,76px);line-height:1.05;margin:0">Move well, between visits</h1>
      <p style="font-size:19px;line-height:1.6;color:#5d6862;margin:0;max-width:600px">Short, practical reads from our physios — reviewed for accuracy and written for real life.</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
        {
          blogCats.map((c) => (
            <button type="button" class="h-pill-light" data-faq-filter={c} aria-pressed={String(c === 'All')} style="border:0;border-radius:999px;padding:10px 18px;cursor:pointer;font-size:15px">
              {c}
            </button>
          ))
        }
      </div>
    </section>
    <section style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,40px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:16px">
      {
        posts.map((po, i) => (
          <article data-faq-cat={po.cat} style="background:#fbfaf7;border-radius:28px;padding:14px 14px 26px;display:flex;flex-direction:column;gap:12px;position:relative">
            <Photo
              name={`health/post-${i + 1}`}
              alt={articles[po.title].imageAlt}
              label="article image"
              sizes="(min-width: 1240px) 380px, (min-width: 760px) 50vw, 100vw"
              style="aspect-ratio:16/10;border-radius:20px;background:repeating-linear-gradient(135deg,#dde2d6 0 1px,#e6e9e0 1px 12px);display:flex;align-items:flex-end;padding:14px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6d7a72"
            />
            <div style="display:flex;gap:10px;align-items:center;padding:0 10px;font-size:13px;color:#5d6862">
              <span style="background:#dfe4d8;border-radius:999px;padding:4px 12px;color:#3d4a43">{po.cat}</span>
              <span>{po.mins}</span>
            </div>
            <h2 style="font-family:var(--hf);font-weight:400;font-size:24px;line-height:1.2;margin:0;padding:0 10px">
              <a href={articleUrl(po.title)} class="h-card-link" style="text-decoration:none;color:inherit">{po.title}</a>
            </h2>
            <p style="margin:0;padding:0 10px;font-size:15px;color:#5d6862;line-height:1.5">{po.author}</p>
          </article>
        ))
      }
    </section>
  </div>
  {
    config.showSeoNotes && (
      <div style="text-align:center;padding-top:20px">
        <SeoNote>Article schema · named, qualified author on each post (E-E-A-T for health)</SeoNote>
      </div>
    )
  }
</Layout>
