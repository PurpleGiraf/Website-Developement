---
import Layout from '../../templates/health/Layout.astro';
import FaqItem from '../../templates/health/FaqItem.astro';
import SeoNote from '../../templates/health/SeoNote.astro';
import { config, routes } from '../../templates/health/config';
import { services, conditions, faqs } from '../../templates/health/data';
import { businessSchema } from '../../templates/health/schema';

const servicesTop = services.slice(0, 4);
const faqPreview = faqs.slice(0, 3);
---

<Layout
  page="home"
  title={`Physiotherapy in Norwood, Adelaide | ${config.brandName}`}
  description="Unhurried, hands-on physiotherapy and Clinical Pilates on The Parade, Norwood. No GP referral needed, with private health rebates claimed on the spot."
  jsonld={[businessSchema(Astro.site)]}
>
  <section style="max-width:1240px;margin:0 auto;padding:clamp(48px,8vw,112px) clamp(20px,4vw,40px) 48px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:26px">
    <span style="background:#dfe4d8;border-radius:999px;padding:8px 16px;font-size:14px;color:#3d4a43">Physiotherapy · Clinical Pilates · Norwood, Adelaide</span>
    <SeoNote>H1 · service + suburb keyword</SeoNote>
    <h1 style="font-family:var(--hf);font-weight:400;font-size:clamp(44px,6.4vw,84px);line-height:1.04;letter-spacing:-0.015em;margin:0;max-width:980px;text-wrap:balance">Physiotherapy in Norwood that helps you move without thinking about it</h1>
    <p style="font-size:19px;line-height:1.6;color:#5d6862;margin:0;max-width:600px;text-wrap:pretty">Unhurried, hands-on appointments with experienced physios. Private health rebates on the spot, and no GP referral needed.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
      <a href={routes.book} style="text-decoration:none;background:var(--accent);color:#fbfaf7;border-radius:999px;padding:17px 30px;font-size:16px;font-weight:500">Book an appointment</a>
      <a href={routes.services} style="text-decoration:none;background:#fbfaf7;color:#26302b;border-radius:999px;padding:17px 30px;font-size:16px">What we treat</a>
    </div>
  </section>
  <section style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,40px)">
    <div style="aspect-ratio:16/7;border-radius:32px;background:repeating-linear-gradient(135deg,#dde2d6 0 1px,#e6e9e0 1px 12px);display:flex;align-items:flex-end;padding:20px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6d7a72">wide photo — light-filled treatment room</div>
  </section>
  <section style="max-width:1240px;margin:0 auto;padding:28px clamp(20px,4vw,40px) 0;display:flex;flex-wrap:wrap;gap:10px 28px;justify-content:center;font-size:14px;color:#5d6862">
    <span>HICAPS on site</span><span>·</span><span>Medicare GP plans</span><span>·</span><span>NDIS &amp; DVA</span><span>·</span><span>ReturnToWorkSA</span>
  </section>

  <section style="max-width:1240px;margin:0 auto;padding:clamp(72px,10vw,128px) clamp(20px,4vw,40px) 0">
    <div style="text-align:center;margin-bottom:48px;display:flex;flex-direction:column;gap:14px;align-items:center">
      <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(34px,4.4vw,54px);line-height:1.08;margin:0">How we can help</h2>
      <p style="margin:0;font-size:17px;color:#5d6862;max-width:520px">Treatment plans built around what you want to get back to.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:16px">
      {
        servicesTop.map((sv) => (
          <a href={routes.detail} class="h-hover-sage" style="text-decoration:none;background:#fbfaf7;border-radius:24px;padding:28px;text-align:left;color:#26302b;display:flex;flex-direction:column;gap:12px;min-height:240px">
            <span style="width:44px;height:44px;border-radius:50%;background:#dfe4d8;display:flex;align-items:center;justify-content:center;font-size:14px;color:#3d4a43">{sv.num}</span>
            <span style="font-family:var(--hf);font-size:26px;margin-top:auto">{sv.name}</span>
            <span style="font-size:15px;line-height:1.55;color:#5d6862">{sv.blurb}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section style="max-width:1240px;margin:0 auto;padding:clamp(72px,10vw,128px) clamp(20px,4vw,40px) 0">
    <div style="background:#dfe4d8;border-radius:32px;padding:clamp(32px,6vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px;align-items:center">
      <div style="display:flex;flex-direction:column;gap:18px">
        <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(32px,4vw,50px);line-height:1.08;margin:0">Conditions we see every week</h2>
        <p style="margin:0;font-size:17px;line-height:1.6;color:#3d4a43">Not sure if physio is right for you? If it’s on this list — or anything like it — we can help, or we’ll point you to someone who can.</p>
      </div>
      <ul style="display:flex;flex-wrap:wrap;gap:10px;list-style:none;margin:0;padding:0">
        {conditions.map((c) => <li style="background:#fbfaf7;border-radius:999px;padding:10px 18px;font-size:15px">{c}</li>)}
      </ul>
    </div>
  </section>

  <section style="max-width:1240px;margin:0 auto;padding:clamp(72px,10vw,128px) clamp(20px,4vw,40px) 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:56px;align-items:center">
    <div style="aspect-ratio:1/1;border-radius:50%;background:repeating-linear-gradient(135deg,#dde2d6 0 1px,#e6e9e0 1px 12px);display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6d7a72;max-width:480px;width:100%;justify-self:center">portrait — lead physio</div>
    <figure style="display:flex;flex-direction:column;gap:22px;margin:0">
      <blockquote style="margin:0"><p style="font-family:var(--hf);font-size:clamp(26px,3.2vw,38px);line-height:1.3;margin:0;text-wrap:pretty">“After two years of on-and-off back pain, Hannah explained what was actually going on — and gave me a plan I could stick to. I’m back running the Parklands loop.”</p></blockquote>
      <figcaption style="font-size:15px;color:#5d6862">Daniel K., Kensington — lower back rehab</figcaption>
    </figure>
  </section>

  <section style="max-width:860px;margin:0 auto;padding:clamp(72px,10vw,128px) clamp(20px,4vw,40px) 0;display:flex;flex-direction:column;gap:12px">
    <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(32px,4vw,50px);margin:0 0 20px;text-align:center">Before your first visit</h2>
    {faqPreview.map((f) => <FaqItem q={f.q} a={f.a} />)}
    <a href={routes.faq} style="text-decoration:none;align-self:center;margin-top:16px;color:var(--accent);font-size:16px;font-weight:500">All questions →</a>
  </section>
</Layout>
