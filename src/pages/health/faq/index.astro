---
import Layout from '../../../templates/health/Layout.astro';
import FaqItem from '../../../templates/health/FaqItem.astro';
import SeoNote from '../../../templates/health/SeoNote.astro';
import { config, routes } from '../../../templates/health/config';
import { faqs, faqCats } from '../../../templates/health/data';
import { breadcrumbSchema, faqSchema } from '../../../templates/health/schema';
---

<Layout
  page="faq"
  title={`Physio FAQs: referrals, fees and first visits | ${config.brandName}`}
  description="Answers on referrals, health fund rebates, Medicare GP plans, cancellations and what to expect at your first physio appointment in Norwood."
  jsonld={[breadcrumbSchema([{ name: 'Home', path: routes.home }, { name: 'FAQ', path: routes.faq }], Astro.site), faqSchema(faqs)]}
>
  <div data-faq-root>
    <section style="max-width:1240px;margin:0 auto;padding:clamp(48px,8vw,104px) clamp(20px,4vw,40px) 40px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px">
      <span style="background:#dfe4d8;border-radius:999px;padding:8px 16px;font-size:14px;color:#3d4a43">FAQ</span>
      <h1 style="font-family:var(--hf);font-weight:400;font-size:clamp(42px,6vw,76px);line-height:1.05;margin:0">Good questions</h1>
      <SeoNote>FAQPage schema · grouped by intent</SeoNote>
      <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
        {
          faqCats.map((c) => (
            <button type="button" class="h-pill-light" data-faq-filter={c} aria-pressed={String(c === 'All')} style="border:0;border-radius:999px;padding:10px 18px;cursor:pointer;font-size:15px">
              {c}
            </button>
          ))
        }
      </div>
    </section>
    <section style="max-width:860px;margin:0 auto;padding:0 clamp(20px,4vw,40px);display:flex;flex-direction:column;gap:12px">
      {faqs.map((f) => <FaqItem q={f.q} a={f.a} cat={f.cat} heading />)}
    </section>
  </div>
</Layout>
