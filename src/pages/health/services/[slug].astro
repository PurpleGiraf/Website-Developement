---
import Layout from '../../../templates/health/Layout.astro';
import FaqItem from '../../../templates/health/FaqItem.astro';
import SeoNote from '../../../templates/health/SeoNote.astro';
import Photo from '../../../components/Photo.astro';
import { config, routes } from '../../../templates/health/config';
import { services } from '../../../templates/health/data';
import { serviceDetails, serviceUrl, type ServiceDetail } from '../../../templates/health/services';
import { breadcrumbSchema, faqSchema } from '../../../templates/health/schema';

export function getStaticPaths() {
  return services.map((sv) => ({ params: { slug: serviceDetails[sv.name].slug }, props: { sv: serviceDetails[sv.name] } }));
}

const { sv } = Astro.props as { sv: ServiceDetail };
const url = serviceUrl(sv.name);
const others = services.filter((o) => o.name !== sv.name).slice(0, 3);

const therapy = {
  '@context': 'https://schema.org',
  '@type': 'MedicalTherapy',
  name: sv.name,
  description: sv.intro,
  url: new URL(url, Astro.site).href,
  relevantSpecialty: 'Physiotherapy',
  provider: { '@id': new URL(routes.home, Astro.site).href + '#clinic' },
  offers: sv.fees
    .filter((f) => f.price.startsWith('$'))
    .map((f) => ({ '@type': 'Offer', name: f.name, price: f.price.replace('$', ''), priceCurrency: 'AUD' })),
};
---

<Layout
  page="detail"
  title={`${sv.metaTitle} | ${config.brandName}`}
  description={sv.metaDescription}
  jsonld={[
    breadcrumbSchema(
      [
        { name: 'Home', path: routes.home },
        { name: 'Services', path: routes.services },
        { name: sv.name, path: url },
      ],
      Astro.site,
    ),
    therapy,
    faqSchema(sv.faqs),
  ]}
>
  <section style="max-width:1240px;margin:0 auto;padding:clamp(32px,5vw,56px) clamp(20px,4vw,40px) 48px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:48px;align-items:center">
    <div style="display:flex;flex-direction:column;gap:22px">
      <nav aria-label="Breadcrumb" style="display:flex;gap:8px;font-size:14px;color:#5d6862;flex-wrap:wrap;align-items:center">
        <a href={routes.home} style="text-decoration:none;color:#5d6862">Home</a><span>›</span>
        <a href={routes.services} style="text-decoration:none;color:#5d6862">Services</a><span>›</span><span style="color:#26302b" aria-current="page">{sv.name}</span>
        <SeoNote>BreadcrumbList + MedicalTherapy schema</SeoNote>
      </nav>
      <h1 style="font-family:var(--hf);font-weight:400;font-size:clamp(42px,5.6vw,72px);line-height:1.05;margin:0">{sv.h1}</h1>
      <p style="font-size:19px;line-height:1.6;color:#5d6862;margin:0;text-wrap:pretty">{sv.intro}</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a href={routes.book} style="text-decoration:none;background:var(--accent);color:#fbfaf7;border-radius:999px;padding:16px 28px;font-size:16px;font-weight:500">{sv.cta}</a>
        <span style="background:#dfe4d8;border-radius:999px;padding:16px 22px;font-size:15px;color:#3d4a43">{sv.pill}</span>
      </div>
    </div>
    <Photo
      name={sv.image}
      alt={sv.imageAlt}
      label={sv.imageLabel}
      priority
      sizes="(min-width: 1240px) 580px, 100vw"
      style="aspect-ratio:4/5;border-radius:32px;background:repeating-linear-gradient(135deg,#dde2d6 0 1px,#e6e9e0 1px 12px);display:flex;align-items:flex-end;padding:20px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6d7a72"
    />
  </section>
  <section style="max-width:1240px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(20px,4vw,40px) 0">
    <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(30px,3.8vw,46px);margin:0 0 32px;text-align:center">{sv.whoTitle}</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:16px">
      {
        sv.whoFor.map((w) => (
          <div style="background:#fbfaf7;border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:10px">
            <h3 style="font-family:var(--hf);font-weight:400;font-size:23px;margin:0">{w.title}</h3>
            <p style="margin:0;font-size:15px;line-height:1.55;color:#5d6862">{w.body}</p>
          </div>
        ))
      }
    </div>
  </section>
  {
    sv.session && (
      <section style="max-width:1240px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(20px,4vw,40px) 0">
        <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(30px,3.8vw,46px);margin:0 0 32px;text-align:center">What to expect</h2>
        <ol style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:16px">
          {sv.session.map((st, i) => (
            <li style="border:1px solid #dde2d6;border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:10px">
              <span style="width:40px;height:40px;border-radius:50%;background:#dfe4d8;display:flex;align-items:center;justify-content:center;font-size:14px;color:#3d4a43">{String(i + 1).padStart(2, '0')}</span>
              <h3 style="font-family:var(--hf);font-weight:400;font-size:23px;margin:0">{st.title}</h3>
              <p style="margin:0;font-size:15px;line-height:1.55;color:#5d6862">{st.body}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }
  <section style="max-width:1240px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(20px,4vw,40px) 0">
    <div style="background:#dfe4d8;border-radius:32px;padding:clamp(28px,5vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px">
      {
        sv.fees.map((pf) => (
          <div style="background:#fbfaf7;border-radius:20px;padding:26px;display:flex;flex-direction:column;gap:8px">
            <span style="font-size:15px;color:#3d4a43">{pf.name}</span>
            <span style="font-family:var(--hf);font-size:40px;line-height:1">{pf.price}</span>
            <span style="font-size:14px;color:#5d6862">{pf.note}</span>
          </div>
        ))
      }
      {sv.feesNote && <p style="grid-column:1/-1;margin:4px 0 0;font-size:15px;line-height:1.55;color:#3d4a43;text-align:center">{sv.feesNote}</p>}
    </div>
  </section>
  <section style="max-width:860px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(20px,4vw,40px) 0;display:flex;flex-direction:column;gap:12px">
    <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(30px,3.8vw,46px);margin:0 0 8px;text-align:center">{sv.name} FAQs</h2>
    <SeoNote style="align-self:center;margin-bottom:12px">FAQPage schema · answer in first sentence</SeoNote>
    {sv.faqs.map((f) => <FaqItem q={f.q} a={f.a} />)}
  </section>
  <section style="max-width:1240px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(20px,4vw,40px) 0">
    <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(28px,3.4vw,40px);margin:0 0 28px;text-align:center">Other services</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:16px">
      {
        others.map((o) => (
          <a href={serviceUrl(o.name)} class="h-hover-sage" style="text-decoration:none;background:#fbfaf7;border-radius:24px;padding:28px;color:#26302b;display:flex;flex-direction:column;gap:10px">
            <span style="font-family:var(--hf);font-size:24px">{o.name}</span>
            <span style="font-size:15px;line-height:1.55;color:#5d6862">{o.blurb}</span>
            <span style="font-size:14px;color:var(--accent)">{o.from}</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
