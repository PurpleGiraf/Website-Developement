---
import Layout from '../../../../templates/health/Layout.astro';
import FaqItem from '../../../../templates/health/FaqItem.astro';
import SeoNote from '../../../../templates/health/SeoNote.astro';
import { config, routes } from '../../../../templates/health/config';
import { whoFor, pilatesFees, pilatesFaqs } from '../../../../templates/health/data';
import { breadcrumbSchema, faqSchema } from '../../../../templates/health/schema';

const therapy = {
  '@context': 'https://schema.org',
  '@type': 'MedicalTherapy',
  name: 'Clinical Pilates',
  description: 'Physio-led Pilates on reformers, in classes of no more than four. Every program starts with a one-on-one assessment.',
  url: new URL(routes.detail, Astro.site).href,
  relevantSpecialty: 'Physiotherapy',
  provider: { '@id': new URL(routes.home, Astro.site).href + '#clinic' },
  offers: pilatesFees.map((f) => ({ '@type': 'Offer', name: f.name, price: f.price.replace('$', ''), priceCurrency: 'AUD' })),
};
---

<Layout
  page="detail"
  title={`Clinical Pilates in Norwood | ${config.brandName}`}
  description="Physio-led Clinical Pilates on reformers in Norwood, Adelaide. Classes of four or fewer, a one-on-one assessment first, and health fund rebates."
  jsonld={[
    breadcrumbSchema(
      [
        { name: 'Home', path: routes.home },
        { name: 'Services', path: routes.services },
        { name: 'Clinical Pilates', path: routes.detail },
      ],
      Astro.site,
    ),
    therapy,
    faqSchema(pilatesFaqs),
  ]}
>
  <section style="max-width:1240px;margin:0 auto;padding:clamp(32px,5vw,56px) clamp(20px,4vw,40px) 48px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:48px;align-items:center">
    <div style="display:flex;flex-direction:column;gap:22px">
      <nav aria-label="Breadcrumb" style="display:flex;gap:8px;font-size:14px;color:#5d6862;flex-wrap:wrap;align-items:center">
        <a href={routes.home} style="text-decoration:none;color:#5d6862">Home</a><span>›</span>
        <a href={routes.services} style="text-decoration:none;color:#5d6862">Services</a><span>›</span><span style="color:#26302b" aria-current="page">Clinical Pilates</span>
        <SeoNote>BreadcrumbList + MedicalTherapy schema</SeoNote>
      </nav>
      <h1 style="font-family:var(--hf);font-weight:400;font-size:clamp(42px,5.6vw,72px);line-height:1.05;margin:0">Clinical Pilates in Norwood</h1>
      <p style="font-size:19px;line-height:1.6;color:#5d6862;margin:0;text-wrap:pretty">Physio-led Pilates on reformers, in classes of no more than four. Every program starts with a one-on-one assessment so the exercises match your body and your goals.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a href={routes.book} style="text-decoration:none;background:var(--accent);color:#fbfaf7;border-radius:999px;padding:16px 28px;font-size:16px;font-weight:500">Book an assessment</a>
        <span style="background:#dfe4d8;border-radius:999px;padding:16px 22px;font-size:15px;color:#3d4a43">Health fund rebates apply</span>
      </div>
    </div>
    <div style="aspect-ratio:4/5;border-radius:32px;background:repeating-linear-gradient(135deg,#dde2d6 0 1px,#e6e9e0 1px 12px);display:flex;align-items:flex-end;padding:20px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6d7a72">photo — physio guiding reformer exercise</div>
  </section>
  <section style="max-width:1240px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(20px,4vw,40px) 0">
    <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(30px,3.8vw,46px);margin:0 0 32px;text-align:center">Who it’s for</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:16px">
      {
        whoFor.map((w) => (
          <div style="background:#fbfaf7;border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:10px">
            <h3 style="font-family:var(--hf);font-weight:400;font-size:23px;margin:0">{w.title}</h3>
            <p style="margin:0;font-size:15px;line-height:1.55;color:#5d6862">{w.body}</p>
          </div>
        ))
      }
    </div>
  </section>
  <section style="max-width:1240px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(20px,4vw,40px) 0">
    <div style="background:#dfe4d8;border-radius:32px;padding:clamp(28px,5vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px">
      {
        pilatesFees.map((pf) => (
          <div style="background:#fbfaf7;border-radius:20px;padding:26px;display:flex;flex-direction:column;gap:8px">
            <span style="font-size:15px;color:#3d4a43">{pf.name}</span>
            <span style="font-family:var(--hf);font-size:40px;line-height:1">{pf.price}</span>
            <span style="font-size:14px;color:#5d6862">{pf.note}</span>
          </div>
        ))
      }
    </div>
  </section>
  <section style="max-width:860px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(20px,4vw,40px) 0;display:flex;flex-direction:column;gap:12px">
    <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(30px,3.8vw,46px);margin:0 0 8px;text-align:center">Clinical Pilates FAQs</h2>
    <SeoNote style="align-self:center;margin-bottom:12px">FAQPage schema · answer in first sentence</SeoNote>
    {pilatesFaqs.map((f) => <FaqItem q={f.q} a={f.a} />)}
  </section>
</Layout>
