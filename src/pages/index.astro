---
// Purple Giraffe Digital homepage (from "Homepage Digital" in the redesign proposal).
import { Image } from 'astro:assets';
import PgLayout from '../layouts/PgLayout.astro';
import PgFooter from '../components/PgFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import teamLaptop from '../assets/pg/team-laptop.jpg';
import teamFilm from '../assets/pg/team.png';

const PG = 'https://purplegiraffe.com.au';

const statement =
  "Google isn't the only place people are looking for answers anymore. Customers ask ChatGPT, Gemini and Perplexity too. We design and build the websites, products and campaigns that make sure your business is the answer.";

const services = [
  { num: '01', title: 'Website development', body: 'From a single landing page to a complete website or web application, planned, written, built and maintained to perform.', href: '/templates/' },
  { num: '02', title: 'Digital marketing', body: 'SEO, paid social, Google Ads, email and remarketing, integrated with your strategy and reported on quarterly.', href: `${PG}/digital-media-management/` },
  { num: '03', title: 'AI solutions', body: 'AI visibility across SEO, GEO and AEO, plus practical, human-focused AI tools and workflows that save your business time.', href: `${PG}/ai-visibility-review/` },
  { num: '04', title: 'UI/UX design', body: 'Interfaces and journeys designed around your customers, so every site and digital product is clear, accessible and easy to use.', href: `${PG}/case-studies/` },
];

const aiPillars = [
  { k: 'SEO', name: 'Search engine optimisation', body: 'The foundations that help search engines understand and rank your website.' },
  { k: 'GEO', name: 'Generative engine optimisation', body: 'How effectively your content supports your website visibility in generative AI results.' },
  { k: 'AEO', name: 'Answer engine optimisation', body: 'How well your website answers the questions your potential customers are asking.' },
];

const clients = ['Minge Funerals', 'Vitalis Legal', 'Adelaide Eye & Laser Centre', 'BusSA', 'Rent Busters Bunbury', 'Positive Response Dog Training', 'Langley & Co', 'Magain Real Estate', 'Cowie Environmental', 'Clarke Energy', "O'Neills Sportswear"];

const work = [
  { n: '01', sector: 'Email automation', client: 'Positive Response Dog Training', scope: 'Automated email sequence', date: 'Jul – Sep 2025', outcome: 'Over $135,000 in revenue from one automated sequence, after a 62% lift in open rates.', bg: '#f6f2ec', fg: '#2b1745', slug: 'positive-response-dog-training' },
  { n: '02', sector: 'Website & UX', client: 'Minge Funerals', scope: 'Website redesign', date: 'Nov 2024 – Aug 2025', outcome: 'A modern, functional website that reflects over 90 years of community service.', bg: '#b7a6cc', fg: '#2b1745', slug: 'minge-funerals' },
  { n: '03', sector: 'Paid social', client: 'Rent Busters Bunbury', scope: 'Meta Ads, technical fixes', date: 'Mar – Sep 2025', outcome: 'High-quality leads and renewed confidence in digital, through a structured Meta Ads campaign.', bg: '#3d2460', fg: '#f6f2ec', slug: 'rent-busters-bunbury' },
  { n: '04', sector: 'Digital product', client: 'Adelaide Eye & Laser Centre', scope: 'UI/UX, development', date: 'Aug 2020', outcome: 'An online eye suitability test, designed and launched for prospective patients.', bg: '#ebe4f1', fg: '#2b1745', slug: 'adelaide-eye-laser-centre' },
  { n: '05', sector: 'Brand & website', client: 'Vitalis Legal', scope: 'Identity, website, strategy', date: 'Jul 2024 – Feb 2025', outcome: 'A new identity and website, launched with a 10-year anniversary campaign.', bg: '#5a3a82', fg: '#f6f2ec', slug: 'vitalis-legal' },
  { n: '06', sector: 'Video & web', client: 'BusSA', scope: 'Video, brand, website', date: 'Feb 2024 – Jul 2026', outcome: 'Educational videos and a new website promoting bus safety to students.', bg: '#f6f2ec', fg: '#2b1745', slug: 'bussa' },
];

const awards = [
  { year: '2025', title: "Founder's Family Business Award", org: 'Family Business Excellence Awards' },
  { year: '2025', title: 'Runner-Up, Business & Professional Services', org: 'Fremantle Chamber of Commerce' },
  { year: '2023 & 2024', title: 'Finalist, Marketing Services', org: 'Australian Small Business Champion Awards' },
  { year: '2019', title: 'South Australian Finalist, Lynda Schenk', org: "Telstra Business Women's Awards" },
];

const posts = [
  { tag: 'AI & search', title: 'What are the 7 questions your content needs to answer to get found by AI?' },
  { tag: 'Search', title: "What's the difference between SEO, AEO and GEO?" },
  { tag: 'Content', title: 'Content marketing for your SME: a complete playbook' },
  { tag: 'Video', title: 'Reels that work: why short-form video should be in your marketing mix' },
];

const offices = [
  { label: 'Adelaide · Head office', lines: ['Suite 5 / 151 Gilles Street', 'Adelaide SA 5000'], phone: '08 8425 2970', tel: '0884252970', locality: 'Adelaide', region: 'SA', postcode: '5000', street: 'Suite 5 / 151 Gilles Street' },
  { label: 'Perth', lines: ['Fremantle WA 6160'], phone: '08 6263 9236', tel: '0862639236', locality: 'Fremantle', region: 'WA', postcode: '6160' },
  { label: 'Queensland', lines: ['Spring Hill QLD 4000'], phone: '07 3544 9535', tel: '0735449535', locality: 'Spring Hill', region: 'QLD', postcode: '4000' },
];

const filmUrl = 'https://player.vimeo.com/video/440920973?h=ee7874d5b4&autoplay=1';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Purple Giraffe',
  url: PG,
  email: 'marketing@purplegiraffe.com.au',
  description: 'Website development, digital marketing, AI solutions and UI/UX design from the digital team at Purple Giraffe.',
  foundingDate: '2014',
  founder: { '@type': 'Person', name: 'Lynda Schenk' },
  location: offices.map((o) => ({
    '@type': 'Place',
    name: `Purple Giraffe ${o.locality}`,
    telephone: o.phone,
    address: { '@type': 'PostalAddress', streetAddress: o.street, addressLocality: o.locality, addressRegion: o.region, postalCode: o.postcode, addressCountry: 'AU' },
  })),
};
---

<PgLayout title="Purple Giraffe Digital | Websites, digital marketing and AI visibility" description="Website development, digital marketing, AI solutions and UI/UX design from the digital team at Purple Giraffe, with offices in Adelaide, Perth and Brisbane." home>
  <JsonLd slot="head" data={schema} />

  <!-- Hero: sticky, photo opens to full-bleed on scroll -->
  <section data-hero style="position:relative;height:250vh">
    <div style="position:sticky;top:0;height:100vh;overflow:hidden">
      <div data-hero-text style="position:relative;z-index:2;max-width:1560px;margin:0 auto;padding:clamp(108px,15vh,150px) clamp(20px,4vw,56px) 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 48px;align-items:end;will-change:transform,opacity">
        <h1 style="margin:0;font-weight:200;font-size:clamp(58px,9.4vw,168px);line-height:0.92;letter-spacing:-0.055em;grid-column:1/-1">
          <span style="display:block;overflow:hidden;padding-bottom:0.2em;margin-bottom:-0.14em"><span class="pg-line" style="display:block;transition:transform 1.3s cubic-bezier(.19,1,.22,1)">Digital that</span></span>
          <span style="display:block;overflow:hidden;padding-bottom:0.2em;margin-bottom:-0.14em"><span class="pg-line" style="display:block;transition:transform 1.3s cubic-bezier(.19,1,.22,1) .12s">gets found<span style="color:#9a86b5">.</span></span></span>
        </h1>
        <p class="pg-fade" style="margin:0;font-size:clamp(17px,1.35vw,21px);line-height:1.5;font-weight:300;max-width:440px;transition:opacity 1.2s ease .5s">Website development, digital marketing, AI solutions and UI/UX design, from the digital team at Purple Giraffe.</p>
        <div class="pg-fade" style="display:flex;justify-content:flex-end;align-items:center;gap:14px;font-size:14px;letter-spacing:0.12em;text-transform:uppercase;transition:opacity 1.2s ease .7s">
          <span>Purple Giraffe Digital</span><span style="width:48px;height:1px;background:#2b1745"></span><span>Adelaide · Perth · Brisbane</span>
        </div>
      </div>
      <div data-hero-photo style="position:absolute;inset:0;z-index:1;clip-path:inset(62vh 4vw 3vh 4vw round 20px);will-change:clip-path">
        <Image data-hero-img src={teamLaptop} alt="The Purple Giraffe digital team reviewing a website" widths={[800, 1200, 1600, 2048]} sizes="100vw" loading="eager" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;object-position:50% 28%;display:block;transform:scale(1.12);will-change:transform" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(43,23,69,0) 50%,rgba(43,23,69,0.65) 100%);pointer-events:none"></div>
        <div data-hero-caption style="position:absolute;left:0;right:0;bottom:0;padding:0 clamp(20px,4vw,56px) clamp(28px,5vh,56px);display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:20px;color:#f6f2ec;opacity:0">
          <span style="font-weight:200;font-size:clamp(34px,4.6vw,76px);line-height:1;letter-spacing:-0.045em;max-width:900px">Developers, designers and digital marketers. One team, on your side.</span>
          <a href="#people" style="font-size:14px;letter-spacing:0.12em;text-transform:uppercase;border-bottom:1px solid rgba(246,242,236,0.6);padding-bottom:4px;color:#f6f2ec">Meet the people</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Statement: words fill on scroll -->
  <section data-fill style="max-width:1560px;margin:0 auto;padding:clamp(120px,22vh,240px) clamp(20px,4vw,56px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:40px">
      <span style="font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#7d6a96;padding-top:14px">Search is changing</span>
      <p class="pg-span3" style="min-width:0;margin:0;font-weight:300;font-size:clamp(30px,3.7vw,62px);line-height:1.14;letter-spacing:-0.035em;text-wrap:pretty">
        {statement.split(' ').map((w) => <span data-w style="color:#2b1745;transition:color .35s">{w} </span>)}
      </p>
    </div>
  </section>

  <!-- Services -->
  <section id="services" style="max-width:1560px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(120px,18vh,200px)">
    <div data-reveal style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:16px;padding-bottom:28px">
      <h2 style="margin:0;font-weight:200;font-size:clamp(44px,5.6vw,96px);line-height:1;letter-spacing:-0.05em">What we do</h2>
      <span style="font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#7d6a96">Four disciplines, one strategy</span>
    </div>
    <div style="border-top:1px solid #2b1745">
      {
        services.map((s) => (
          <a href={s.href} data-reveal class="pg-service" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px 48px;align-items:center;padding:clamp(28px,4vh,44px) clamp(0px,1.4vw,24px);border-bottom:1px solid #cfc4dc">
            <span style="display:flex;align-items:baseline;gap:clamp(16px,3vw,48px)">
              <span style="font-size:14px;letter-spacing:0.1em;opacity:0.55">{s.num}</span>
              <span style="font-weight:300;font-size:clamp(32px,3.6vw,60px);line-height:1.02;letter-spacing:-0.045em">{s.title}</span>
            </span>
            <span style="display:flex;align-items:center;justify-content:space-between;gap:32px">
              <span style="font-size:17px;line-height:1.55;font-weight:300;max-width:480px;opacity:0.85">{s.body}</span>
              <span aria-hidden="true" style="font-size:28px;font-weight:200">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- AI Visibility Review offer -->
  <section id="ai-review" style="padding:0 clamp(20px,4vw,56px) clamp(120px,18vh,200px)">
    <div data-reveal style="max-width:1560px;margin:0 auto;background:#ebe4f1;border-radius:24px;padding:clamp(36px,6vw,96px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:56px clamp(40px,6vw,96px)">
      <div style="display:flex;flex-direction:column;gap:28px;justify-content:space-between">
        <span style="font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#7d6a96">AI Visibility Review</span>
        <h2 style="margin:0;font-weight:200;font-size:clamp(44px,5.6vw,96px);line-height:0.96;letter-spacing:-0.05em">Can AI find your business?</h2>
        <p style="margin:0;font-size:18px;line-height:1.6;font-weight:300;max-width:480px;color:#4a3762">Customers are increasingly turning to tools like ChatGPT, Gemini and Perplexity to research businesses, compare options and make decisions. Our review shows where you stand, and what to do next.</p>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:20px 32px">
          <a href={`${PG}/ai-visibility-review/`} class="pg-solid" style="background:#2b1745;color:#f6f2ec;padding:18px 28px;border-radius:999px;font-size:16px">Get my AI Visibility Review</a>
          <span style="display:flex;flex-direction:column;gap:2px"><span style="font-size:26px;font-weight:300;letter-spacing:-0.03em">$495 + GST</span><span style="font-size:14px;color:#7d6a96">Limited time. Normally $995</span></span>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;border-top:1px solid #2b1745">
        {
          aiPillars.map((a) => (
            <div style="display:grid;grid-template-columns:minmax(80px,140px) minmax(0,1fr);gap:24px;align-items:baseline;padding:32px 0;border-bottom:1px solid #cfc4dc">
              <span style="font-weight:200;font-size:clamp(44px,4.4vw,72px);line-height:1;letter-spacing:-0.05em">{a.k}</span>
              <span style="display:flex;flex-direction:column;gap:6px">
                <span style="font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:#7d6a96">{a.name}</span>
                <span style="font-size:17px;line-height:1.5;font-weight:300">{a.body}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Clients marquee -->
  <section aria-label="Clients" style="background:#2b1745;color:#f6f2ec;padding:clamp(72px,11vh,120px) 0;overflow:hidden">
    <div style="max-width:1560px;margin:0 auto clamp(40px,6vh,64px);padding:0 clamp(20px,4vw,56px);display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#b7a6cc">
      <span>Digital work for</span><a href={`${PG}/our-clients/`} style="color:#f6f2ec">All clients →</a>
    </div>
    <div data-marquee style="display:flex;width:max-content;will-change:transform">
      {
        [...clients, ...clients].map((c, i) => (
          <span aria-hidden={i >= clients.length ? 'true' : undefined} style="display:flex;align-items:center;gap:clamp(32px,4vw,64px);padding-right:clamp(32px,4vw,64px);font-weight:200;font-size:clamp(44px,6.4vw,112px);letter-spacing:-0.05em;white-space:nowrap;line-height:1.1">
            {c}
            <span style="width:14px;height:14px;border-radius:50%;background:#9a86b5;flex:none" />
          </span>
        ))
      }
    </div>
  </section>

  <!-- Work: pinned horizontal scroll -->
  <section id="work" data-hz style="position:relative;background:#2b1745;color:#f6f2ec;height:300vh">
    <div style="position:sticky;top:0;height:100vh;overflow:hidden;display:flex;align-items:center">
      <div data-hz-track style="display:flex;gap:20px;padding:72px clamp(20px,4vw,56px) 24px;will-change:transform;align-items:stretch;height:max(min(100vh,560px),min(82vh,760px))">
        <div style="flex:none;width:min(520px,82vw);display:flex;flex-direction:column;justify-content:space-between;padding-right:40px">
          <span style="font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#b7a6cc">Selected digital work</span>
          <div style="display:flex;flex-direction:column;gap:28px">
            <h2 style="margin:0;font-weight:200;font-size:clamp(48px,5.6vw,96px);line-height:0.96;letter-spacing:-0.05em">The work, and what it did.</h2>
            <p style="margin:0;font-size:18px;line-height:1.55;font-weight:300;color:#d8cee6;max-width:400px">Websites, digital products and campaigns for businesses across Australia.</p>
          </div>
          <span style="display:flex;align-items:center;gap:14px;font-size:14px;letter-spacing:0.12em;text-transform:uppercase;color:#b7a6cc"><span style="width:48px;height:1px;background:#b7a6cc" />Keep scrolling</span>
        </div>
        {
          work.map((w) => (
            <a href={`${PG}/case_studies/${w.slug}/`} class="pg-lift" style={`flex:none;width:min(480px,82vw);border-radius:20px;padding:clamp(28px,3vw,44px);display:flex;flex-direction:column;justify-content:space-between;gap:24px;background:${w.bg};color:${w.fg}`}>
              <div style="display:flex;justify-content:space-between;gap:16px;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;opacity:0.7">
                <span>{w.sector}</span>
                <span>{w.n}</span>
              </div>
              <div style="display:flex;flex-direction:column;gap:24px">
                <span style="font-weight:200;font-size:clamp(28px,min(3.2vw,5.2vh),50px);line-height:1.06;letter-spacing:-0.04em;text-wrap:pretty">{w.outcome}</span>
              </div>
              <div style="display:flex;flex-direction:column;gap:14px;padding-top:24px;border-top:1px solid currentColor">
                <span style="font-weight:300;font-size:clamp(26px,2.2vw,34px);letter-spacing:-0.035em;line-height:1.05">{w.client}</span>
                <span style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px 16px;font-size:15px;font-weight:300;opacity:0.75">
                  <span>{w.scope}</span>
                  <span>{w.date}</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section style="max-width:1560px;margin:0 auto;padding:clamp(120px,22vh,240px) clamp(20px,4vw,56px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:40px">
      <span style="font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#7d6a96;padding-top:18px">In their words</span>
      <figure data-reveal class="pg-span3" style="min-width:0;margin:0;display:flex;flex-direction:column;gap:48px">
        <blockquote style="margin:0;font-weight:200;font-size:clamp(36px,4.6vw,80px);line-height:1.04;letter-spacing:-0.045em;text-wrap:balance">“Purple Giraffe have contributed enormously towards our business and brand. Whether it's smaller tasks such as creating marketing material or larger projects…”</blockquote>
        <figcaption style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px">
          <div style="display:flex;flex-direction:column;gap:4px"><span style="font-size:18px;font-weight:400">Martin Rohde</span><span style="font-size:15px;font-weight:300;color:#7d6a96">Rohde's Free Range Eggs</span></div>
          <a href={`${PG}/case_studies/rohdes-free-range-eggs/`} style="font-size:14px;letter-spacing:0.12em;text-transform:uppercase;border-bottom:1px solid #2b1745;padding-bottom:4px">Read the case study</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- People / film -->
  <section id="people" style="padding:0 clamp(20px,4vw,56px) clamp(120px,18vh,200px)">
    <div style="max-width:1560px;margin:0 auto;display:flex;flex-direction:column;gap:clamp(32px,5vh,56px)">
      <div data-reveal style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:24px 48px;align-items:end">
        <h2 style="margin:0;font-weight:200;font-size:clamp(44px,5.6vw,96px);line-height:0.98;letter-spacing:-0.05em">Who we are, and why we do it</h2>
        <p style="margin:0;font-size:18px;line-height:1.6;font-weight:300;max-width:480px;justify-self:end">Our digital team sits inside Purple Giraffe, the marketing consultancy founded by Lynda Schenk in 2014 that now supports more than 150 businesses nationally and internationally. Every website, product and campaign starts with strategy.</p>
      </div>
      <div data-reveal style="position:relative;aspect-ratio:16/8;min-height:320px;border-radius:20px;overflow:hidden;background:#2b1745">
        <Image src={teamFilm} alt="The Purple Giraffe team" widths={[800, 1200, 1835]} sizes="(min-width: 1560px) 1450px, 100vw" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block" />
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(43,23,69,0.25)">
          <button type="button" data-film-open class="pg-play" style="width:clamp(110px,11vw,160px);aspect-ratio:1;border-radius:50%;border:0;cursor:pointer;background:#f6f2ec;color:#2b1745;display:flex;align-items:center;justify-content:center;font:inherit;font-size:15px;letter-spacing:0.14em;text-transform:uppercase">Play film</button>
        </div>
      </div>
    </div>
    <dialog data-film style="padding:0;border:0;border-radius:16px;background:#000;width:min(1200px,92vw);aspect-ratio:16/9;overflow:hidden">
      <form method="dialog" style="position:absolute;top:10px;right:10px;z-index:2;margin:0">
        <button aria-label="Close film" style="width:44px;height:44px;border-radius:50%;border:0;background:#f6f2ec;color:#2b1745;font-size:20px;cursor:pointer">✕</button>
      </form>
      <iframe data-film-frame data-src={filmUrl} title="Purple Giraffe brand film" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen style="width:100%;height:100%;border:0;display:block"></iframe>
    </dialog>
  </section>

  <!-- Awards -->
  <section aria-label="Awards" style="max-width:1560px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(120px,18vh,200px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));border-top:1px solid #2b1745">
      {
        awards.map((a) => (
          <a href={`${PG}/awards/`} data-reveal style="display:flex;flex-direction:column;gap:10px;padding:28px 24px 0 0">
            <span style="font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:#7d6a96">{a.year}</span>
            <span style="font-size:20px;font-weight:300;line-height:1.3;letter-spacing:-0.02em">{a.title}</span>
            <span style="font-size:15px;font-weight:300;color:#7d6a96">{a.org}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Journal -->
  <section id="journal" style="max-width:1560px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(120px,18vh,200px)">
    <div data-reveal style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:16px;padding-bottom:28px">
      <h2 style="margin:0;font-weight:200;font-size:clamp(44px,5.6vw,96px);line-height:1;letter-spacing:-0.05em">Journal</h2>
      <a href={`${PG}/resources/`} style="font-size:14px;letter-spacing:0.12em;text-transform:uppercase;border-bottom:1px solid #2b1745;padding-bottom:4px">All articles</a>
    </div>
    <div style="border-top:1px solid #2b1745">
      {
        posts.map((p) => (
          <a href={`${PG}/resources/`} data-reveal class="pg-post" style="display:grid;grid-template-columns:minmax(120px,1fr) minmax(0,3fr) auto;gap:24px;align-items:baseline;padding:28px 0;border-bottom:1px solid #cfc4dc">
            <span style="font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:#7d6a96">{p.tag}</span>
            <span style="font-weight:300;font-size:clamp(22px,2.2vw,36px);line-height:1.15;letter-spacing:-0.03em">{p.title}</span>
            <span aria-hidden="true" style="font-size:24px;font-weight:200">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Contact + footer -->
  <section id="contact" style="background:#2b1745;color:#f6f2ec;padding:clamp(120px,20vh,220px) clamp(20px,4vw,56px) 40px">
    <div style="max-width:1560px;margin:0 auto;display:flex;flex-direction:column;gap:clamp(96px,16vh,160px)">
      <div data-reveal style="display:flex;flex-direction:column;gap:48px">
        <span style="font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#b7a6cc">Have a project in mind?</span>
        <a href={`${PG}/contact/`} class="pg-big-link" style="font-weight:200;font-size:clamp(64px,11vw,200px);line-height:0.88;letter-spacing:-0.06em;color:#f6f2ec;display:flex;align-items:flex-end;flex-wrap:wrap;gap:0 0.25em">Let's build it<span aria-hidden="true" style="font-size:0.6em;line-height:1.1">→</span></a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:40px;font-size:16px;line-height:1.65;font-weight:300">
        {
          offices.map((o) => (
            <div style="display:flex;flex-direction:column;gap:4px">
              <span style="font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#b7a6cc;margin-bottom:10px">{o.label}</span>
              <span set:html={o.lines.join('<br>')} />
              <a href={`tel:${o.tel}`} style="color:#f6f2ec">{o.phone}</a>
            </div>
          ))
        }
        <div data-form-wrap style="display:flex;flex-direction:column;gap:14px">
          <label for="pg-subscribe" style="font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#b7a6cc">Subscribe to purple news</label>
          <form data-form style="display:flex;border-bottom:1px solid #b7a6cc;margin:0">
            <input id="pg-subscribe" name="email" type="email" required placeholder="Your email" autocomplete="email" style="flex:1;min-width:0;background:transparent;border:0;outline:none;color:#f6f2ec;font:inherit;font-size:16px;padding:10px 0" />
            <button aria-label="Subscribe" style="background:none;border:0;color:#f6f2ec;font:inherit;font-size:22px;cursor:pointer;min-width:44px">→</button>
          </form>
          <span data-form-success hidden style="font-size:16px">Thanks, you're on the list.</span>
        </div>
      </div>
      <PgFooter />
    </div>
  </section>
</PgLayout>

<style is:global>
  .pg-span3{grid-column:span 3}
  @media (max-width: 1100px){.pg-span3{grid-column:1/-1}}
  .pg-service{transition:background .5s cubic-bezier(.19,1,.22,1),color .5s,padding .5s cubic-bezier(.19,1,.22,1)}
  .pg-service:hover{background:#2b1745;color:#f6f2ec;padding-left:clamp(16px,3vw,48px)}
  .pg-lift{transition:transform .6s cubic-bezier(.19,1,.22,1)}
  .pg-lift:hover{transform:translateY(-10px)}
  .pg-post{transition:padding .5s cubic-bezier(.19,1,.22,1),color .3s}
  .pg-post:hover{padding-left:20px;color:#7d5aa6}
  .pg-play{transition:transform .6s cubic-bezier(.19,1,.22,1)}
  .pg-play:hover{transform:scale(1.12)}
  dialog[data-film]::backdrop{background:rgba(23,12,38,0.85)}
</style>

