---
// Template gallery: entry point linking to each industry template.
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Website templates</title>
    <meta name="description" content="Three industry website templates: trades and home services, health and allied health, and professional services. Each has eight pages." />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono&family=Instrument+Serif&family=Lora&display=swap" rel="stylesheet" />
    <style is:global>*{box-sizing:border-box}body{margin:0;background:#f4f3ef;color:#1a1a18;font-family:'Geist',sans-serif}a{color:#1a1a18;text-decoration:none}a:hover{color:#1a1a18}</style>
  </head>
  <body>
    <div style="max-width:1320px;margin:0 auto;padding:clamp(40px,6vw,88px) clamp(20px,4vw,48px);display:flex;flex-direction:column;gap:48px">
    <div style="display:flex;flex-direction:column;gap:16px;max-width:760px">
    <span style="font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:#6b6b66">Website templates · 3 industries · 8 pages each</span>
    <h1 style="font-weight:500;font-size:clamp(40px,5.5vw,72px);line-height:1;letter-spacing:-0.03em;margin:0">Website templates</h1>
    <p style="margin:0;font-size:18px;line-height:1.55;color:#4a4a46">Each one has Home, About, Services, Service detail, Blog, FAQ, Booking/Quote and Contact pages. Brand name, accent colour and heading font are set in each template's <code>config.ts</code>. You can also switch on SEO annotations there to show the schema and keyword structure.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:20px">
    <a href="/trades/" style="background:#f3eee6;border:1px solid #ddd3c5;display:flex;flex-direction:column;min-height:440px">
    <div style="flex:1;padding:32px;display:flex;flex-direction:column;justify-content:flex-end;gap:12px;background:repeating-linear-gradient(135deg,#e9e1d4 0 1px,#f3eee6 1px 12px)">
    <span style="font-family:'Instrument Serif',serif;font-size:52px;line-height:0.95;color:#2b2520">Ashgrove</span>
    <span style="display:flex;gap:6px"><span style="width:28px;height:28px;background:#9a5b34"></span><span style="width:28px;height:28px;background:#2b2520"></span><span style="width:28px;height:28px;background:#e9e1d4;border:1px solid #cfc3b2"></span></span>
    </div>
    <div style="padding:24px 32px;border-top:1px solid #ddd3c5;display:flex;flex-direction:column;gap:6px;background:#faf7f2">
    <span style="font-family:'Geist Mono',monospace;font-size:11px;color:#6b6157">01 — TRADES &amp; HOME SERVICES</span>
    <span style="font-size:18px;font-weight:500;color:#2b2520">Premium craftsman · editorial serif, warm neutrals</span>
    <span style="font-size:14px;color:#6b6157">Builders, joiners, landscapers, electricians, plumbers</span>
    </div>
    </a>
    <a href="/health/" style="background:#f4f2ec;border-radius:28px;display:flex;flex-direction:column;min-height:440px;overflow:hidden">
    <div style="flex:1;padding:32px;display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start;gap:12px;background:#dfe4d8">
    <span style="font-family:'Lora',serif;font-size:46px;line-height:1;color:#26302b">Saltbush Physio</span>
    <span style="display:flex;gap:6px"><span style="width:28px;height:28px;border-radius:50%;background:#4f6f5a"></span><span style="width:28px;height:28px;border-radius:50%;background:#26302b"></span><span style="width:28px;height:28px;border-radius:50%;background:#fbfaf7"></span></span>
    </div>
    <div style="padding:24px 32px;display:flex;flex-direction:column;gap:6px;background:#fbfaf7">
    <span style="font-family:'Geist Mono',monospace;font-size:11px;color:#5d6862">02 — HEALTH &amp; ALLIED HEALTH</span>
    <span style="font-size:18px;font-weight:500;color:#26302b">Calm &amp; soft · rounded, airy, sage and sand</span>
    <span style="font-size:14px;color:#5d6862">Physio, chiro, psychology, dental, podiatry, GP clinics</span>
    </div>
    </a>
    <a href="/professional/" style="background:#f5f5f2;border:1px solid #111;display:flex;flex-direction:column;min-height:440px">
    <div style="flex:1;padding:32px;display:flex;flex-direction:column;justify-content:flex-end;gap:12px">
    <span style="font-size:52px;font-weight:500;line-height:0.92;letter-spacing:-0.045em;color:#111">Haddon Lowe</span>
    <span style="display:flex;gap:6px"><span style="width:28px;height:28px;background:#e2492f"></span><span style="width:28px;height:28px;background:#111"></span><span style="width:28px;height:28px;background:#f5f5f2;border:1px solid #111"></span></span>
    </div>
    <div style="padding:24px 32px;border-top:1px solid #111;display:flex;flex-direction:column;gap:6px">
    <span style="font-family:'Geist Mono',monospace;font-size:11px;color:#6b6b6b">03 — PROFESSIONAL SERVICES</span>
    <span style="font-size:18px;font-weight:500;color:#111">Modern minimal · Swiss grid, mono + one accent</span>
    <span style="font-size:14px;color:#6b6b6b">Accountants, lawyers, financial planners, consultants</span>
    </div>
    </a>
    </div>
    </div>
  </body>
</html>
