---
import Layout from '../../templates/trades/Layout.astro';
import { config } from '../../templates/trades/config';
import { typeList, nextSteps } from '../../templates/trades/data';

const lbl = 'display:flex;flex-direction:column;gap:8px;font-size:14px;font-weight:600';
const field = 'padding:14px;border:1px solid #cfc3b2;background:#fff;font-size:16px;font-weight:400';
---

<Layout
  page="quote"
  title={`Request a Renovation Quote in Brisbane | ${config.brandName}`}
  description="Tell us about your kitchen, bathroom, joinery or extension project. We reply within one business day to book a free site visit and a fixed-price quote."
>
  <section style="max-width:1320px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,56px) clamp(64px,9vw,120px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:64px;align-items:start">
    <div style="display:flex;flex-direction:column;gap:24px">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;color:#6b6157;text-transform:uppercase">Request a quote</div>
      <h1 style="font-family:var(--hf);font-weight:400;font-size:clamp(44px,6vw,80px);line-height:1;letter-spacing:-0.02em;margin:0">Tell us about your project</h1>
      <p style="font-size:18px;line-height:1.6;color:#4d443b;margin:0">The more you share, the more useful our first conversation will be. We reply within one business day.</p>
      <ol style="list-style:none;padding:0;display:flex;flex-direction:column;gap:0;margin:12px 0 0">
        {
          nextSteps.map((ns) => (
            <li style="border-top:1px solid #cfc3b2;padding:18px 0;display:grid;grid-template-columns:40px 1fr;gap:12px">
              <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#6b6157">{ns.num}</span>
              <div><div style="font-size:17px;font-weight:500;margin-bottom:4px">{ns.title}</div><div style="font-size:15px;color:#4d443b;line-height:1.5">{ns.body}</div></div>
            </li>
          ))
        }
      </ol>
    </div>
    <div data-form-wrap style="background:#faf7f2;padding:clamp(24px,4vw,48px);border:1px solid #ddd3c5">
      <div data-form-success hidden role="status" style="display:flex;flex-direction:column;gap:16px;padding:40px 0">
        <h2 style="font-family:var(--hf);font-weight:400;font-size:44px;margin:0">Thanks — we’ve got it.</h2>
        <p style="margin:0;font-size:17px;line-height:1.6;color:#4d443b">Priya will call you within one business day to book a site visit.</p>
        <button type="button" data-form-reset style="align-self:flex-start;background:none;border:0;border-bottom:1px solid #2b2520;padding:4px 0;cursor:pointer;color:#2b2520">Send another request</button>
      </div>
      <form data-form method="post" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:22px">
        <div data-chips style="display:flex;flex-direction:column;gap:10px">
          <span id="project-type-label" style="font-size:14px;font-weight:600">Project type</span>
          <input type="hidden" name="project_type" value={typeList[0]} data-chip-input />
          <div role="group" aria-labelledby="project-type-label" style="display:flex;gap:8px;flex-wrap:wrap">
            {
              typeList.map((t, i) => (
                <button type="button" class="t-chip" data-chip value={t} aria-pressed={i === 0 ? 'true' : 'false'} style="border:1px solid #2b2520;padding:9px 14px;cursor:pointer;font-size:14px">{t}</button>
              ))
            }
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:16px">
          <label style={lbl}>Full name<input name="name" autocomplete="name" required style={field} /></label>
          <label style={lbl}>Phone<input name="phone" type="tel" autocomplete="tel" style={field} /></label>
          <label style={lbl}>Email<input name="email" type="email" autocomplete="email" required style={field} /></label>
          <label style={lbl}>Suburb<input name="suburb" placeholder="e.g. Paddington" style={field} /></label>
          <label style={lbl}>Budget<select name="budget" style={field}><option>Under $30k</option><option>$30k – $60k</option><option>$60k – $120k</option><option>$120k+</option><option>Not sure yet</option></select></label>
          <label style={lbl}>Ideal start<select name="start" style={field}><option>Within 3 months</option><option>3–6 months</option><option>6–12 months</option><option>Just planning</option></select></label>
        </div>
        <label style={lbl}>Tell us about the project<textarea name="details" rows="5" placeholder="What you’d like to change, the age of the home, any plans or inspiration…" style={`${field};resize:vertical`}></textarea></label>
        <label style="border:1px dashed #b8ab99;padding:20px;font-size:14px;color:#6b6157;text-align:center;cursor:pointer;display:block">
          Drop photos or plans here (optional)
          <input type="file" name="files" multiple accept="image/*,.pdf" style="display:block;margin:12px auto 0;font-size:13px;max-width:100%" />
        </label>
        <button type="submit" style="background:var(--accent);color:#faf7f2;border:0;padding:18px;cursor:pointer;font-size:16px;font-weight:600">Send my request</button>
      </form>
    </div>
  </section>
</Layout>
