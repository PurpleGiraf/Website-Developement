---
import Layout from '../../templates/trades/Layout.astro';
import { config } from '../../templates/trades/config';
import { team, values } from '../../templates/trades/data';
import Photo from '../../components/Photo.astro';
---

<Layout
  page="about"
  title={`About Us | ${config.brandName} Joinery & Build, Brisbane`}
  description="Ashgrove brings design, building and joinery under one roof. Meet the Northgate team behind around twenty Brisbane renovations a year."
>
  <section style="max-width:1320px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,56px)">
    <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;color:#6b6157;text-transform:uppercase;margin-bottom:24px">About us</div>
    <h1 style="font-family:var(--hf);font-weight:400;font-size:clamp(44px,6.5vw,88px);line-height:1;letter-spacing:-0.02em;margin:0;max-width:1000px;text-wrap:balance">A builder’s eye and a cabinetmaker’s patience.</h1>
  </section>
  <section style="max-width:1320px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(64px,9vw,120px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:56px">
    <Photo name="trades/about-workshop" alt="The Ashgrove team working at the bench in the Northgate workshop" label="workshop photo — team at the bench" priority sizes="(min-width: 1320px) 600px, (min-width: 1000px) 50vw, 100vw" style="aspect-ratio:4/3;background:repeating-linear-gradient(135deg,#e2d8c9 0 1px,#ebe3d7 1px 12px);display:flex;align-items:flex-end;padding:16px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#7a6f62" />
    <div style="display:flex;flex-direction:column;gap:20px;font-size:18px;line-height:1.65;color:#4d443b">
      <p style="margin:0">Tom Hartley started Ashgrove in 2009 after fifteen years as a site carpenter, frustrated by renovations where the joinery was an afterthought. So he built a workshop, hired cabinetmakers, and brought design, building and joinery under one roof.</p>
      <p style="margin:0">Today we take on around twenty projects a year — deliberately few, so every one has a lead carpenter on site from start to finish. Most of our work comes from referrals, and we’d like to keep it that way.</p>
      <p style="margin:0">We’re based in Northgate and work across Brisbane’s inner and northern suburbs, Moreton Bay and the Redlands.</p>
    </div>
  </section>
  <section style="background:#e9e1d4">
    <div style="max-width:1320px;margin:0 auto;padding:clamp(64px,9vw,120px) clamp(20px,4vw,56px)">
      <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(34px,4vw,52px);margin:0 0 40px">The people on your site</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:32px">
        {
          team.map((t, i) => (
            <div style="display:flex;flex-direction:column;gap:14px">
              <Photo name={`trades/team-${i + 1}`} alt={`Portrait of ${t.name}, ${t.role}`} label="portrait" sizes="(min-width: 1320px) 400px, (min-width: 800px) 33vw, 100vw" style="aspect-ratio:4/5;background:repeating-linear-gradient(135deg,#d8ccbb 0 1px,#e2d8c9 1px 12px);display:flex;align-items:flex-end;padding:14px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#7a6f62" />
              <div style="font-family:var(--hf);font-size:26px">{t.name}</div>
              <div style="font-size:15px;color:#4d443b;margin-top:-8px">{t.role}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section style="max-width:1320px;margin:0 auto;padding:clamp(64px,9vw,120px) clamp(20px,4vw,56px)">
    <h2 style="font-family:var(--hf);font-weight:400;font-size:clamp(34px,4vw,52px);margin:0 0 40px">What we hold ourselves to</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:40px">
      {
        values.map((v) => (
          <div style="border-top:2px solid #2b2520;padding-top:18px;display:flex;flex-direction:column;gap:10px">
            <h3 style="font-family:var(--hf);font-weight:400;font-size:28px;margin:0">{v.title}</h3>
            <p style="margin:0;font-size:16px;line-height:1.6;color:#4d443b">{v.body}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
