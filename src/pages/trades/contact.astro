---
import Layout from '../../templates/trades/Layout.astro';
import SeoNote from '../../templates/trades/SeoNote.astro';
import { config, localBusinessSchema } from '../../templates/trades/config';

const b = config.business;
const lbl = 'display:flex;flex-direction:column;gap:8px;font-size:14px;font-weight:600';
const field = 'padding:14px;border:1px solid #cfc3b2;background:#fff;font-size:16px;font-weight:400';
---

<Layout
  page="contact"
  title={`Contact Us | ${config.brandName} Joinery & Build, Northgate QLD`}
  description="Visit the Ashgrove workshop at Unit 4, 22 Earnshaw Road, Northgate QLD 4013, call (07) 3555 0142 or send us a message. Serving inner and north Brisbane, Moreton Bay and the Redlands."
  jsonld={localBusinessSchema(Astro.site)}
>
  <section style="max-width:1320px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,56px) 56px;display:flex;flex-direction:column;gap:20px">
    <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;color:#6b6157;text-transform:uppercase">Contact</div>
    <h1 style="font-family:var(--hf);font-weight:400;font-size:clamp(44px,6.5vw,88px);line-height:1;letter-spacing:-0.02em;margin:0">Visit the workshop, or give us a call</h1>
    <SeoNote>LocalBusiness schema · NAP matches Google Business Profile</SeoNote>
  </section>
  <section style="max-width:1320px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(64px,9vw,120px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:56px">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:36px;align-content:start">
      <div style="display:flex;flex-direction:column;gap:8px"><span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;color:#6b6157">WORKSHOP</span><address style="font-size:18px;line-height:1.5;font-style:normal">{b.address.street}<br />{b.address.locality} {b.address.region} {b.address.postcode}</address></div>
      <div style="display:flex;flex-direction:column;gap:8px"><span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;color:#6b6157">PHONE &amp; EMAIL</span><a href={b.phoneHref} style="font-size:18px;text-decoration:none">{b.phone}</a><a href={`mailto:${b.email}`} style="font-size:18px;text-decoration:none">{b.email}</a></div>
      <div style="display:flex;flex-direction:column;gap:8px"><span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;color:#6b6157">HOURS</span><span style="font-size:18px;line-height:1.5">{b.hours[0]}<br />{b.hours[1]}</span></div>
      <div style="display:flex;flex-direction:column;gap:8px"><span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;color:#6b6157">SERVICE AREA</span><span style="font-size:18px;line-height:1.5">{b.serviceArea}</span></div>
      <div style="grid-column:1/-1;aspect-ratio:16/9;background:repeating-linear-gradient(135deg,#e2d8c9 0 1px,#ebe3d7 1px 12px);display:flex;align-items:flex-end;padding:16px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#7a6f62">Google Map embed</div>
    </div>
    <div data-form-wrap style="background:#faf7f2;padding:clamp(24px,4vw,44px);border:1px solid #ddd3c5">
      <div data-form-success hidden role="status" style="font-family:var(--hf);font-size:36px;padding:40px 0">Message sent. We’ll be in touch shortly.</div>
      <form data-form method="post" style="display:flex;flex-direction:column;gap:18px">
        <h2 style="font-family:var(--hf);font-weight:400;font-size:34px;margin:0 0 4px">Send a message</h2>
        <label style={lbl}>Name<input name="name" autocomplete="name" required style={field} /></label>
        <label style={lbl}>Email<input name="email" type="email" autocomplete="email" required style={field} /></label>
        <label style={lbl}>Message<textarea name="message" rows="5" style={`${field};resize:vertical`}></textarea></label>
        <button type="submit" style="background:#2b2520;color:#faf7f2;border:0;padding:16px;cursor:pointer;font-size:15px;font-weight:600">Send message</button>
      </form>
    </div>
  </section>
</Layout>
