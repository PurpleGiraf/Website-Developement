---
import Layout from '../../templates/blank-digital/Layout.astro';
import Faq from '../../templates/blank-digital/Faq.astro';
import Photo from '../../components/Photo.astro';
import { config, routes, serviceHref, faqSchema } from '../../templates/blank-digital/config';
import { services, steps, industries, statement, dashboard, work, why, faqs, quote, pad2 } from '../../templates/blank-digital/data';

const b = config.business;
const L1 = 'Marketing at the';
const L2 = 'speed of now';
const kpis = [
  { label: 'Leads today', value: '128', delta: '+24%', key: 'leads' },
  { label: 'Cost per lead', value: '$14.20', delta: '−31%', key: 'cpl' },
  { label: 'Calls answered', value: '100%', delta: '24/7' },
  { label: 'Campaigns live', value: '6', delta: '+2' },
];
const bars = Array.from({ length: 24 }, (_, i) => Math.round(Math.min(1, 0.25 + 0.55 * Math.abs(Math.sin(i * 0.45)) + (i / 24) * 0.2) * 100));
const feed = [0, 1, 2, 3].map((k) => ({ text: dashboard.feed[(9 - k) % 9][0], color: dashboard.feed[(9 - k) % 9][1], time: k === 0 ? 'now' : `${k * 2}m` }));
---

<Layout
  page="home"
  title={`${b.name} | Ads, websites, content and brand, live in 72 hours`}
  description="Ads, websites, content and brand for ambitious local businesses. Fixed quote within the hour, campaigns live in 72 hours and optimised every hour after. No lock-in contracts."
  jsonld={[faqSchema(faqs)]}
  hideCta
  gridHeight={1400}
>
  <header id="top" class="bd-home-hero">
    {
      config.announcement.on && (
        <a href={routes.quote} class="bd-announce">
          <span class="bd-announce-tag"><span class="bd-announce-dot" />{config.announcement.label}</span>
          {config.announcement.text} →
        </a>
      )
    }
    <h1 class="bd-hero-h1" aria-label={`${L1} ${L2}`}>
      <span class="bd-hero-ghost" aria-hidden="true">{L1}<br /><span class="bd-hero-pad">{L2}</span><span class="bd-type-cur is-space"></span></span>
      <span class="bd-hero-typed" aria-hidden="true" data-type>
        <span data-type-1>{L1}</span><span class="bd-type-cur" data-cur1 hidden></span><br /><span class="bd-shimmer bd-hero-pad" data-type-2>{L2}</span><span class="bd-type-cur" data-cur2></span>
      </span>
    </h1>
    <p class="bd-hero-lede" data-hero>Ads, websites, content and brand for ambitious local businesses. Briefed today. Live in 72 hours. Optimised every hour after.</p>
    <div class="bd-btn-row bd-hero-ctas" data-hero>
      <a href={routes.quote} class="bd-btn bd-btn-lg bd-btn-glow" data-magnetic>Get your free quote <span class="bd-arrow">→</span></a>
      <a href="#work" class="bd-btn-ghost bd-btn-lg" data-magnetic>See our work</a>
    </div>
    <ul class="bd-ticks">
      <li>✓ Fixed quote in 1 hour</li><li>✓ No lock-in contracts</li><li>✓ Answered 24/7</li>
    </ul>

    <!-- Illustration of the client dashboard. Numbers are sample data that animate on screen. -->
    <figure class="bd-dash-stage" aria-label="Example of the live client dashboard">
      <div class="bd-dash" data-tilt>
        <div class="bd-dash-inner">
          <div class="bd-dash-bar">
            <div class="bd-dash-lights" aria-hidden="true"><span></span><span></span><span></span></div>
            <span class="bd-dash-path">blank / command · {dashboard.client}</span>
            <span class="bd-dash-live"><span></span>LIVE</span>
          </div>
          <div class="bd-dash-kpis">
            {
              kpis.map((k) => (
                <div class="bd-dash-kpi">
                  <span class="bd-dash-label">{k.label}</span>
                  <div class="bd-dash-val">
                    <span data-kpi={k.key}>{k.value}</span>
                    <span class="bd-dash-delta">{k.delta}</span>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="bd-dash-body">
            <div class="bd-dash-chart">
              <div class="bd-dash-row"><span>Leads · last 24h</span><span class="bd-dash-mono">auto-optimising</span></div>
              <div class="bd-dash-bars" data-bars aria-hidden="true">
                {bars.map((h, i) => <div style={`height:${h}%`} class:list={{ 'is-hot': i > 19 }} />)}
              </div>
            </div>
            <div class="bd-dash-feed">
              <span class="bd-dash-row"><span>Activity</span></span>
              <div data-feed>
                {
                  feed.map((f, k) => (
                    <div class="bd-dash-item" style={`opacity:${1 - k * 0.2}`}>
                      <span class="bd-dash-sq" style={`background:${f.color}`} />
                      <span class="bd-dash-text">{f.text}</span>
                      <span class="bd-dash-time">{f.time}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
      <script type="application/json" data-feed-pool set:html={JSON.stringify(dashboard.feed)} />
    </figure>
  </header>

  <section class="bd-marquee-sec" aria-labelledby="bd-ind-title">
    <p id="bd-ind-title" class="bd-mono-label bd-marquee-title">Built for businesses that cannot wait</p>
    <p class="bd-sr">{industries.join(', ')}</p>
    <div class="bd-marquee" aria-hidden="true">
      <div class="bd-marquee-track">
        {[...industries, ...industries].map((m) => <span>{m}</span>)}
      </div>
    </div>
  </section>

  <section class="bd-wrap bd-statement" data-words>
    <p>{statement.split(' ').map((w) => <span data-word>{w} </span>)}</p>
  </section>

  <section id="services" class="bd-wrap" style="scroll-margin-top:100px;padding-bottom:clamp(120px,14vw,180px)">
    <div class="bd-head">
      <div class="bd-head-copy">
        <span class="bd-eyebrow" data-reveal data-scramble>Services</span>
        <h2 class="bd-h2" data-reveal>One team. <span class="bd-grey">Every channel.</span></h2>
      </div>
      <p class="bd-body" data-reveal>Pick one service or let us run the lot. Everything plugs together, so your ads, site and content all pull in the same direction.</p>
    </div>
    <div class="bd-svc-grid">
      {
        services.map((s, i) => (
          <a href={serviceHref(s.slug)} class="bd-card bd-svc-card" data-reveal data-spot>
            <div class="bd-svc-top">
              <span class="bd-num-box">{pad2(i + 1)}</span>
              <span class="bd-svc-speed">{s.speed}</span>
            </div>
            <h3 class="bd-h3" style="margin-top:24px">{s.name}</h3>
            <p style="font-size:15px;line-height:1.55;color:var(--text)">{s.card}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section id="process" class="bd-band" data-process style="scroll-margin-top:60px">
    <div class="bd-wrap bd-section">
      <div class="bd-center" style="margin-bottom:88px">
        <span class="bd-eyebrow" data-reveal data-scramble>Process</span>
        <h2 class="bd-h2" data-reveal style="max-width:820px">Brief on Monday. <span class="bd-grey">Live by Thursday.</span></h2>
      </div>
      <div class="bd-timeline">
        <div class="bd-timeline-track"><div class="bd-timeline-fill" data-line></div></div>
        <ol class="bd-timeline-grid" style="list-style:none;margin:0;padding:0">
          {
            steps.map((st, i) => (
              <li class="bd-timeline-step" data-reveal>
                <span class="bd-num-circle">{pad2(i + 1)}</span>
                <span class="bd-when">{st.time}</span>
                <h3 class="bd-h3" style="font-size:22px">{st.title}</h3>
                <p style="font-size:15px;line-height:1.6">{st.short}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section id="work" class="bd-wrap bd-section" style="scroll-margin-top:60px">
    <div class="bd-head">
      <div class="bd-head-copy" style="max-width:none">
        <span class="bd-eyebrow" data-reveal data-scramble>Selected work</span>
        <h2 class="bd-h2" data-reveal>Fast launches. <span class="bd-grey">Real numbers.</span></h2>
      </div>
      <a href={routes.quote} class="bd-text-link" data-reveal>Start yours →</a>
    </div>
    <div class="bd-work-grid">
      {
        work.map((w) => (
          <a href={routes.quote} class="bd-work-card" data-reveal>
            <div class="bd-work-media">
              <Photo name={w.image} alt={`${w.title}, ${w.tag}`} label="case study image" style="position:absolute;inset:0" class="bd-ph bd-zoom" sizes="(min-width: 1280px) 600px, 100vw" />
            </div>
            <div class="bd-work-body">
              <div class="bd-work-meta"><span>{w.tag}</span><span class="bd-blue bd-mono">{w.time}</span></div>
              <h3 class="bd-h3" style="font-size:20px">{w.title}</h3>
              <div class="bd-work-stats">
                {w.stats.map((x) => (
                  <div>
                    <span>{x.v}</span>
                    <span>{x.l}</span>
                  </div>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section id="about" class="bd-rule" style="scroll-margin-top:60px">
    <div class="bd-wrap bd-section bd-about">
      <div class="bd-head-copy" style="gap:24px">
        <span class="bd-eyebrow" data-reveal data-scramble>About</span>
        <h2 class="bd-h2" data-reveal>We rebuilt the agency <span class="bd-grey">from zero.</span></h2>
      </div>
      <div class="bd-about-copy">
        <p class="bd-about-lede" data-reveal>Local businesses had two options: slow, expensive agencies or doing it all themselves. BLANK is the third. Tight systems, sharp specialists and our own tooling let us move in hours where others take weeks, at a price that makes sense for a real business.</p>
        <dl class="bd-why">
          {
            why.map((y) => (
              <div data-reveal>
                <dt>{y.title}</dt>
                <dd>{y.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section id="faq" class="bd-wrap" style="max-width:880px;padding-bottom:clamp(120px,14vw,180px);scroll-margin-top:100px">
    <h2 class="bd-h2" data-reveal style="font-size:clamp(24px,3vw,38px);text-align:center;margin-bottom:48px">Questions, <span class="bd-grey">answered.</span></h2>
    <Faq items={faqs} />
  </section>

  <section id="quote" class="bd-quote-sec" aria-labelledby="bd-quote-title">
    <div class="bd-panel">
      <div class="bd-panel-grid" aria-hidden="true"></div>
      <div class="bd-quote-grid">
        <div class="bd-quote-intro">
          <span class="bd-eyebrow" data-reveal data-scramble>Get a quote</span>
          <h2 id="bd-quote-title" class="bd-h2" data-reveal style="font-size:clamp(31px,4.4vw,63px)">60 seconds.<br /><span class="bd-blue">Then we move.</span></h2>
          <p data-reveal style="font-size:18px;line-height:1.6;max-width:420px">Three quick questions. A tailored plan and fixed price in your inbox within the hour. No sales call required.</p>
          <div class="bd-quote-call" data-reveal>
            <span class="bd-quote-call-dot"></span>
            <span>Prefer to talk? <a href={b.phoneHref}>{b.phone}</a>, answered 24/7.</span>
          </div>
        </div>

        <div class="bd-quote-box">
          <!-- TODO before launch: set `action` to the client's form endpoint (Formspree, CRM webhook, etc.). -->
          <form class="bd-quote-form" data-quote novalidate>
            <div class="bd-quote-dots" aria-hidden="true"><span class="is-on"></span><span></span><span></span></div>
            <p class="bd-sr" aria-live="polite" data-quote-status>Step 1 of 3</p>

            <fieldset class="bd-step is-active" data-step="0">
              <legend class="bd-step-head"><span class="bd-step-n">01 / 03</span><span class="bd-h3 bd-step-title">What do you need?</span></legend>
              <div class="bd-opts">
                {
                  quote.services.map((name) => (
                    <label class="bd-opt">
                      <input type="checkbox" name="services" value={name} />
                      <span>{name}<span class="bd-opt-mark" aria-hidden="true" /></span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="bd-step" data-step="1">
              <legend class="bd-step-head"><span class="bd-step-n">02 / 03</span><span class="bd-h3 bd-step-title">Monthly budget</span></legend>
              <div class="bd-opts">
                {
                  quote.budgets.map((name) => (
                    <label class="bd-opt">
                      <input type="radio" name="budget" value={name} />
                      <span>{name}</span>
                    </label>
                  ))
                }
              </div>
              <span class="bd-h3 bd-step-sub" id="bd-timing-label">Launch timing</span>
              <div class="bd-opts" role="radiogroup" aria-labelledby="bd-timing-label">
                {
                  quote.timings.map((name) => (
                    <label class="bd-opt">
                      <input type="radio" name="timing" value={name} />
                      <span>{name}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="bd-step" data-step="2">
              <legend class="bd-step-head"><span class="bd-step-n">03 / 03</span><span class="bd-h3 bd-step-title">Where should we send it?</span></legend>
              <div class="bd-fields">
                <label><span class="bd-sr">Name (required)</span><input name="name" required autocomplete="name" placeholder="Name *" /></label>
                <label><span class="bd-sr">Business</span><input name="business" autocomplete="organization" placeholder="Business" /></label>
                <label><span class="bd-sr">Email (required)</span><input type="email" name="email" required autocomplete="email" placeholder="Email *" /></label>
                <label><span class="bd-sr">Phone</span><input type="tel" name="phone" autocomplete="tel" placeholder="Phone" /></label>
              </div>
              <label><span class="bd-sr">Project details</span><textarea name="details" rows="3" placeholder="Website, goals, competitors you want to beat"></textarea></label>
            </fieldset>

            <div class="bd-quote-nav">
              <button type="button" class="bd-quote-back" data-quote-back hidden>← Back</button>
              <button type="submit" class="bd-btn" data-quote-next>Get my quote →</button>
            </div>
          </form>

          <div class="bd-quote-done" data-quote-done hidden tabindex="-1">
            <span class="bd-tick" aria-hidden="true">✓</span>
            <h3 class="bd-h3" style="font-size:clamp(23px,2.3vw,31px);line-height:1.25">You are in, <span data-quote-first>there</span>.</h3>
            <p style="font-size:16px;line-height:1.6;max-width:400px">Your plan and fixed quote will land at <span data-quote-email class="bd-ink">your inbox</span> within the hour. Your account lead is already reviewing your brief.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .bd-home-hero{position:relative;padding:clamp(150px,18vh,200px) var(--pad) 0;display:flex;flex-direction:column;align-items:center;text-align:center}
  .bd-announce{display:flex;align-items:center;gap:10px;padding:6px 14px 6px 6px;border:1px solid rgba(255,255,255,0.1);border-radius:999px;background:rgba(255,255,255,0.03);font-size:13px;color:var(--soft);margin-bottom:36px;text-align:left}
  .bd-announce:hover{border-color:rgba(255,255,255,0.22);color:#fff}
  .bd-announce-tag{display:flex;align-items:center;gap:6px;flex:none;background:rgba(47,91,255,0.16);color:var(--accent-text);padding:3px 10px;border-radius:999px;font-family:var(--mono);font-size:11px;letter-spacing:0.04em}
  .bd-announce-dot{width:6px;height:6px;border-radius:9px;background:var(--accent);animation:bd-pulse 1.8s infinite}
  .bd-hero-h1{font-family:var(--display);font-weight:400;font-size:clamp(28px,5vw,76px);line-height:1.14;letter-spacing:-0.01em;color:var(--ink);width:100%;max-width:1100px;display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;text-align:center;text-transform:uppercase}
  .bd-hero-ghost{grid-area:1/1;visibility:hidden}
  .bd-hero-typed{grid-area:1/1}
  .bd-hero-pad{padding-right:0.08em}
  .bd-type-cur{display:inline-block;width:0.46em;height:0.085em;margin-left:0.06em;background:var(--accent);box-shadow:0 0 30px var(--accent);animation:bd-blink 1.05s steps(1) infinite}
  .bd-type-cur.is-space{background:none;box-shadow:none}
  .bd-shimmer{background:linear-gradient(90deg,var(--ink) 0%,var(--accent-text) 50%,var(--ink) 100%);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:bd-shimmer 8s linear infinite}
  .bd-hero-lede{margin-top:32px;font-size:clamp(17px,1.4vw,20px);line-height:1.55;max-width:560px;text-wrap:balance}
  .bd-hero-ctas{justify-content:center;margin-top:40px}
  .bd-ticks{list-style:none;margin:28px 0 0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px clamp(16px,3vw,36px);font-size:13px;color:var(--dim)}

  /* Dashboard */
  .bd-dash-stage{width:100%;max-width:1200px;margin:clamp(64px,8vw,96px) 0 0;perspective:1600px}
  .bd-dash{transform:rotateX(22deg) scale(0.92);transform-origin:50% 0%;border-radius:20px;padding:1px;background:linear-gradient(180deg,rgba(255,255,255,0.18),rgba(255,255,255,0.03) 60%);box-shadow:0 40px 120px rgba(0,0,0,0.6),0 0 120px rgba(47,91,255,0.12);text-align:left}
  .bd-still .bd-dash{transform:none}
  .bd-dash-inner{border-radius:19px;background:var(--panel-2);overflow:hidden}
  .bd-dash-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 18px;border-bottom:1px solid rgba(255,255,255,0.06)}
  .bd-dash-lights{display:flex;gap:7px}
  .bd-dash-lights span{width:11px;height:11px;border-radius:9px;background:#2A2A2E}
  .bd-dash-path{font-family:var(--mono);font-size:11px;color:var(--dim);letter-spacing:0.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
  .bd-dash-live{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11px;color:var(--green)}
  .bd-dash-live span{width:6px;height:6px;border-radius:9px;background:var(--green);animation:bd-pulse 1.6s infinite}
  .bd-dash-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr));border-bottom:1px solid rgba(255,255,255,0.06)}
  .bd-dash-kpi{padding:22px 24px;border-right:1px solid rgba(255,255,255,0.06);display:flex;flex-direction:column;gap:8px}
  .bd-dash-label{font-size:12px;color:var(--dim)}
  .bd-dash-val{display:flex;align-items:baseline;gap:10px}
  .bd-dash-val > span:first-child{font-family:var(--display);font-size:21px;color:var(--ink);font-variant-numeric:tabular-nums}
  .bd-dash-delta{font-family:var(--mono);font-size:11px;color:var(--green)}
  .bd-dash-body{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))}
  .bd-dash-chart{padding:24px;border-right:1px solid rgba(255,255,255,0.06);display:flex;flex-direction:column;gap:18px;min-width:0}
  .bd-dash-row{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:var(--soft);white-space:nowrap}
  .bd-dash-mono{font-family:var(--mono);color:var(--dim)}
  .bd-dash-bars{height:150px;display:flex;align-items:flex-end;gap:5px}
  .bd-dash-bars div{flex:1;background:rgba(255,255,255,0.12);border-radius:3px 3px 0 0;transition:height .9s var(--ease)}
  .bd-dash-bars div.is-hot{background:var(--accent-text)}
  .bd-dash-feed{padding:24px;display:flex;flex-direction:column;gap:14px;min-width:0}
  .bd-dash-feed > div{display:flex;flex-direction:column;gap:14px}
  .bd-dash-item{display:flex;align-items:center;gap:12px;font-size:13px}
  .bd-dash-item.is-new{animation:bd-rise .6s var(--ease)}
  .bd-dash-sq{width:7px;height:7px;border-radius:2px;flex-shrink:0}
  .bd-dash-text{color:var(--soft);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .bd-dash-time{font-family:var(--mono);font-size:11px;color:var(--faint)}

  /* Marquee + statement */
  .bd-marquee-sec{padding-top:clamp(80px,10vw,120px)}
  .bd-marquee-title{display:block;margin:0 0 28px;text-align:center;font-size:12px}
  .bd-marquee{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 15%,#000 85%,transparent);mask-image:linear-gradient(90deg,transparent,#000 15%,#000 85%,transparent)}
  .bd-marquee-track{display:flex;width:max-content;animation:bd-marquee 40s linear infinite}
  .bd-marquee-track span{padding:0 clamp(24px,3vw,44px);font-family:var(--display);font-size:clamp(16px,1.7vw,22px);color:#3A3A40;white-space:nowrap}
  .bd-statement{max-width:1180px;padding-top:clamp(120px,16vw,220px);padding-bottom:clamp(120px,16vw,220px)}
  .bd-statement p{font-family:var(--display);font-size:clamp(22px,3vw,40px);line-height:1.4;letter-spacing:-0.01em;color:var(--ink);text-wrap:pretty}
  .bd-js:not(.bd-still) [data-word]{opacity:0.16;transition:opacity .25s}
  .bd-js:not(.bd-still) [data-word].is-lit{opacity:1}

  /* Services */
  .bd-svc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,290px),1fr));gap:12px}
  .bd-svc-card{min-height:280px}
  .bd-svc-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:auto}
  .bd-svc-speed{font-family:var(--mono);font-size:11px;color:var(--dim);white-space:nowrap}

  /* Work */
  .bd-work-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:16px}
  .bd-work-card{display:flex;flex-direction:column;border-radius:20px;border:1px solid var(--line);background:var(--panel);overflow:hidden;color:var(--ink);transition:border-color .4s}
  .bd-work-card:hover{border-color:rgba(255,255,255,0.18);color:var(--ink)}
  .bd-work-media{aspect-ratio:16/10;overflow:hidden;position:relative}
  .bd-zoom{transition:transform 1.2s var(--ease)}
  .bd-work-card:hover .bd-zoom{transform:scale(1.04)}
