---
import Layout from '../../../templates/blank-digital/Layout.astro';
import { config, routes, serviceHref, breadcrumbSchema, absUrl } from '../../../templates/blank-digital/config';
import { services, combos, pad2 } from '../../../templates/blank-digital/data';

const b = config.business;
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${b.name} services`,
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: absUrl(serviceHref(s.slug), Astro.site) })),
};
---

<Layout
  page="services"
  title={`Services | ${b.name}`}
  description="Paid ads, social content, SEO, web design, branding, email and CRM, video and analytics for local businesses. One team running every channel, live in days, month to month."
  jsonld={[list, breadcrumbSchema([{ name: 'Home', path: routes.home }, { name: 'Services', path: routes.services }], Astro.site)]}
>
  <header class="bd-wrap bd-page-hero">
    <span class="bd-eyebrow" data-hero data-scramble style="margin-bottom:28px">Services · {pad2(services.length)}</span>
    <h1 class="bd-h1" data-hero style="max-width:1080px">Eight ways to grow. <span class="bd-blue">One team running all of them.</span></h1>
    <div data-hero class="bd-svc-hero-row">
      <p class="bd-lede">Pick a single service or let us run the lot. Everything plugs together, so your ads, site and content all pull in the same direction.</p>
      <ul class="bd-svc-ticks">
        <li>✓ Live in days</li><li>✓ Month to month</li><li>✓ One point of contact</li>
      </ul>
    </div>
  </header>

  <section class="bd-wrap" style="padding-bottom:clamp(110px,13vw,170px)">
    <ol class="bd-svc-list">
      {
        services.map((s, i) => (
          <li data-reveal>
            <a href={serviceHref(s.slug)} class="bd-svc-row">
              <span class="bd-svc-n">{pad2(i + 1)}</span>
              <span class="bd-svc-name">{s.name}</span>
              <span class="bd-svc-blurb">{s.blurb}</span>
              <span class="bd-svc-end">
                <span class="bd-svc-speed-l">{s.speed}</span>
                <span class="bd-svc-go" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="bd-band">
    <div class="bd-wrap bd-section">
      <div class="bd-head">
        <div class="bd-head-copy">
          <span class="bd-eyebrow" data-reveal data-scramble>Popular combinations</span>
          <h2 class="bd-h2" data-reveal>Better together.</h2>
        </div>
        <p class="bd-body" data-reveal>The setups our clients ask for most. Every one is tailored after your brief.</p>
      </div>
      <div class="bd-combo-grid">
        {
          combos.map((c) => (
            <div class="bd-card bd-combo" data-reveal data-spot>
              <span class="bd-eyebrow" style="font-size:11px">{c.tag}</span>
              <h3 class="bd-h3" style="font-size:22px;line-height:1.25">{c.title}</h3>
              <p style="font-size:15px;line-height:1.6;flex:1;color:var(--text)">{c.body}</p>
              <ul class="bd-tags">
                {c.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .bd-svc-hero-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:32px;margin-top:40px}
  .bd-svc-ticks{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:12px 28px;font-family:var(--mono);font-size:12px;letter-spacing:0.06em;color:var(--soft)}
  .bd-svc-list{list-style:none;margin:0;padding:0;border-top:1px solid rgba(255,255,255,0.08)}
  .bd-svc-row{display:grid;grid-template-columns:minmax(40px,72px) minmax(0,1.3fr) minmax(0,1fr) auto;align-items:center;gap:clamp(16px,3vw,40px);padding:clamp(24px,3vw,36px) 16px;border-bottom:1px solid rgba(255,255,255,0.08);color:var(--ink);border-radius:16px;transition:background .4s,padding .5s var(--ease)}
  .bd-svc-row:hover{background:#111114;padding-left:32px;color:#fff}
  .bd-svc-n{font-family:var(--mono);font-size:12px;color:var(--dim)}
  .bd-svc-name{font-family:var(--display);font-size:clamp(20px,2.6vw,34px);line-height:1.2}
  .bd-svc-blurb{font-size:15px;line-height:1.55;color:var(--text)}
  .bd-svc-end{display:flex;align-items:center;gap:16px;justify-self:end}
  .bd-svc-speed-l{font-family:var(--mono);font-size:11px;color:var(--accent-text);white-space:nowrap}
  .bd-svc-go{width:44px;height:44px;border-radius:999px;border:1px solid rgba(255,255,255,0.14);display:flex;align-items:center;justify-content:center;font-size:16px;transition:background .3s,color .3s}
  .bd-svc-row:hover .bd-svc-go{background:var(--ink);color:var(--bg)}
  @media (max-width: 820px){
    .bd-svc-row{grid-template-columns:40px minmax(0,1fr) auto;row-gap:10px}
    .bd-svc-blurb{grid-column:2/3;grid-row:2}
    .bd-svc-end{grid-column:3;grid-row:1/3}
    .bd-svc-speed-l{display:none}
  }
  .bd-combo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:14px}
  .bd-combo{min-height:340px;padding:32px;border-radius:20px;gap:18px}
  .bd-tags{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .bd-tags li{font-size:13px;color:var(--soft);padding:7px 12px;border-radius:999px;border:1px solid rgba(255,255,255,0.1)}
</style>
