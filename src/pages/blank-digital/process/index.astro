---
import Layout from '../../../templates/blank-digital/Layout.astro';
import { config, routes, breadcrumbSchema, absUrl } from '../../../templates/blank-digital/config';
import { steps, never, principles, pad2 } from '../../../templates/blank-digital/data';

const b = config.business;
const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How ${b.name} takes you from brief to live campaigns`,
  totalTime: 'P3D',
  step: steps.map((st, i) => ({ '@type': 'HowToStep', position: i + 1, name: st.title, text: st.body, url: `${absUrl(routes.process, Astro.site)}#step-${pad2(i + 1)}` })),
};
---

<Layout
  page="process"
  title={`Process: brief on Monday, live by Thursday | ${b.name}`}
  description="Four steps from first message to first results: a 15-minute brief, a plan within 24 hours, launch within 72 hours, then constant optimisation with weekly reports."
  jsonld={[howTo, breadcrumbSchema([{ name: 'Home', path: routes.home }, { name: 'Process', path: routes.process }], Astro.site)]}
>
  <header class="bd-wrap bd-page-hero bd-center" style="gap:0;padding-bottom:clamp(80px,10vw,120px)">
    <span class="bd-eyebrow" data-hero data-scramble style="margin-bottom:28px">How it works</span>
    <h1 class="bd-h1" data-hero style="max-width:1000px;font-size:clamp(29px,4.9vw,72px)">Brief on Monday. <span class="bd-blue">Live by Thursday.</span></h1>
    <p class="bd-lede" data-hero style="margin-top:32px;text-wrap:balance">Four steps, no waiting rooms. Here is exactly what happens between your first message and your first results.</p>
    <nav class="bd-step-tabs" data-hero aria-label="Steps">
      {
        steps.map((st, i) => (
          <a href={`#step-${pad2(i + 1)}`}>
            <span class="bd-step-tab-time">{st.time}</span>
            <span class="bd-step-tab-title">{st.title}</span>
          </a>
        ))
      }
    </nav>
  </header>

  <section class="bd-rule">
    <div class="bd-wrap bd-steps-layout" data-steps>
      <div class="bd-steps-aside" aria-hidden="true">
        <span class="bd-mono-label" style="font-size:12px">Step</span>
        <div class="bd-steps-big" data-steps-num>01</div>
        <div class="bd-steps-bars">
          {
            steps.map((st, i) => (
              <div class:list={['bd-steps-bar', { 'is-on': i === 0, 'is-active': i === 0 }]} data-steps-bar>
                <span></span>
                <span>{st.title}</span>
              </div>
            ))
          }
        </div>
      </div>
      <ol class="bd-steps-list">
        {
          steps.map((st, i) => (
            <li id={`step-${pad2(i + 1)}`} class:list={['bd-pstep', { 'is-active': i === 0 }]} data-pstep>
              <div class="bd-pstep-top">
                <span class="bd-eyebrow">Step {pad2(i + 1)}</span>
                <span class="bd-pstep-time">{st.time}</span>
              </div>
              <h2 class="bd-h2" style="font-size:clamp(26px,3vw,40px);line-height:1.15">{st.title}</h2>
              <p style="font-size:17px;line-height:1.65;color:var(--soft)">{st.body}</p>
              <div class="bd-pstep-cols">
                <div>
                  <h3 class="bd-mono-label" style="margin:0">What happens</h3>
                  <ul>
                    {st.happens.map((h) => (
                      <li>
                        <span style="color:var(--accent)" aria-hidden="true">→</span>
                        {h}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="bd-mono-label" style="margin:0">You get</h3>
                  <ul>
                    {st.get.map((g) => (
                      <li style="color:var(--ink)">
                        <span style="color:var(--green)" aria-hidden="true">✓</span>
                        {g}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <p class="bd-pstep-yours"><span class="bd-mono-label">Your time</span><span style="color:var(--ink)">{st.yours}</span></p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bd-band">
    <div class="bd-wrap bd-section">
      <div class="bd-center" style="margin-bottom:64px">
        <span class="bd-eyebrow" data-reveal data-scramble>Things you never wait for</span>
        <h2 class="bd-h2" data-reveal style="max-width:760px;font-size:clamp(26px,3.5vw,48px)">Built so nothing sits in an inbox.</h2>
      </div>
      <dl class="bd-never-grid">
        {
          never.map((n) => (
            <div class="bd-card" data-reveal data-spot style="padding:32px 28px;border-radius:20px">
              <dt style="font-family:var(--display);font-size:clamp(26px,2.6vw,34px);color:var(--ink)">{n.v}</dt>
              <dd style="margin:0;font-size:15px;line-height:1.5;color:var(--text)">{n.l}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="bd-wrap bd-section">
    <div class="bd-principles">
      {
        principles.map((p, i) => (
          <div data-reveal>
            <span class="bd-mono-label" style="font-size:12px;letter-spacing:0">{pad2(i + 1)}</span>
            <h3 class="bd-h3" style="font-size:20px">{p.t}</h3>
            <p style="font-size:16px;line-height:1.6">{p.b}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style is:global>
  .bd-step-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin-top:56px;width:100%;max-width:820px;border-radius:18px;overflow:hidden;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.08)}
  .bd-step-tabs a{background:var(--panel-2);padding:20px 12px;display:flex;flex-direction:column;gap:6px;align-items:center;color:var(--ink);transition:background .3s}
  .bd-step-tabs a:hover{background:#141418}
  .bd-step-tab-time{font-family:var(--mono);font-size:11px;color:var(--accent-text);text-align:center}
  .bd-step-tab-title{font-family:var(--display);font-size:14px}
  @media (max-width: 560px){ .bd-step-tabs{grid-template-columns:repeat(2,minmax(0,1fr))} }

  .bd-steps-layout{padding-top:clamp(80px,10vw,140px);padding-bottom:clamp(80px,10vw,140px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(40px,6vw,96px)}
  .bd-steps-aside{position:sticky;top:130px;align-self:start;display:flex;flex-direction:column;gap:28px}
  .bd-steps-big{font-family:var(--display);font-size:clamp(110px,14vw,200px);line-height:0.9;color:var(--ink)}
  .bd-steps-bars{display:flex;flex-direction:column;gap:10px;max-width:320px}
  .bd-steps-bar{display:flex;align-items:center;gap:14px}
  .bd-steps-bar span:first-child{flex:1;height:2px;border-radius:2px;background:rgba(255,255,255,0.1);transition:background .5s,box-shadow .5s}
  .bd-steps-bar span:last-child{width:84px;font-family:var(--mono);font-size:11px;color:var(--faint);transition:color .5s}
  .bd-steps-bar.is-on span:first-child{background:var(--accent)}
  .bd-steps-bar.is-active span:first-child{box-shadow:0 0 10px var(--accent)}
  .bd-steps-bar.is-active span:last-child{color:var(--ink)}
  @media (max-width: 860px){ .bd-steps-aside{display:none} }
  .bd-steps-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:20px}
  .bd-pstep{scroll-margin-top:120px;padding:clamp(28px,3.5vw,44px);border-radius:24px;border:1px solid var(--line);background:var(--panel);display:flex;flex-direction:column;gap:24px;transition:opacity .6s,border-color .6s}
  .bd-js:not(.bd-still) .bd-pstep{opacity:0.45}
  .bd-js .bd-pstep.is-active{opacity:1;border-color:rgba(47,91,255,0.45)}
  .bd-pstep-top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px}
  .bd-pstep-time{font-family:var(--mono);font-size:11px;color:var(--ink);padding:6px 12px;border-radius:999px;background:rgba(47,91,255,0.18);border:1px solid rgba(47,91,255,0.4)}
  .bd-pstep-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:24px;padding-top:24px;border-top:1px solid var(--line)}
  .bd-pstep-cols > div{display:flex;flex-direction:column;gap:10px}
  .bd-pstep-cols ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}
  .bd-pstep-cols li{display:flex;gap:10px;font-size:15px;line-height:1.5}
  .bd-pstep-yours{display:flex;align-items:center;gap:10px;font-size:14px}
  .bd-never-grid{margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px}
  .bd-principles{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:48px}
  .bd-principles > div{display:flex;flex-direction:column;gap:16px;padding-top:28px;border-top:1px solid rgba(255,255,255,0.1)}
</style>
