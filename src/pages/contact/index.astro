---
// Contact page (from "Contact" in the redesign proposal).
import { Image } from 'astro:assets';
import PgLayout from '../../layouts/PgLayout.astro';
import PgFormStyles from '../../components/PgFormStyles.astro';
import teamLaptop from '../../assets/pg/team-laptop.jpg';
import { PG_SITE, email, offices, orgSchema } from '../../data/pg';

const officeCards = [
  { label: 'Head office · Adelaide', o: offices[0] },
  { label: 'Perth office · Virtual', o: offices[1] },
  { label: 'Queensland office', o: offices[2] },
].map(({ label, o }) => ({ label, addr: o.lines.join(', '), phone: o.phone, tel: o.tel }));

const interests = ['Website development', 'Digital marketing', 'AI solutions', 'UI/UX design', 'AI Visibility Review', 'Website templates'];

const fields = [
  { label: 'First name', type: 'text', name: 'first_name', auto: 'given-name', required: true },
  { label: 'Last name', type: 'text', name: 'last_name', auto: 'family-name', required: true },
  { label: 'Business name', type: 'text', name: 'business', auto: 'organization', required: true },
  { label: 'Phone', type: 'tel', name: 'phone', auto: 'tel', required: true },
  { label: 'Email', type: 'email', name: 'email', auto: 'email', required: true },
  { label: 'Website (optional)', type: 'text', name: 'website', auto: 'url', required: false },
];

const states = ['SA', 'WA', 'QLD', 'NSW', 'VIC', 'TAS', 'NT', 'ACT', 'Outside Australia'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Purple Giraffe Digital',
  url: new URL('/contact/', Astro.site).href,
  mainEntity: orgSchema,
};
const label = 'font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#7d6a96';
---

<PgLayout
  title="Contact | Purple Giraffe Digital"
  description="Talk to the Purple Giraffe digital team about your website, digital marketing, AI or design project. Offices in Adelaide, Perth and Brisbane."
  active="contact"
  jsonld={[schema]}
>
  <!-- Hero -->
  <section style="max-width:1560px;margin:0 auto;padding:clamp(150px,22vh,220px) clamp(20px,4vw,56px) clamp(56px,8vh,88px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:32px 64px;align-items:end">
    <h1 data-split aria-label="Let's talk." style="margin:0;font-weight:200;font-size:clamp(64px,11vw,200px);line-height:0.9;letter-spacing:-0.06em;grid-column:1/-1">
      Let's <span class="ct-dot">talk</span>
    </h1>
    <p data-reveal style="margin:0;font-size:clamp(18px,1.4vw,22px);line-height:1.5;font-weight:300;max-width:520px">Tell us about your website, digital marketing, AI or design project. We're ready to hit the ground running with you.</p>
    <div data-reveal style="display:flex;justify-content:flex-end">
      <a href={`mailto:${email}`} class="ct-mail" data-magnetic style="font-size:clamp(18px,1.6vw,24px);font-weight:300;padding-bottom:4px">{email}</a>
    </div>
  </section>

  <!-- Offices + form -->
  <section style="max-width:1560px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(110px,18vh,200px)">
    <div class="ct-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:56px clamp(40px,6vw,96px);padding-top:56px">
      <div data-stagger style="display:flex;flex-direction:column">
        {
          officeCards.map((o) => (
            <div class="ct-office" style="display:flex;flex-direction:column;gap:8px;padding:0 0 32px;margin-bottom:32px;border-bottom:1px solid #cfc4dc">
              <span style={label}>{o.label}</span>
              <span style="font-weight:300;font-size:clamp(24px,2.2vw,34px);line-height:1.15;letter-spacing:-0.03em">{o.addr}</span>
              <a href={`tel:${o.tel}`} class="ct-tel" style="font-size:18px;font-weight:300;align-self:flex-start">
                {o.phone} <span aria-hidden="true" class="ct-arrow">→</span>
              </a>
            </div>
          ))
        }
      </div>
      <div data-reveal data-form-wrap class="ct-card" style="background:#ebe4f1;border-radius:24px;padding:clamp(28px,4vw,56px);position:relative;overflow:hidden">
        <form data-form class="pg-form" style="display:flex;flex-direction:column;gap:28px;margin:0">
          <fieldset style="border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:12px">
            <legend style={`${label};padding:0;margin-bottom:12px;letter-spacing:0.12em`}>I'm interested in</legend>
            <div style="display:flex;flex-wrap:wrap;gap:8px">
              {
                interests.map((i) => (
                  <label class="ct-chip">
                    <input type="checkbox" name="interests" value={i} />
                    <span>{i}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:20px 24px">
            {
              fields.map((f) => (
                <label class="pg-field">
                  <span>{f.label}</span>
                  <input type={f.type} name={f.name} autocomplete={f.auto} required={f.required} />
                </label>
              ))
            }
          </div>
          <label class="pg-field">
            <span>State</span>
            <select name="state" required>
              <option value="">Select</option>
              {states.map((s) => <option>{s}</option>)}
            </select>
          </label>
          <label class="pg-field">
            <span>Message</span>
            <textarea name="message" required rows="4" style="resize:vertical"></textarea>
          </label>
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px">
            <span style="font-size:14px;font-weight:300;color:#7d6a96;max-width:300px">Responses are used in accordance with our <a href={`${PG_SITE}/privacy-policy/`} style="border-bottom:1px solid currentColor">Privacy Policy</a>.</span>
            <button type="submit" data-magnetic class="pg-solid ct-send" style="background:#2b1745;color:#f6f2ec;border:0;padding:18px 32px;border-radius:999px;font:inherit;font-size:16px;cursor:pointer">Send message</button>
          </div>
        </form>
        <div data-form-success hidden class="pg-success" role="status" style="min-height:360px;flex-direction:column;justify-content:center;gap:16px">
          <svg class="pg-check" viewBox="0 0 52 52" width="64" height="64" aria-hidden="true"><circle cx="26" cy="26" r="24" fill="none" stroke="#2b1745" stroke-width="1.5"></circle><path d="M15 27l7 7 15-16" fill="none" stroke="#2b1745" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span style={label}>Message sent</span>
          <span style="font-weight:200;font-size:clamp(36px,3.6vw,56px);line-height:1.05;letter-spacing:-0.04em">Thank you. A member of our digital team will be in touch shortly.</span>
          <button type="button" data-form-reset style="align-self:flex-start;background:none;border:0;border-bottom:1px solid #2b1745;padding:4px 0;font:inherit;font-size:15px;color:#2b1745;cursor:pointer">Send another message</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Team photo -->
  <section style="padding:0 clamp(20px,4vw,56px) clamp(110px,18vh,200px)">
    <div data-zoom data-reveal style="max-width:1560px;margin:0 auto;height:clamp(280px,56vh,620px);border-radius:20px;overflow:hidden">
      <Image src={teamLaptop} alt="The Purple Giraffe digital team" widths={[800, 1200, 1600, 2048]} sizes="(min-width: 1560px) 1450px, 100vw" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%;display:block" />
    </div>
  </section>

  <PgFormStyles />
</PgLayout>

<style is:global>
  /* Top rule draws across as the section enters */
  .ct-grid{position:relative}
  .ct-grid::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:#2b1745;transform-origin:left}
  .pg-js:not(.pg-reduced) .ct-grid::before{animation:ct-draw 1.4s cubic-bezier(.19,1,.22,1) .4s both}
  @keyframes ct-draw{from{transform:scaleX(0)}}

  .ct-mail{background:linear-gradient(#2b1745,#2b1745) left bottom/100% 1px no-repeat;transition:background-size .6s cubic-bezier(.19,1,.22,1),color .3s,transform .6s cubic-bezier(.19,1,.22,1)}
  .ct-mail:hover{background-size:0 1px;background-position:right bottom;color:#7d5aa6}
  .ct-dot{white-space:nowrap}
  .ct-dot::after{content:'.';color:#9a86b5;display:inline-block;animation:ct-pulse 2.6s ease-in-out 1.6s infinite}
  @keyframes ct-pulse{0%,100%{opacity:1}50%{opacity:.35}}

  .ct-tel .ct-arrow{display:inline-block;opacity:0;transform:translateX(-8px);transition:opacity .4s,transform .6s cubic-bezier(.19,1,.22,1)}
  .ct-tel:hover .ct-arrow,.ct-tel:focus-visible .ct-arrow{opacity:1;transform:none}

  /* Interest chips are real checkboxes styled as pills */
  .ct-chip{position:relative;cursor:pointer}
  .ct-chip input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
  .ct-chip span{display:inline-block;white-space:nowrap;font-size:15px;font-weight:300;padding:9px 16px;border-radius:999px;border:1px solid #2b1745;transition:background .25s,color .25s,transform .4s cubic-bezier(.19,1,.22,1)}
  .ct-chip:hover span{transform:translateY(-2px)}
  .ct-chip input:checked + span{background:#2b1745;color:#f6f2ec}
  .ct-chip input:checked + span::before{content:'✓ ';}
  .ct-chip input:focus-visible + span{outline:2px solid #7d5aa6;outline-offset:3px}

  /* Card glow follows the pointer */
  .ct-card::before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(420px circle at var(--mx,50%) var(--my,0%),rgba(183,166,204,.45),transparent 60%);opacity:0;transition:opacity .5s}
  .ct-card:hover::before{opacity:1}
  .ct-card > *{position:relative}

  /* Sending: the form lifts away before the success state rises in */
  .ct-card.is-sending form{animation:ct-out .45s cubic-bezier(.7,0,.84,0) forwards}
  @keyframes ct-out{to{opacity:0;transform:translateY(-24px) scale(.98)}}
  .pg-reduced .ct-dot::after,.pg-reduced .ct-grid::before{animation:none}
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const card = document.querySelector<HTMLElement>('.ct-card');
  const form = card?.querySelector<HTMLFormElement>('form[data-form]');

  if (card && !reduced) {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  }

  // Play a short exit animation before the shared form handler swaps in the success message.
  if (card && form && !reduced) {
    let animating = false;
    form.addEventListener(
      'submit',
      (e) => {
        if (animating || !form.checkValidity()) return;
        e.stopImmediatePropagation();
        e.preventDefault();
        animating = true;
        card.classList.add('is-sending');
        setTimeout(() => {
          card.classList.remove('is-sending');
          form.dispatchEvent(new Event('submit', { cancelable: true }));
          animating = false;
        }, 420);
      },
      { capture: true },
    );
  }
</script>
