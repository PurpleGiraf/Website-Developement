---
import Layout from '../../../templates/cellar-door/Layout.astro';
import PageHero from '../../../templates/cellar-door/PageHero.astro';
import Photo from '../../../components/Photo.astro';
import { config, routes, businessSchema, breadcrumbSchema } from '../../../templates/cellar-door/config';
import { timeline, vineyard, team } from '../../../templates/cellar-door/data';

const b = config.business;
---

<Layout
  page="about"
  darkHero
  title={`Our story: a family vineyard in Lenswood since ${b.founded} | ${config.brandName}`}
  description={`The Marlow family has farmed fourteen hectares at 520 metres above Lenswood since ${b.founded}. Meet the people, the vineyard and the cool-climate wines of ${config.brandName}.`}
  jsonld={[businessSchema(Astro.site), breadcrumbSchema([{ name: 'Home', path: routes.home }, { name: 'Our story', path: routes.about }], Astro.site)]}
>
  <PageHero eyebrow={`Our story · Since ${b.founded}`} photo="cellar-door/ridge-winter" photoAlt="The Hillside vineyard in winter" label="ridge in winter — landscape">
    Thirty years on <em>one ridge.</em>
  </PageHero>

  <!-- Intro: large serif statement -->
  <section style="padding:20vh 5vw 14vh">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:6vw;align-items:start">
      <div class="hs-eyebrow" data-reveal="0">The Marlow family</div>
      <div style="display:flex;flex-direction:column;gap:28px">
        <p data-reveal="0" class="hs-serif" style="font-size:clamp(28px,3vw,48px);line-height:1.18">We are a family vineyard, not a brand. The people who prune the vines in winter are the ones who pick them in autumn and pour the wine at the bar.</p>
        <p data-reveal="120" style="font-size:17px;line-height:1.7;color:#4B4840;max-width:560px">Hillside began as an old apple orchard that Tom and Ruth Marlow bought in 1994, convinced the cool, high country above Lenswood could grow Chardonnay and Pinot Noir to rival anywhere. Three decades later their daughter Claire makes the wine, and the orchard's last apple trees still stand by the cellar door.</p>
      </div>
    </div>
  </section>

  <!-- Timeline: rows reveal as you scroll -->
  <section style="padding:0 5vw 18vh">
    <h2 data-reveal="0" class="hs-serif" style="font-size:clamp(52px,7vw,120px);line-height:0.9;letter-spacing:-0.03em;margin-bottom:8vh">The <em class="hs-wine">years</em></h2>
    <ol class="hs-timeline">
      {
        timeline.map((t, i) => (
          <li data-reveal={i % 2 ? 100 : 0}>
            <span class="hs-serif hs-year">{t.year}</span>
            <h3 class="hs-serif">{t.title}</h3>
            <p>{t.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- The vineyard: pinned photo, facts scroll past -->
  <section style="background:#2F3A2C;color:#EFEAE0">
    <div class="hs-split">
      <div class="hs-split-media">
        <div data-zoom="0.2" style="position:absolute;inset:0">
          <Photo name="cellar-door/home-hero" alt="Vineyard rows running down the ridge" style="width:100%;height:100%;background:#24261F" sizes="(min-width: 900px) 50vw, 100vw" />
        </div>
      </div>
      <div style="padding:16vh 6vw;display:flex;flex-direction:column;gap:32px">
        <div class="hs-eyebrow" style="color:#B9C0A8">The vineyard</div>
        <h2 data-reveal="0" class="hs-serif" style="font-size:clamp(44px,5vw,88px);line-height:0.92;letter-spacing:-0.03em">High, cool and <em>farmed by hand.</em></h2>
        <p style="font-size:17px;line-height:1.7;color:#D6DACB;max-width:480px">At over 500 metres, our nights stay cold right through summer. The fruit ripens slowly and keeps its acidity, which is where the line and freshness in our wines comes from.</p>
        <dl class="hs-facts-dark">
          {
            vineyard.map((f) => (
              <div>
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Winemaking -->
  <section style="padding:20vh 5vw;overflow:hidden">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:6vw;align-items:center">
      <div style="display:flex;flex-direction:column;gap:28px;max-width:520px">
        <div class="hs-eyebrow">In the winery</div>
        <h2 data-reveal="0" class="hs-serif" style="font-size:clamp(44px,5vw,88px);line-height:0.92;letter-spacing:-0.03em">Less done, <em class="hs-wine">done well.</em></h2>
        <p style="font-size:17px;line-height:1.7;color:#4B4840">Wild yeasts, older oak and plenty of patience. We make small batches from individual blocks, taste every barrel, and release each wine only when it is ready to drink, not when the calendar says so.</p>
        <a href={routes.wines} class="hs-link" style="align-self:flex-start">Taste the wines</a>
      </div>
      <div style="aspect-ratio:4/3;overflow:hidden;position:relative">
        <div data-px="0.12" style="position:absolute;left:0;right:0;top:-12%;height:124%">
          <Photo name="cellar-door/about-cellar" alt="Winemaking in the Hillside winery" class="hs-ph" style="width:100%;height:100%" label="winemaking, tanks or barrels — landscape" sizes="(min-width: 900px) 45vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- People -->
  <section style="padding:6vh 5vw 20vh;background:#E5DFD3">
    <div style="display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap;padding-top:12vh;margin-bottom:10vh">
      <h2 data-reveal="0" class="hs-serif" style="font-size:clamp(52px,7vw,120px);line-height:0.9;letter-spacing:-0.03em">The <em>people</em></h2>
      <a href={routes.contact} class="hs-link">Get in touch</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:3vw">
      {
        team.map((p, i) => (
          <article data-px={['0', '-0.08', '0.05'][i]} style="display:flex;flex-direction:column;gap:18px">
            <Photo name={p.photo} alt={p.alt} label={`${p.name} — portrait`} class="hs-ph" style="aspect-ratio:4/5" sizes="(min-width: 900px) 30vw, 100vw" />
            <div class="hs-eyebrow">{p.role}</div>
            <h3 class="hs-serif" style="font-size:32px;line-height:1">{p.name}</h3>
            <p style="font-size:15px;line-height:1.6;color:#4B4840">{p.bio}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section style="padding:16vh 5vw 4vh;text-align:center">
    <p data-reveal="0" class="hs-serif" style="font-size:clamp(24px,2.6vw,40px);line-height:1.3;max-width:900px;margin:0 auto">{b.acknowledgement} We pay our respects to Elders past and present.</p>
  </section>
</Layout>

<style is:global>
  .hs-timeline{list-style:none;margin:0;padding:0;border-top:1px solid #1A1C17}
  .hs-timeline li{display:grid;grid-template-columns:minmax(120px,1fr) 2fr 2fr;gap:32px;align-items:baseline;padding:5vh 0;border-bottom:1px solid #CBC3B4}
  .hs-year{font-size:clamp(44px,5vw,88px);line-height:0.8;letter-spacing:-0.03em;color:var(--wine)}
  .hs-timeline h3{font-size:clamp(24px,2.2vw,34px);line-height:1.1}
  .hs-timeline p{font-size:16px;line-height:1.65;color:#4B4840}
  @media (max-width: 760px){ .hs-timeline li{grid-template-columns:1fr;gap:12px} }
  .hs-split{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr))}
  .hs-split-media{position:relative;min-height:60vh;overflow:hidden}
  @media (min-width: 900px){ .hs-split-media{position:sticky;top:0;height:100vh} }
  .hs-facts-dark{margin:0;border-top:1px solid #4A5745}
  .hs-facts-dark div{display:flex;justify-content:space-between;gap:24px;padding:16px 0;border-bottom:1px solid #4A5745;font-size:15px}
  .hs-facts-dark dt{color:#B9C0A8}
  .hs-facts-dark dd{margin:0;text-align:right}
</style>
