---
import Layout from '../../../templates/cellar-door/Layout.astro';
import PageHero from '../../../templates/cellar-door/PageHero.astro';
import FaqItem from '../../../templates/cellar-door/FaqItem.astro';
import Photo from '../../../components/Photo.astro';
import Deco from '../../../templates/cellar-door/Deco.astro';
import { config, routes, legalRoutes, clubTiers, breadcrumbSchema, faqSchema } from '../../../templates/cellar-door/config';
import { clubSteps, faqs } from '../../../templates/cellar-door/data';

const cFaqs = faqs.filter((f) => f.cat === 'Club');
const perks = [
  { t: 'First pour', b: 'Small-batch and library wines are offered to members before anyone else.' },
  { t: 'Taste for free', b: 'A complimentary tasting on every visit, for you and a guest.' },
  { t: 'Member pricing', b: '15% or more off wine all year, and 15% off lunch on the Verandah.' },
  { t: 'Members first', b: 'Early booking for winemaker dinners and the annual members’ long lunch.' },
];
---

<Layout
  page="club"
  title={`The Hillside Club: wine club, Adelaide Hills | ${config.brandName}`}
  description="Join the Hillside Club for six or twelve bottles twice a year, chosen by our winemaker. First access to small releases, free tastings and 15% off wine and lunch."
  jsonld={[breadcrumbSchema([{ name: 'Home', path: routes.home }, { name: 'Club', path: routes.club }], Astro.site), faqSchema(cFaqs)]}
>
  <PageHero eyebrow="The Hillside Club" intro="Six or twelve bottles, twice a year, chosen by our winemaker. No joining fee, no lock-in, and the first pour of every release.">
    First pour, <em class="hs-wine">every release.</em>
  </PageHero>

  <section style="padding:6vh 5vw 16vh">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));border-top:1px solid #1A1C17">
      {
        perks.map((p, i) => (
          <div data-reveal={i * 100} style="display:flex;flex-direction:column;gap:14px;padding:32px 28px 32px 0;border-bottom:1px solid #CBC3B4">
            <h2 class="hs-serif" style="font-size:30px;line-height:1.05">{p.t}</h2>
            <p style="font-size:15px;line-height:1.6;color:#4B4840">{p.b}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section style="position:relative;height:90vh;overflow:hidden">
    <div data-zoom="0.25" style="position:absolute;inset:0">
      <Photo name="cellar-door/club-box" alt="A timber case of Hillside wines" class="hs-ph-dark" style="width:100%;height:100%" label="case of wine — landscape" sizes="100vw" />
    </div>
  </section>

  <!-- Tiers + join form -->
  <section class="hs-deco-host" id="join" style="overflow:clip;padding:18vh 5vw;scroll-margin-top:80px">
    <Deco art="vine-bl-taupe" style="bottom:-3vh;left:-4vw;width:clamp(220px,26vw,420px)" speed={0.12} spin={0} opacity={0.38} desktopOnly />
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:6vw;align-items:start">
      <div style="display:flex;flex-direction:column;gap:28px">
        <div class="hs-eyebrow">Membership</div>
        <h2 data-reveal="0" class="hs-serif" style="font-size:clamp(48px,6vw,104px);line-height:0.92;letter-spacing:-0.03em">Two ways <em class="hs-wine">to join.</em></h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px">
          {
            clubTiers.map((t, i) => (
              <article data-reveal={i * 120} class:list={['hs-tier', { 'is-feature': i === 1 }]}>
                <h3 class="hs-serif" style="font-size:40px;line-height:1">{t.name}</h3>
                <span class="hs-eyebrow" style="color:inherit;opacity:.75">{t.price}</span>
                <ul>{t.perks.map((p) => <li>{p}</li>)}</ul>
              </article>
            ))
          }
        </div>
      </div>
      <div data-form-wrap class="hs-form-card">
        <form data-form class="hs-stack" style="gap:24px">
          <h3 class="hs-serif" style="font-size:40px">Join the club</h3>
          <fieldset class="hs-fieldset">
            <legend class="hs-label">Tier</legend>
            <div class="hs-rows" data-chips>
              <input type="hidden" name="tier" value={clubTiers[0].id} data-chip-input />
              {
                clubTiers.map((t, i) => (
                  <button type="button" class="hs-row" data-chip value={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                    <span style="display:flex;flex-direction:column;gap:4px;text-align:left">
                      <span class="hs-serif" style="font-size:24px">{t.name}</span>
                      <span style="font-size:14px;color:#5D5A50;font-weight:400">{t.desc}</span>
                    </span>
                    <span>{t.price}</span>
                  </button>
                ))
              }
            </div>
          </fieldset>
          <label class="hs-field">Full name<input name="name" required autocomplete="name" /></label>
          <label class="hs-field">Email<input name="email" type="email" required autocomplete="email" /></label>
          <label class="hs-field">Delivery postcode<input name="postcode" inputmode="numeric" pattern="[0-9]{4}" required autocomplete="postal-code" /></label>
          <label class="hs-check"><input type="checkbox" name="over18" required /> I am 18 or over</label>
          <button type="submit" class="hs-btn hs-btn-wine" style="padding:19px">Join</button>
          <p style="font-size:12px;color:#5D5A50;margin:0">We'll email to set up payment before your first release. See the <a href={legalRoutes.terms} style="text-decoration:underline">club terms</a>.</p>
        </form>
        <div data-form-success hidden class="hs-stack" style="gap:16px">
          <h3 class="hs-serif" style="font-size:40px">Welcome to the club.</h3>
          <p style="font-size:16px;line-height:1.6;color:#4B4840">We'll be in touch to set up your first release. Your member tasting is ready whenever you visit.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hs-deco-host" style="overflow:clip;background:#2F3A2C;color:#EFEAE0;padding:16vh 5vw">
    <Deco art="leaf-cream" style="top:-6vh;right:-4vw;width:clamp(200px,24vw,380px)" speed={0.15} spin={3} opacity={0.12} />
    <h2 data-reveal="0" class="hs-serif" style="font-size:clamp(48px,6vw,104px);line-height:0.92;letter-spacing:-0.03em;margin-bottom:8vh">How it <em>works</em></h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));border-top:1px solid #4A5745">
      {
        clubSteps.map((s, i) => (
          <div data-reveal={i * 120} style="display:flex;flex-direction:column;gap:18px;padding:36px 32px 0 0">
            <span class="hs-serif" style="font-size:clamp(56px,5vw,88px);line-height:1;color:#B9C0A8">{s.n}</span>
            <h3 class="hs-serif" style="font-size:30px">{s.title}</h3>
            <p style="font-size:16px;line-height:1.6;color:#D6DACB;max-width:360px">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section style="padding:16vh 5vw 4vh">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:6vw;align-items:start">
      <h2 data-reveal="0" class="hs-serif" style="font-size:clamp(44px,5vw,88px);line-height:0.92;letter-spacing:-0.03em">Club <em class="hs-wine">questions</em></h2>
      <div style="border-top:1px solid #1A1C17">
        {cFaqs.map((f) => <FaqItem q={f.q} a={f.a} />)}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .hs-tier{display:flex;flex-direction:column;gap:14px;padding:28px;border:1px solid #1A1C17}
  .hs-tier.is-feature{background:#1A1C17;color:#EFEAE0}
  .hs-tier ul{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column;gap:10px;font-size:15px;line-height:1.45}
  .hs-tier li{padding-left:20px;position:relative}
  .hs-tier li::before{content:'';position:absolute;left:0;top:10px;width:10px;height:1px;background:currentColor}
</style>
