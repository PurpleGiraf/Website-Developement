---
import Layout from '../../../templates/cellar-door/Layout.astro';
import Bottle from '../../../templates/cellar-door/Bottle.astro';
import Deco from '../../../templates/cellar-door/Deco.astro';
import { config, routes, wines, wineUrl, wineTypes, clubDiscount, shipping, money, base, breadcrumbSchema } from '../../../templates/cellar-door/config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${config.brandName} current releases`,
  itemListElement: wines.map((w, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: `${config.brandName} ${w.vintage} ${w.name}`,
      description: w.note,
      category: `${w.type} wine`,
      brand: { '@type': 'Brand', name: config.brandName },
      url: new URL(wineUrl(w), Astro.site).href,
      offers: { '@type': 'Offer', price: w.price, priceCurrency: 'AUD', availability: 'https://schema.org/InStock', url: new URL(wineUrl(w), Astro.site).href, seller: { '@id': new URL(`${base}/#winery`, Astro.site).href } },
    },
  })),
};
const breadcrumb = breadcrumbSchema([{ name: 'Home', path: routes.home }, { name: 'Wines', path: routes.wines }], Astro.site);
---

<Layout
  page="wines"
  title={`Buy Adelaide Hills wine online | ${config.brandName}, Lenswood`}
  description={`Estate grown Adelaide Hills Sauvignon Blanc, Chardonnay, Pinot Noir, Shiraz, Rosé and sparkling. Free delivery across Australia on ${shipping.freeFrom} bottles or more.`}
  jsonld={[schema, breadcrumb]}
>
  <section class="hs-deco-host" style="padding:22vh 5vw 8vh;overflow:hidden">
    <Deco art="vine-tr-taupe" style="top:8vh;right:-2vw;width:clamp(200px,28vw,460px)" speed={0.12} opacity={0.42} />
    <Deco art="glass-taupe" style="top:20vh;left:58vw;width:clamp(70px,7vw,120px)" speed={-0.25} spin={2} opacity={0.5} desktopOnly />
    <div data-reveal="0" class="hs-eyebrow" style="margin-bottom:28px">Shop · Current releases</div>
    <div data-pxx="-0.2">
      <h1 class="hs-serif" style="font-size:16vw;line-height:0.82;letter-spacing:-0.045em;white-space:nowrap">The <em class="hs-wine">wines</em></h1>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:end;gap:32px;flex-wrap:wrap;margin-top:8vh;border-top:1px solid #1A1C17;padding-top:24px">
      <p style="font-size:16px;line-height:1.6;color:#4B4840;max-width:420px">Every wine is estate grown and made on site. Free delivery across Australia on {shipping.freeFrom} bottles or more.</p>
      <div role="group" aria-label="Filter by style" style="display:flex;gap:8px;flex-wrap:wrap">
        {
          wineTypes.map((t) => (
            <button type="button" class="hs-chip" data-wine-filter={t} aria-pressed={t === 'All' ? 'true' : 'false'} style="padding:11px 20px">
              {t}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="hs-deco-host" style="padding:6vh 5vw 24vh;overflow:clip">
    <Deco art="leaf-wine" style="top:40%;left:-4vw;width:clamp(140px,16vw,260px)" speed={-0.2} spin={-4} opacity={0.22} />
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:12vh 3vw">
      {
        wines.map((w, i) => (
          <div data-wine-type={w.type}>
            <article data-px={['0', '-0.12', '0.06'][i % 3]} style="display:flex;flex-direction:column;gap:16px">
              <a href={wineUrl(w)} tabindex="-1" aria-hidden="true" class="hs-bottle-link"><Bottle wine={w} /></a>
              <div style="display:flex;justify-content:space-between;gap:12px;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#5D5A50;border-top:1px solid #CBC3B4;padding-top:14px">
                <span>{w.vintage} · {w.type}</span>
                <span>{money(w.price)}</span>
              </div>
              <h2 class="hs-serif" style="font-size:32px;line-height:1.05;letter-spacing:-0.01em">
                <a href={wineUrl(w)}>{w.name}</a>
              </h2>
              <p style="font-size:15px;line-height:1.55;color:#4B4840;text-wrap:pretty">{w.note}</p>
              <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
                <span style="font-size:13px;color:#5D5A50">Club {money(Math.round(w.price * (1 - clubDiscount)))}</span>
                <button type="button" data-add={w.id} class="hs-btn hs-btn-ink" style="font-size:11px;padding:13px 20px" aria-label={`Add ${w.name} to cart`}>
                  Add to cart
                </button>
              </div>
            </article>
          </div>
        ))
      }
    </div>
  </section>

  <section style="background:var(--wine);color:#EFEAE0;padding:4vh 0;overflow:hidden" aria-hidden="true">
    <div data-marquee="0.5" class="hs-serif" style="display:flex;width:max-content;white-space:nowrap;font-size:6vw;line-height:1;letter-spacing:-0.02em">
      {[0, 1, 2, 3].map(() => <span style="padding-right:4vw">Free delivery on six <em>·</em> Members save 15% <em>·</em></span>)}
    </div>
  </section>
</Layout>
