---
// Bottom bar shared by the Purple Giraffe pages: logo, email, privacy, copyright.
import { Image } from 'astro:assets';
import logoReverse from '../assets/pg/logo-reverse.png';
---

<div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:24px;padding-top:40px;border-top:1px solid rgba(183,166,204,0.3);font-size:14px;color:#b7a6cc">
  <Image src={logoReverse} alt="Purple Giraffe" height={84} densities={[1, 2]} style="height:84px;width:auto;display:block" />
  <div style="display:flex;flex-wrap:wrap;gap:12px 28px">
    <a href="mailto:marketing@purplegiraffe.com.au">marketing@purplegiraffe.com.au</a>
    <a href="https://purplegiraffe.com.au/privacy-policy/">Privacy</a>
    <a href="https://purplegiraffe.com.au/terms-conditions/">Terms</a>
    <span>© 2026 Purple Giraffe</span>
  </div>
</div>
